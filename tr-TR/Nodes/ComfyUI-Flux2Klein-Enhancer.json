    "Flux2KleinEnhancer": {
        "title": "Flux2Klein iyileştirici",
        "inputs": {
            "conditioning": "Koşullu",
            "device": "Çalıştırma aygıtı"
        },
        "widgets": {
            "active_scale": "Etkin bölge ölçeği",
            "per_token_whiten": "Token başına aklatma",
            "norm_equalize": "Norm dengelenmesi",
