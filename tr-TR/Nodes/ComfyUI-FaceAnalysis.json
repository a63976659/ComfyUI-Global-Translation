{
    "FaceAnalysisModels": {
        "title": "Yüz Analiz Modeli",
        "widgets": {
            "library": "Kitaplık",
            "provider": "Aygıt"
        },
        "outputs": {
            "ANALYSIS_MODELS": "Yüz Analiz Modeli"
        }
    },
    "FaceEmbedDistance": {
        "title": "Yüz Benzerlik Farkı",
        "inputs": {
            "analysis_models": "Yüz Analiz Modeli",
            "reference": "Referans görsel",
            "image": "Görsel"
        },
        "widgets": {
            "filter_thresh_eucl": "Öklid Eşiği",
            "filter_thresh_cos": "Consine Eşiği",
            "similarity_metric": "Benzerlik Algoritması",
            "filter_thresh": "Filtreleme Eşiği",
            "filter_best": "Mükemmel Eşleşme Filtresi",
            "generate_image_overlay": "Görsel Bindirmesi Oluştur"
        },
        "outputs": {
            "IMAGE": "Görsel",
            "euclidean": "Euclidean",
            "cosine": "Cosine",
            "distance": "Mesafe"
        }
    },
    "FaceBoundingBox": {
        "title": "Yüz BBox",
        "inputs": {
            "analysis_models": "Yüz Analiz Modeli",
            "image": "Görsel"
        },
        "widgets": {
            "padding": "Bölümleme",
            "padding_percent": "Bölge Yüzdesi",
            "index": "Dizin"
        },
        "outputs": {
            "IMAGE": "Görsel",
            "x": "X",
            "y": "Y",
            "width": "Genişlik",
            "height": "Yükseklik"
        }
    },
    "FaceAlign": {
        "title": "Yüz Hizalama",
        "inputs": {
            "analysis_models": "Yüz Analiz Modeli",
            "image_from": "Kaynak Görsel",
            "image_to": "Hedef Görsel"
        },
        "outputs": {
            "IMAGE": "Görsel"
        }
    },
    "FaceSegmentation": {
        "title": "Yüz Bölümlemesi",
        "inputs": {
            "analysis_models": "Yüz Analiz Modeli",
            "image": "Görsel"
        },
        "widgets": {
            "area": "Alan",
            "grow": "Genişlet",
            "grow_tapered": "Kademeli Genişletme",
            "blur": "Bulanıklık"
        },
        "outputs": {
            "mask": "Maske",
            "image": "Görsel",
            "seg_mask": "Bölümleme Maskesi",
            "seg_image": "Görseli böl",
            "x": "x",
            "y": "y",
            "width": "Genişlik",
            "height": "Yükseklik"
        }
    },
    "FaceWarp": {
        "title": "Yüz Değiştirme",
        "inputs": {
            "analysis_models": "Yüz Analiz Modeli",
            "image_from": "Kaynak Görsel",
            "image_to": "Hedef Görsel"
        },
        "widgets": {
            "keypoints": "Anahtar noktalar",
            "grow": "Genişlet",
            "blur": "Bulanıklık"
        },
        "outputs": {
            "IMAGE": "Görsel",
            "MASK": "Maske"
        }
    }
}