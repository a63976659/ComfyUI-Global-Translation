{
    "MZ_ChatGLM3Loader": {
        "title": "Carregador ChatGLM3",
        "widgets": {
            "chatglm3_checkpoint": "Modelo ChatGLM3"
        },
        "outputs": {
            "chatglm3_model": "ChatGLM3"
        }
    },
    "MZ_ChatGLM3_V2": {
        "title": "Codificação ChatGLM3_V2",
        "inputs": {
            "chatglm3_model": "ChatGLM3"
        },
        "widgets": {
            "text": "Texto"
        },
        "outputs": {
            "CONDITIONING": "Condicionamento"
        }
    },
    "MZ_ChatGLM3_Advance_V2": {
        "title": "Codificação ChatGLM3_V2 Avançada",
        "inputs": {
            "chatglm3_model": "ChatGLM3"
        },
        "widgets": {
            "text": "Texto",
            "width": "Largura",
            "height": "Altura",
            "crop_w": "Largura do recorte",
            "crop_h": "Altura do recorte",
            "target_width": "Largura alvo",
            "target_height": "Altura alvo"
        },
        "outputs": {
            "CONDITIONING": "Condicionamento"
        }
    },
    "MZ_ChatGLM3Embeds2Conditioning": {
        "title": "Grupo de Embeddings ChatGLM3 para Condição",
        "inputs": {
            "kolors_embeds": "Grupo de Embeddings Kolors"
        },
        "widgets": {
            "width": "Largura",
            "height": "Altura",
            "crop_w": "Largura do recorte",
            "crop_h": "Altura do recorte",
            "target_width": "Largura alvo",
            "target_height": "Altura alvo"
        },
        "outputs": {
            "positive": "Condição positiva",
            "negative": "Condição negativa"
        }
    },
    "MZ_KolorsCheckpointLoaderSimple": {
        "title": "Carregador de Modelo Kolors (simples)",
        "widgets": {
            "ckpt_name": "Nome do modelo"
        },
        "outputs": {
            "MODEL": "Modelo",
            "VAE": "VAE"
        }
    },
    "MZ_KolorsControlNetLoader": {
        "title": "Carregador KolorsControlNet",
        "widgets": {
            "control_net_name": "Nome do ControlNet"
        },
        "outputs": {
            "ControlNet": "ControlNet"
        }
    },
    "MZ_KolorsUNETLoaderV2": {
        "title": "Carregador KolorsUNET_V2",
        "widgets": {
            "unet_name": "Nome do UNET"
        },
        "outputs": {
            "model": "Modelo"
        }
    },
    "MZ_KolorsControlNetPatch": {
        "title": "Conversão KolorsControlNet",
        "inputs": {
            "control_net": "ControlNet",
            "model": "Modelo"
        },
        "outputs": {
            "CONTROL_NET": "ControlNet"
        }
    },
    "MZ_ApplySDXLSamplingSettings": {
        "title": "Aplicar configurações de amostragem SDXL",
        "inputs": {
            "model": "Modelo"
        },
        "outputs": {
            "MODEL": "Modelo"
        }
    },
    "MZ_ApplyCUDAGenerator": {
        "title": "Aplicar gerador CUDA",
        "inputs": {
            "model": "Modelo"
        },
        "outputs": {
            "MODEL": "Modelo"
        }
    }
}