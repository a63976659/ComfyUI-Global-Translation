    },
    "VHS_MergeLatents": {
        "title": "Mesclar Latents",
        "inputs": {
            "latents_A": "Latent_A",
            "latents_B": "Latent_B"
        },
        "widgets": {
            "merge_strategy": "estratégia de fusão",
            "match A": "corresponder A",
            "match B": "corresponder B",
            "match smaller": "corresponder ao menor",
            "match larger": "corresponder ao maior",
            "scale_method": "Método de escala",
            "nearest-exact": "Vizinho mais próximo-exato",
            "bilinear": "Interpolação bilinear",
            "area": "Área (região)",
            "bislerp": "bispline",
            "bicubic": "Interpolação bicúbica",
            "crop": "Recortar",
            "disabled": "Fechar",
            "ceter": "centro"
        },
        "outputs": {
            "LATENT": "Latent",
            "count": "Contagem"
        },
        "description": "Combina dois conjuntos de espaços latentes em um único conjunto de espaços latentes \n\n"
    },
    "VHS_SelectEveryNthLatent": {
        "title": "Selecionar Latents (intervalo)",
        "inputs": {
            "latents": "Latent"
        },
        "widgets": {
            "select_every_nth": "Intervalo",
            "skip_first_latents": "Pular os X primeiros"
        },
        "outputs": {
            "LATENT": "Latent",
            "count": "Contagem"
        },
        "description": "Mantém apenas 1 espaço latent em cada intervalo \n\n"
    },
    "VHS_SelectLatents": {
        "title": "Selecionar Latents (índice)",
        "inputs": {
            "latent": "Latent"
        },
        "widgets": {
            "indexes": "Índice",
            "err_if_missing": "Gerar erro quando ausente",
            "err_if_empty": "Gerar erro quando vazio"
        },
        "outputs": {
            "LATENT": "Latent"
        },
        "description": "Seleciona itens de entrada pelo índice numérico, separados por vírgulas, na ordem informada\n\nSuporta índices negativos, intervalos no estilo Python (sem incluir o índice final) e passo de intervalo\n\nExemplos (supondo 16 itens de entrada, índices 0-15):\n\n• 0         → Saída [0]\n• -1        → Saída [15]\n• 0,1,13    → Saída [0,1,13]\n• 0:5,13    → Saída [0,1,2,3,4,13]\n• 0:-1      → Saída [0,1,2,...,14]\n• 0:5:-1    → Saída [4,3,2,1,0]\n• 0:5:2     → Saída [0,2,4]\n• ::-1      → Saída [15,14,...,0]"
    },
    "VHS_GetLatentCount": {
        "title": "Obter quantidade de Latents",
        "inputs": {
            "latents": "Latent"
        },
        "outputs": {
            "count": "Contagem"
        },
        "description": "Retorna, como número inteiro, a quantidade de espaços latentes na entrada \n\n"
    },
    "VHS_DuplicateLatents": {
