{
    "FaceAnalysisModels": {
        "title": "Modelo de análise facial",
        "widgets": {
            "library": "Biblioteca",
            "provider": "Dispositivo"
        },
        "outputs": {
            "ANALYSIS_MODELS": "Modelo de análise facial"
        }
    },
    "FaceEmbedDistance": {
        "title": "Diferença de semelhança facial",
        "inputs": {
            "analysis_models": "Modelo de análise facial",
            "reference": "Imagem de referência",
            "image": "Imagem"
        },
        "widgets": {
            "filter_thresh_eucl": "Limiar Euclidiano",
            "filter_thresh_cos": "Limiar Consine",
            "similarity_metric": "Algoritmo de semelhança",
            "filter_thresh": "Limiar de filtragem",
            "filter_best": "Filtro de correspondência perfeita",
            "generate_image_overlay": "Sobreposição de imagem gerada"
        },
        "outputs": {
            "IMAGE": "Imagem",
            "euclidean": "Euclidean",
            "cosine": "Cosine",
            "distance": "Distância"
        }
    },
    "FaceBoundingBox": {
        "title": "BBox facial",
        "inputs": {
            "analysis_models": "Modelo de análise facial",
            "image": "Imagem"
        },
        "widgets": {
            "padding": "Com preenchimento",
            "padding_percent": "Porcentagem de partição",
            "index": "Índice"
        },
        "outputs": {
            "IMAGE": "Imagem",
            "x": "X",
            "y": "Y",
            "width": "Largura",
            "height": "Altura"
        }
    },
    "FaceAlign": {
        "title": "Alinhamento facial",
        "inputs": {
            "analysis_models": "Modelo de análise facial",
            "image_from": "Da imagem",
            "image_to": "Para a imagem"
        },
        "outputs": {
            "IMAGE": "Imagem"
        }
    },
    "FaceSegmentation": {
        "title": "Segmentação facial",
        "inputs": {
            "analysis_models": "Modelo de análise facial",
            "image": "Imagem"
        },
        "widgets": {
            "area": "Área",
            "grow": "Expandir",
            "grow_tapered": "Expansão chanfrada",
            "blur": "Desfoque"
        },
        "outputs": {
            "mask": "Máscara",
            "image": "Imagem",
            "seg_mask": "Máscara de segmentação",
            "seg_image": "Imagem dividida",
            "x": "x",
            "y": "y",
            "width": "Largura",
            "height": "Altura"
        }
    },
    "FaceWarp": {
        "title": "Substituição facial",
        "inputs": {
            "analysis_models": "Modelo de análise facial",
            "image_from": "Da imagem",
            "image_to": "Para a imagem"
        },
        "widgets": {
            "keypoints": "Pontos-chave",
            "grow": "Expandir",
            "blur": "Desfoque"
        },
        "outputs": {
            "IMAGE": "Imagem",
            "MASK": "Máscara"
        }
    }
