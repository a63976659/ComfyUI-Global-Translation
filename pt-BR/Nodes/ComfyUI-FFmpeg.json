    "MergingVideoByPlenty": {
        "title": "🔥 Combinar vídeos em lote",
        "widgets": {
            "video_path": "Caminho do vídeo",
            "output_path": "Caminho de saída"
        },
        "outputs": {
            "video_complete_path": "Caminho completo do vídeo",
            "string": "Texto/string"
        },
        "description": "Serve para combinar vários vídeos curtos com o mesmo formato de codificação, resolução e taxa de quadros em um vídeo longo. Todos os vídeos no diretório devem ter a mesma codificação, taxa de quadros e resolução."
    },
    "MergingVideoByTwo": {
        "title": "🔥 Combinar vídeos",
        "widgets": {
            "video1_path": "Caminho do vídeo_1",
            "video2_path": "Caminho do vídeo_2",
            "device": "Dispositivo",
            "resolution_reference": "Referência de resolução",
            "output_path": "Caminho de saída"
        },
        "outputs": {
            "video_complete_path": "Caminho completo do vídeo",
            "string": "Texto/string"
        },
        "description": "Serve para combinar dois vídeos, por exemplo, unir dois vídeos de uma hora em um vídeo de 2 horas. O tamanho do vídeo combinado pode usar como referência o primeiro ou o segundo vídeo."
    },
    "MultiCuttingVideo": {
        "title": "🔥 Edição múltipla de vídeo",
        "widgets": {
            "video_path": "Caminho do vídeo",
            "output_path": "Caminho de saída",
            "segment_time": "Tempo do segmento"
        },
        "outputs": {
            "video_complete_path": "Caminho completo do vídeo",
            "string": "Texto/string"
        },
        "description": "Serve para dividir um vídeo em vários vídeos. A duração de cada vídeo dividido, em segundos; a divisão é feita por quadros-chave, então o tempo não deve ser muito curto. Como nem todo trecho tem um quadro-chave, a duração de cada trecho pode não ser exatamente igual, apenas a mais próxima."
    },
    "PipVideo": {
        "title": "🔥 Vídeo em picture-in-picture",
        "widgets": {
            "video1_path": "Caminho do vídeo_1",
            "video2_path": "Caminho do vídeo_2",
            "device": "Dispositivo",
            "use_audio": "Usar áudio",
            "use_duration": "Usar duração",
            "align_type": "Tipo de alinhamento",
            "pip_fg_zoom": "Zoom da camada de primeiro plano do PiP",
            "output_path": "Caminho de saída",
            "scale_and_crop": "Escala e recorte",
            "fps": "Taxa de quadros",
            "is_chromakey": "Usar chroma key (remover tela verde)"
        },
        "outputs": {
            "video_complete_path": "Caminho completo do vídeo",
            "width": "Largura",
            "height": "Altura",
            "duration": "Duração",
            "fps": "Taxa de quadros"
        },
        "description": "Fator de escala do fundo do picture-in-picture; quanto maior, menor o primeiro plano, é a redução da largura e altura do fundo. A taxa de quadros do vídeo final é 30.0 por padrão; definir 0 usará a taxa de quadros do video2, definir 1 também usará a do video2."
    },
    "SingleCuttingVideo": {
        "title": "🔥 Cortar vídeo",
        "widgets": {
            "video_path": "Caminho do vídeo",
