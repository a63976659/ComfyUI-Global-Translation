{
    "SUPIR_model_loader": {
        "title": "SUPIR模型載入器",
        "widgets": {
            "supir_model": "SUPIR模型",
            "sdxl_model": "SDXL模型",
            "fp8_unet": "FP8 UNet精度",
            "diffusion_dtype": "剪枝類型"
        },
        "outputs": {
            "SUPIR_MODEL": "SUPIR模型",
            "SUPIR_model": "SUPIR模型",
            "SUPIR_VAE": "SUPIR_VAE"
        },
        "description": "舊版載入器，不建議使用。\n\n載入 SUPIR 模型和 SDXL 模型然後融合。"
    },
    "SUPIR_model_loader_v2": {
        "title": "SUPIR模型載入器_V2",
        "inputs": {
            "model": "模型",
            "clip": "CLIP",
            "vae": "VAE"
        },
        "widgets": {
            "supir_model": "SUPIR模型",
            "fp8_unet": "FP8 UNet精度",
            "diffusion_dtype": "剪枝類型",
            "high_vram": "高顯存"
        },
        "outputs": {
            "SUPIR_MODEL": "SUPIR模型",
            "SUPIR_model": "SUPIR模型",
            "SUPIR_VAE": "SUPIR_VAE"
        },
        "description": "載入 SUPIR 模型和 SDXL 模型然後融合。\n\n剪枝類型應保持 自動 選項，除非載入模型時出現錯誤。\n\nfp8_unet：使用 torch.float8_e4m3fn 呼叫 UNet，會降低顯示記憶體需求但略微影響品質。\n\n高顯示記憶體：使用 Accelerate 將模型載入至 GPU，可略微提升載入速度。"
    },
    "SUPIR_model_loader_v2_clip": {
        "title": "SUPIR模型載入器_V2（CLIP）",
        "inputs": {
            "model": "模型",
            "clip_l": "CLIP_L",
            "clip_g": "CLIP_G",
            "vae": "VAE"
        },
        "widgets": {
            "supir_model": "SUPIR模型",
            "fp8_unet": "FP8 UNet精度",
            "diffusion_dtype": "剪枝類型",
            "high_vram": "高顯存"
        },
        "outputs": {
            "SUPIR_MODEL": "SUPIR模型",
            "SUPIR_model": "SUPIR模型",
            "SUPIR_VAE": "SUPIR_VAE"
        },
        "description": "載入 SUPIR 模型和 SDXL 模型然後融合。\n\n剪枝類型應保持 自動 選項，除非載入模型時出現錯誤。\n\nfp8_unet：使用 torch.float8_e4m3fn 呼叫 UNet，會降低顯示記憶體需求但略微影響品質。\n\n高顯示記憶體：使用 Accelerate 將模型載入至 GPU，可略微提升載入速度。"
    },
    "SUPIR_encode": {
        "title": "SUPIR編碼",
        "inputs": {
            "SUPIR_VAE": "SUPIR_VAE",
            "image": "影像"
        },
        "widgets": {
            "use_tiled_vae": "分塊VAE",
            "encoder_tile_size": "編碼分塊尺寸",
            "encoder_dtype": "編碼剪枝"
        },
        "outputs": {
            "latent": "Latent"
        }
    },
    "SUPIR_decode": {
        "title": "SUPIR解碼",
        "inputs": {
            "SUPIR_VAE": "SUPIR_VAE",
            "latents": "Latent"
        },
        "widgets": {
            "use_tiled_vae": "分塊VAE",
            "decoder_tile_size": "解碼分塊尺寸"
        },
        "outputs": {
            "image": "影像"
        }
    },
    "SUPIR_first_stage": {
        "title": "SUPIR階段一",
        "inputs": {
            "SUPIR_VAE": "SUPIR_VAE",
            "image": "影像"
        },
        "widgets": {
            "use_tiled_vae": "分塊VAE",
            "encoder_tile_size": "編碼分塊尺寸",
            "decoder_tile_size": "解碼分塊尺寸",
            "encoder_dtype": "編碼剪枝"
        },
        "outputs": {
            "SUPIR_VAE": "SUPIR_VAE",
            "denoised_image": "影像",
            "denoised_latents": "Latent"
        },
        "description": "SUPIR 的「第一階段」。使用 SUPIR 的 denoise_encoder 編碼和解碼影像，用於修復壓縮偽影，但是會導致影像模糊。\n\n可以使用其他取樣器/模糊取代，或不使用該節點。"
    },
    "SUPIR_conditioner": {
        "title": "SUPIR條件",
        "inputs": {
            "SUPIR_MODEL": "SUPIR模型",
            "SUPIR_model": "SUPIR模型",
            "latents": "Latent",
            "captions": "標題/字幕"
        },
        "widgets": {
            "positive_prompt": "正面提示詞",
            "negative_prompt": "負面提示詞"
        },
        "outputs": {
            "positive": "正面條件",
            "negative": "負面條件"
        },
        "description": "為取樣器建立條件。\n 標題輸入是選配的，當它接收到一個標題時，會將其新增到正面提示中\n 如果為單個輸入影像提供了標題清單，那麼這些標題需要與圖塊的數量相匹配\n 請參考SUPIR分塊影像\n 如果提供了標題清單，並且該清單與傳入的影像批次相匹配，那麼每張影像都會使用相應的標題"
    },
    "SUPIR_sample": {
        "title": "SUPIR取樣",
        "inputs": {
            "SUPIR_model": "SUPIR模型",
            "latents": "Latent",
            "positive": "正面條件",
            "negative": "負面條件"
        },
        "widgets": {
            "seed": "隨機種",
            "control_before_generate": "運行前操作",
            "steps": "步數",
            "cfg_scale_start": "起始CFG縮放",
            "cfg_scale_end": "結束CFG縮放",
            "EDM_s_churn": "EDM隨機擾動",
            "s_noise": "雜訊量",
            "DPMPP_eta": "DPMPP步長參數",
            "control_scale_start": "起始控制縮放",
            "control_scale_end": "結束控制縮放",
            "restore_cfg": "恢復CFG",
            "keep_model_loaded": "保持模型載入",
            "sampler": "採樣器",
            "sampler_tile_size": "取樣器分塊尺寸",
            "sampler_tile_stride": "取樣器分塊步長"
        },
        "outputs": {
            "latent": "Latent"
        },
        "description": "- **latent：**\n\n用於取樣的 Latent，當使用 SUPIR Latent時，該項僅影響噪波形狀。\n\n其他情況下與 ComfyUI 預設相同。 \n\n如果存在 Latent 輸入，則會以輸入為準。\n\n- **CFG：**\n\n使用線性插值控制 CFG，使用 起始CFG縮放 作為初始值，線性縮放到 結束CFG縮放 數值。\n\n將這兩項設為相同的數值會停用插值縮放。\n\n- **EDM_s_churn：**\n\n控制取樣過程對 Latent 噪波變化的適應速度。\n\n對 DPMPP 取樣器無效。\n\n- **噪波量s_noise：**\n\n控制在取樣過程中每一步新增到 Latent 的噪波量。 \n\n- **DPMPP_eta：**\n\n透過調整降噪過程如何適應雜訊水平隨時間的變化來影響擴散過程的比例因子。\n\n對 EDM 取樣器無效。 \n\n- **控制縮放control_scale：**\n\nSUPIR 控制模型的強度，從開始到結束使用線性插值控制強度。\n\n數值越小，控制強度越小。\n\n- **恢復CFGrestore_cfg：**\n\n控制取樣過程中對原始影像的還原程度。\n\n用於圓頂微調取樣過程。\n\n- **取樣器：**\n\nEDM 需要很多步數，但通常品質較佳。\n\nDPMPP 需要較低的步數，適合 Lighting 模型。\n\n分塊取樣器 採用分塊取樣，速度非常慢，但可以用較低顯示記憶體獲得更高分辨率。\n\n分塊影像前需要確定分塊尺寸，分塊步長影響每個分塊的重疊大小。分塊功能可以參考 SUPIR分塊影像 節點。"
    },
    "SUPIR_tiles": {
        "title": "SUPIR分塊影像",
        "inputs": {
            "image": "影像"
        },
        "widgets": {
            "tile_size": "分塊尺寸",
            "tile_stride": "分塊步長"
