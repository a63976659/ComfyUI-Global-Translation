            "encoder_tile_size_pixels": "解碼分塊尺寸像素",
            "decoder_tile_size": "解碼分塊尺寸",
            "decoder_tile_size_latent": "解碼分塊尺寸Latent",
            "diffusion_dtype": "剪枝類型",
            "encoder_dtype": "編碼剪枝",
            "batch_size": "批次大小",
            "use_tiled_sampling": "使用分塊取樣",
            "used_tiled_sampling": "使用分塊取樣",
            "sampler_tile_size": "取樣器分塊尺寸",
            "sampler_tile_stride": "取樣器分塊步長",
            "fp8_unet": "FP8 UNet精度",
