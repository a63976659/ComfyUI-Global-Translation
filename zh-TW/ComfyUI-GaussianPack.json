{
    "GaussianAnalysis": {
        "title": "高斯分析",
        "inputs": {
            "ply_path": "路徑"
        },
        "outputs": {
            "report": "報告"
        },
        "description": "檢查一個3DGS PLY檔案，並報告格式/SH階數/精度/大小。"
    },
    "GaussianExport": {
        "title": "高斯匯出",
        "inputs": {
            "ply_path": "路徑"
        },
        "widgets": {
            "output_filename": "輸出檔案名稱",
            "format": "格式"
        },
        "outputs": {
            "out_path": "輸出路徑"
        },
        "description": "將一個3DGS PLY轉換為另一種變體（PLY直通、剝除SH的PLY或SPZ）。"
    },
    "GaussiansFromPointCloud": {
        "title": "點雲中的高斯分布",
        "inputs": {
            "ply_path": "路徑"
        },
        "widgets": {
            "output_filename": "輸出檔案名稱",
            "output_dir": "輸出目錄",
            "init_scale": "初始尺度",
            "init_opacity": "初始透明度",
            "knn_k": "Knn K",
            "subsample_max": "子取樣最大值"
        },
        "outputs": {
            "ply_path": "路徑"
        },
        "description": "將點雲PLY轉換為具有KNN推導尺度的3DGS PLY。"
    },
    "LoadPLY": {
        "title": "載入`.ply`檔案",
        "widgets": {
            "ply_file": "資料夾"
        },
        "outputs": {
            "ply_path": "路徑"
        },
        "description": "從ComfyUI的輸入/目錄瀏覽`.ply`檔案。"
    },
    "LoadPLYOutput": {
        "title": "載入`.ply`輸出",
        "widgets": {
            "ply_file": "PLY檔案"
        },
        "outputs": {
            "ply_path": "PLY路徑"
        },
        "description": "從ComfyUI的output/目錄遞迴瀏覽`.ply`檔案。"
    },
    "GaussianMerge": {
        "title": "高斯合併",
        "inputs": {
            "ply_path": "PLY路徑"
        },
        "widgets": {
            "target_count": "目標數量",
            "output_filename": "輸出檔案名稱",
            "opacity_threshold": "透明度閾值",
            "k": "k",
            "backend": "後端"
        },
        "outputs": {
            "ply_path": "PLY路徑"
        },
        "description": "將3DGS PLY按配對方式合併至目標高斯數量。"
    },
    "PreviewGaussians": {
        "title": "預覽高斯分布",
        "inputs": {
            "ply_path": "PLY路徑"
        },
        "widgets": {
            "camera_mode": "相機模式",
            "fov_degrees": "視場角度",
            "renderer": "渲染器",
            "transport_format": "傳輸格式"
        },
        "description": "互動式的高斯斑點檢視器（gspalt.js）。\n\n支援軌道（旋轉球體）和觀察者（WASD飛行攝影機）兩種相機模式。"
    },
    "PreviewGaussianCamera": {
        "title": "預覽高斯相機",
        "inputs": {
            "ply_path": "PLY路徑",
            "extrinsics": "外參",
            "intrinsics": "內參"
        },
        "widgets": {
            "image_width": "影像寬度",
            "image_height": "影像高度",
            "near_plane": "近裁剪平面",
            "background": "背景",
            "force_backend": "強制後端"
        },
        "outputs": {
            "image": "影像"
        },
        "description": "根據給定的相機姿態渲染一個3DGS PLY到一個IMAGE批次。"
    },
    "PreviewGaussianDual": {
        "title": "預覽高斯雙",
        "inputs": {
            "ply_path_1": "PLY路徑1",
            "ply_path_2": "PLY路徑2"
        },
        "widgets": {
            "camera_mode": "相機模式",
            "fov_degrees": "視場角度",
            "renderer": "渲染器",
            "transport_format": "傳輸格式",
            "layout": "佈局"
        },
        "description": "側邊比較兩個高斯斑點或將它們以滑桿形式顯示。"
    },
    "PreviewGaussianSharp": {
        "title": "預覽高斯銳化",
        "widgets": {
            "ply_path": "PLY路徑",
            "extrinsics": "外參",
            "intrinsics": "內參"
        },
        "description": "預覽SHARP高斯斑點Ply檔案（gspalt.js檢視器）。\n\n複製GeometryPack的預覽高斯：接受EXTRINSICS/INTRINSICS並重新產生擷取的相機視角（相機位於外參推導的位置向下看+Z，FOV來自內參）。最適合成SHARP /單目深度扇形高斯，這些高斯只有在擷取原點處才正確。"
    },
    "TransformGaussian": {
        "title": "轉換高斯",
        "inputs": {
            "ply_path": "PLY路徑"
        },
        "widgets": {
            "rotate_x": "繞X軸旋轉",
            "rotate_y": "繞Y軸旋轉",
            "rotate_z": "繞Z軸旋轉"
        },
        "outputs": {
            "ply_path": "PLY路徑"
        },
        "description": "圍繞XYZ軸旋轉一個高斯斑點Ply（度數）。\n\n位置和每個斑點的四元數一起旋轉；如果存在，則法線也旋轉。SH AC係數未改變（正確的Wigner-D旋轉是後續步驟）。"
    }
}