{
    "CRMPreprocessForPoser": {
        "title": "CRM Poser 前置處理",
        "inputs": {
            "reference_image": "影像",
            "reference_mask": "遮罩"
        },
        "widgets": {
            "foreground_ratio": "前景比率"
        },
        "outputs": {
            "processed": "處理影像"
        }
    },
    "CRMPoserConfig": {
        "title": "CRM Poser 配置",
        "inputs": {
            "processed_image": "處理影像"
        },
        "widgets": {
            "seed": "隨機種",
            "control_before_generate": "運行前操作",
            "cfg": "CFG",
            "steps": "步數"
        },
        "outputs": {
            "CRM_POSE_CONFIG": "Poser配置"
        }
    },
    "CRMPoseSampler": {
        "title": "CRM Poser 採樣器",
        "inputs": {
            "config": "Poser配置"
        },
        "widgets": {
            "pixel_model": "Pixel模型"
        },
        "outputs": {
            "IMAGE": "Pose影像"
        }
    },
    "CCMSampler": {
        "title": "CCM 採樣器",
        "inputs": {
            "config": "Poser配置",
            "poses": "Pose影像"
        },
        "widgets": {
            "ccm_model": "CCM模型"
        },
        "outputs": {
            "IMAGE": "座標影像"
        }
    },
    "CRMModelLoader": {
        "title": "CRM模型載入器",
        "widgets": {
            "crm_model": "CRM模型"
        },
        "outputs": {
            "CRM_MODEL": "CRM模型"
        }
    },
    "CRMModeler": {
        "title": "CRM模型生成",
        "inputs": {
            "crm_model": "CRM模型",
            "poses": "Pose影像",
            "coordinates": "座標影像"
        },
        "outputs": {
            "MESH": "網格模型"
        }
    },
    "CRMModelerCuda": {
        "title": "CRM模型生成(僅CUDA)",
        "inputs": {
            "crm_model": "CRM模型",
            "poses": "Pose影像",
            "coordinates": "座標影像"
        },
        "outputs": {
            "MESH": "網格模型"
        }
    },
    "CRMViewer": {
        "title": "CRM網格模型預覽",
        "inputs": {
            "mesh": "網格模型"
        }
    }
}