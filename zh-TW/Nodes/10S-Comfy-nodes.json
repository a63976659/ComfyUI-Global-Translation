    },
    "LTXTiledSampler": {
        "title": "LTX平鋪採樣器",
        "inputs": {
            "noise": "噪音",
            "guider": "引導器",
            "sampler": "採樣器",
            "sigmas": "sigma",
            "latent_image": "Latent影像"
        },
        "widgets": {
            "bypass_tiling": "跳過平鋪",
            "tile_axis": "平鋪軸",
            "n_tiles": "平鋪數量",
            "tile_overlap": "平鋪重疊",
            "max_size_for_no_tile": "無平鋪的最大尺寸",
            "audio_pass": "音訊通過",
            "audio_carrier_tile": "音訊載體平鋪",
            "debug": "偵錯"
        },
        "outputs": {
            "output": "輸出",
            "denoised_output": "去噪輸出"
        },
        "description": "適用於LTX2上採樣階段輕度細化的平鋪式drop-in替換SamplerCustomAdvanced。每個平鋪執行完整的訓練分佈token計數採樣，然後以餘弦混合。僅用於輕度去噪。預設音訊通過；audio_carrier_tile讓音訊採樣與一個選定的平鋪同時執行（無需額外步驟）。設定bypass_tiling=true即可作為標準單次採樣的透明通過，適用於偵錯或不需要平鋪的情況。"
    },
    "LTXVLatentUpsamplerTiled": {
        "title": "LTXV Latent 上採樣器（瓦片版）",
        "inputs": {
            "samples": "樣本",
            "upscale_model": "超解析度模型",
            "vae": "VAE"
        },
        "widgets": {
            "tile_size": "瓦片大小",
            "overlap": "重疊",
            "max_size_for_no_tile": "無需瓦片的最大尺寸",
            "rotate_for_landscape": "旋轉以適配橫屏",
            "debug": "偵錯"
        },
        "description": "LTXVLatentUpsampler 的瓦片式drop-in替代方案。透過在空間瓦片上執行上採樣，並使用餘弦窗重疊融合，有效解決極端長寬比下的色彩偏移和失真問題。在安全長寬比場景下，輸出與非瓦片版本幾乎一致；在極端情況則避免了超解析度模型的不穩定現象。"
    },
