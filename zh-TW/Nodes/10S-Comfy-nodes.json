        "description": "每個區塊的注意力向參考特徵拉近以保持身份一致。兩種模式：(1) 從LikenessGuide取得參考資訊並使用其附加的參考幀；(2) 不連接參考資訊，該節點使用Latent的幀0作為參考——適用於i2v工作流，其中幀0是條件起始影像。v1.2採用定向拉取模式（保留顏色）。"
    },
    "LTXLikenessGuide": {
        "title": "LTX相似性引導",
        "inputs": {
            "positive": "正向提示",
            "negative": "負向提示",
            "vae": "vae",
            "latent": "latent",
            "image": "參考影像"
        },
        "widgets": {
            "strength": "強度",
            "placement_mode": "放置模式",
            "face_detect": "人臉偵測",
            "reference_mask_mode": "參考遮罩模式",
            "face_padding": "人臉填充",
            "crf": "CRF",
            "blur_radius": "模糊半徑",
            "interpolation": "插值",
            "crop": "裁切",
            "attention_strength": "注意力強度",
            "face_bbox_within_reference": "人臉邊框在參考內",
            "emit_latent": "發射latent",
            "debug": "偵錯"
        },
        "outputs": {
            "positive": "正向提示",
            "negative": "負向提示",
            "latent": "latent",
            "reference_info": "參考資訊"
        },
        "description": "附加相似性參考影像到條件設定以保存身份。發射修改後的正向/負向條件（用於Guider）和參考資訊中繼資料（用於LikenessAnchor）。預設情況下，latent輸出是對輸入的通過——無需擴展，也無需裁切。引導的價值來自於其與模型及其bbox中繼資料的條件互動，而不是來自latent修改。"
    },
    "LTXLikenessCrop": {
        "title": "LTX相似性裁切",
        "inputs": {
            "latent": "latent",
            "reference_info": "參考資訊"
        },
        "widgets": {
            "debug": "偵錯"
        },
        "description": "在VAE解碼前從Latent裁切相似性參考幀。反轉LTXLikenessGuide的emit_latent=擴展模式。僅當引導發出擴展latent時使用。若引導處於通過模式（預設），則無需使用此節點——可直接將latent連接至VAE解碼。"
    },
