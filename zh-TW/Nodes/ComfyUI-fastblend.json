{
    "alert_when_finished": {
        "title": "完成後提示",
        "inputs": {
            "images": "影像"
        },
        "widgets": {
            "sound_path": "提示音路徑"
        }
    },
    "FillDarkMask": {
        "title": "填充深色遮罩",
        "inputs": {
            "masks": "遮罩"
        },
        "outputs": {
            "MASK": "遮罩"
        }
    },
    "SaveImage": {
        "title": "儲存影像",
        "inputs": {
            "images": "圖片"
        },
        "widgets": {
            "filename_prefix": "檔名前綴",
            "output_path": "輸出路徑",
            "prompt": "提示資訊",
            "extra_pnginfo": "額外PNG訊息"
        }
    },
    "InterpolateKeyFrame": {
        "title": "關鍵幀插值（滑鼠放在此處查看註解）",
        "inputs": {
            "orginalframe": "原影片",
            "keyframe": "需要插幀影片"
        },
        "widgets": {
            "select_every_nth": "每N幀選擇",
            "batch_size": "批次處理大小",
            "tracking_window_size": "追蹤視窗大小",
            "minimum_patch_size": "最小補丁尺寸",
            "num_iter": "迭代次數",
            "guide_weight": "引導權重"
        },
        "outputs": {
            "IMAGE": "影像"
        },
        "description": "插幀，僅使用部分幀平滑影片\n 參數含義\n每N幀選擇：間隔N幀插入\n批次大小：批次大小越大，程式執行速度越快，但需要更多顯存。\n視窗大小：影片的流暢度。\n最小補丁尺寸：奇數（重要），越大越好\n迭代次數：迭代次數，次數越多越好\n引導權重：一個決定將多少運動特徵套用於風格影片的參數。\n準確率：越大越好，大多數情況下1就足夠了\n  時間複雜度（準確率=1）：log(視窗大小) * 最小補丁大小^2 * 迭代次數 * 影片長度 * 影片解析度 \n"
    },
    "MaskListcaptoBatch": {
        "title": "遮罩清單批次處理",
        "inputs": {
            "mask": "遮罩"
        },
        "widgets": {
            "load_cap": "載入上限"
        },
        "outputs": {
            "MASK": "遮罩"
        }
    },
    "Merge_Image_List": {
        "title": "合併影像清單",
        "inputs": {
            "images": "影像"
        },
        "outputs": {
            "IMAGE": "影像"
        }
    },
    "MyOpenPoseNode": {
        "title": "OpenPose姿態辨識節點",
        "inputs": {
            "DWPose": "DWPose動態姿態",
            "OpenPose": "OpenPose姿態"
        },
        "widgets": {
            "hex_color": "十六進位顏色",
            "image": "影像",
            "reserved_colors": "保留顏色"
        },
        "outputs": {
            "IMAGE": "影像"
        },
        "description": " 因為DWPose姿態在人物轉身的時候無法辨識人物後背，但是在人物姿勢方面比OpenPose姿態準確，而OpenPose姿態可以很好的辨識後背，這個就是結合了兩者的優點"
    },
    "reBatchImage": {
        "title": "影像批次複處理",
        "inputs": {
            "image": "影像"
        },
        "widgets": {
            "batch_size": "批次處理大小"
        },
        "outputs": {
            "IMAGE": "影像"
        },
        "description": "特別為快速混合而設計，同時渲染影像（720p，24G影片記憶體，batch_size可調整為40），速度提升約40%。"
    },
    "SmoothVideo": {
        "title": "影片平滑處理",
        "inputs": {
            "orginalframe": "原始幀",
            "keyframe": "關鍵影格"
        },
        "widgets": {
            "accuracy": "精確度",
            "window_size": "視窗大小",
            "batch_size": "批次處理大小",
            "tracking_window_size": "追蹤視窗大小",
            "minimum_patch_size": "最小補丁尺寸",
            "num_iter": "迭代次數",
            "guide_weight": "引導權重"
        },
        "outputs": {
            "IMAGE": "影像"
        },
        "description": "逐幀渲染/流暢影片使用每一幀"
    }
}