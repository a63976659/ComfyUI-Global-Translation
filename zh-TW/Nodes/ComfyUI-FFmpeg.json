{
    "AddAudio": {
        "title": "🔥加入音訊",
        "widgets": {
            "video_path": "影片路徑",
            "audio_from": "音訊來源",
            "file_path": "檔案路徑",
            "delay_play": "延遲播放",
            "output_path": "輸出路徑"
        },
        "outputs": {
            "video_complete_path": "影片完整路徑",
            "string": "文字/字串"
        },
        "description": " 作用是給影片加入音訊\n 音訊可以來源於音訊檔案，也可以來源於影片檔案。"
    },
    "AddImgWatermark": {
        "title": "🔥影片加入影像水印",
        "widgets": {
            "video_path": "影片路徑",
            "output_path": "影片輸出路徑",
            "watermark_image": "水印影像路徑",
            "watermark_img_width": "水印影像寬度",
            "position_x": "X 位置",
            "position_y": "Y 位置"
        },
        "outputs": {
            "video_complete_path": "影片完整路徑",
            "string": "文字/字串"
        },
        "description": " 作用是在影片上加入圖片水印"
    },
    "AddTextWatermark": {
        "title": "🔥影片加入文字水印",
        "widgets": {
            "video_path": "影片路徑",
            "output_path": "輸出路徑",
            "font_file": "字型檔案",
            "font_size": "字體大小",
            "font_color": "字體顏色",
            "text": "文字",
            "position_x": "X 位置",
            "position_y": "Y 位置"
        },
        "outputs": {
            "video_path": "影片路徑",
            "output_path": "輸出路徑",
            "string": "字串"
        },
        "description": " 作用是在影片上加入文字水印 \n 支持中英文，需要將中文字型放入套件fonts目錄下"
    },
    "ExtractAudio": {
        "title": "🔥擷取音訊",
        "widgets": {
            "video_path": "影片路徑",
            "output_path": "輸出路徑",
            "audio_format": "音訊格式"
        },
        "outputs": {
            "audio_complete_path": "音訊完整路徑",
            "string": "字串"
        },
        "description": " 作用是擷取影片中的音訊\n 儲存音訊格式，包括 .m4a，.mp3，.wav，.aac，.flac，.wma，.ogg，.ac3，.amr，.aiff，.opus，.m4b，.caf，.dts 等等。"
    },
    "Frames2Video": {
        "title": "🔥序列幀轉影片",
        "widgets": {
            "frame_path": "幀路徑",
            "fps": "幀率",
            "video_name": "影片名稱",
            "output_path": "輸出路徑",
            "device": "裝置",
            "audio_path": "音訊路徑"
        },
        "outputs": {
            "frame_path": "幀路徑",
            "output_path": "輸出路徑",
            "string": "字串"
        },
        "description": " 手動輸入路徑，路徑不要有引號"
    },
    "ImageCopy": {
        "title": "🔥影像複製",
        "inputs": {
            "image_paths": "影像路徑",
            "output_path": "輸出路徑"
        },
        "widgets": {
            "image_paths": "影像路徑",
            "output_path": "輸出路徑"
        },
        "outputs": {
            "image_paths": "影像路徑",
            "image_length": "影像數量",
            "output_path": "輸出路徑",
            "string": "文字/字串"
        }
    },
    "ImagePath2Tensor": {
        "title": "🔥影像路徑轉張量",
        "inputs": {
            "image_paths": "影像路徑"
        },
        "outputs": {
            "image": "影像",
            "image_count": "影像數量"
        }
    },
    "ImagesSave": {
        "title": "🔥儲存影像",
        "inputs": {
            "images": "影像",
            "output_path": "輸出路徑"
        },
        "widgets": {
            "output_path": "輸出路徑"
        },
        "outputs": {
            "image_length": "影像數量",
            "int": "整數"
        }
    },
    "LoadImageFromDir": {
        "title": "🔥從目錄載入影像",
        "widgets": {
            "images_path": "影像路徑",
            "start_index": "起始索引",
            "length": "長度"
        },
        "outputs": {
            "images_path": "影像路徑",
            "list": "清單"
        }
    },
    "MergingVideoByPlenty": {
        "title": "🔥批次合併影片",
        "widgets": {
            "video_path": "影片路徑",
            "output_path": "輸出路徑"
        },
        "outputs": {
            "video_complete_path": "影片完整路徑",
            "string": "文字/字串"
        },
        "description": " 作用是把多個編碼格式、解析度、幀率都一樣的短影片合併成長影片。\n 要求該影片路徑下所有影片的編碼格式、幀率以及解析度一樣。"
    },
    "MergingVideoByTwo": {
        "title": "🔥合併影片",
        "widgets": {
            "video1_path": "影片_1 路徑",
            "video2_path": "影片_2 路徑",
            "device": "裝置",
            "resolution_reference": "解析度參考",
            "output_path": "輸出路徑"
        },
        "outputs": {
            "video_complete_path": "影片完整路徑",
            "string": "文字/字串"
        },
        "description": " 作用是合併兩個影片，比如把兩個一小時的影片合併成一個時長為2小時的影片\n 合併後的影片尺寸是多少，可以參考第一個影片或者第二個影片。"
    },
    "MultiCuttingVideo": {
        "title": "🔥影片多次剪輯",
        "widgets": {
            "video_path": "影片路徑",
            "output_path": "輸出路徑",
            "segment_time": "片段時間"
        },
        "outputs": {
            "video_complete_path": "影片完整路徑",
            "string": "文字/字串"
        },
        "description": " 作用是把一個影片切割成若干個影片。\n 切割的每個影片長度，單位為秒，需要注意的是，它是根據關鍵幀切割影片的，所以時間不能太短。因為不能保證每一段影片都有關鍵幀，所以每一段影片時長不一定都一樣，只是最接近的。"
    },
    "PipVideo": {
        "title": "🔥畫中畫影片",
        "widgets": {
            "video1_path": "影片_1 路徑",
            "video2_path": "影片_2 路徑",
            "device": "裝置",
            "use_audio": "使用音訊",
            "use_duration": "使用時長",
            "align_type": "對齊類型",
            "pip_fg_zoom": "畫中畫前景縮放",
            "output_path": "輸出路徑",
            "scale_and_crop": "縮放和裁切",
            "fps": "幀率",
            "is_chromakey": "是否進行綠幕摳像"
        },
        "outputs": {
            "video_complete_path": "影片完整路徑",
            "width": "寬度",
            "height": "高度",
            "duration": "持續時間",
            "fps": "幀率"
        },
        "description": " 畫中畫背景縮放係數，越大前景畫面越小，值為背景寬高的縮小倍數。\n 最終影片的幀率，預設為30.0，設定為0將使用video2的幀率，設定為1為將使用video2的幀率。"
    },
    "SingleCuttingVideo": {
        "title": "🔥影片剪輯",
        "widgets": {
            "video_path": "影片路徑",
            "output_path": "輸出路徑",
            "start_time": "開始時間",
            "end_time": "結束時間"
        },
        "outputs": {
            "video_complete_path": "影片完整路徑",
            "string": "文字/字串"
        },
        "description": " 作用是切割指定影片中某個時間段的影片。"
    },
    "StitchingVideo": {
        "title": "🔥拼接影片",
        "widgets": {
            "video1_path": "影片_1 路徑",
            "video2_path": "影片_2 路徑",
            "device": "裝置",
            "use_audio": "選擇使用目標音訊",
            "stitching_type": "拼接類型",
            "output_path": "輸出路徑",
            "scale_and_crop": "縮放和裁切"
        },
        "outputs": {
            "video_complete_path": "影片完整路徑",
            "string": "文字/字串"
        },
        "description": " 作用是拼接兩個影片，分成水平拼接和垂直拼接兩種拼接方式。"
    },
    "Video2Frames": {
        "title": "🔥影片轉序列幀",
        "widgets": {
            "video_path": "影片路徑",
            "output_path": "輸出路徑",
            "frames_max_width": "幀最大寬度"
        },
        "outputs": {
            "string": "字串",
            "frame_path": "幀路徑",
            "fps": "幀率",
            "audio_path": "音訊路徑",
            "total_frames": "總幀數",
            "output_path": "輸出路徑",
            "int": "整數"
        },
        "description": " 幀最大寬度\n 預設為0，表示不縮放影片，如果 幀最大寬度 大於影片實際寬度，則影片不會被放大，保持原寬度，如果 幀最大寬度 小於影片實際寬度，則影片會被縮小。"
    },
    "VideoFlip": {
        "title": "🔥翻轉影片",
        "widgets": {
            "video_path": "影片路徑",
            "output_path": "輸出路徑",
            "flip_type": "翻轉類型"
        },
        "outputs": {
            "video_complete_path": "影片完整路徑",
            "string": "文字/字串"
        },
        "description": "  作用是翻轉影片\n horizontal水平翻轉，vertical垂直翻轉，both水平加垂直翻轉。"
    },
    "VideoPlayback": {
        "title": "🔥播放影片",
        "widgets": {
            "video_path": "影片路徑",
            "output_path": "輸出路徑",
