        "title": "🔥影片轉場",
        "widgets": {
            "video1_path": "影片_1 路徑",
            "video2_path": "影片_2 路徑",
            "reference_video": "參考影片",
            "device": "裝置",
            "transition": "轉場",
            "transition_duration": "轉場時長",
            "offset": "偏移量",
            "output_path": "輸出路徑"
        },
        "outputs": {
            "video_complete_path": "影片完整路徑",
            "string": "文字/字串"
        },
        "description": "給兩個影片加入轉場過渡動畫效果。"
    }
}