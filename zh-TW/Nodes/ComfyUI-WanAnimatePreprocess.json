            "face_bboxes": "面部邊界框"
        }
    },
    "DrawViTPose": {
        "title": "繪製ViTPose姿態",
        "inputs": {
            "pose_data": "姿態數據"
        },
        "widgets": {
            "width": "寬度",
            "height": "高度",
            "retarget_padding": "重導向填充",
            "body_stick_width": "身體關節寬度",
