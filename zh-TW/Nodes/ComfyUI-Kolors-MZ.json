        },
        "widgets": {
            "width": "寬度",
            "height": "高度",
            "crop_w": "裁切寬度",
            "crop_h": "裁切高度",
            "target_width": "目標寬度",
            "target_height": "目標高度"
        },
        "outputs": {
            "positive": "正面條件",
            "negative": "負面條件"
