        },
        "outputs": {
            "CONDITIONING": "條件"
        }
    },
    "MZ_ChatGLM3_Advance_V2": {
        "title": "ChatGLM3編碼_V2進階",
        "inputs": {
            "chatglm3_model": "ChatGLM3"
        },
        "widgets": {
            "text": "文字",
            "width": "寬度",
            "height": "高度",
            "crop_w": "裁切寬度",
            "crop_h": "裁切高度",
            "target_width": "目標寬度",
            "target_height": "目標高度"
        },
        "outputs": {
            "CONDITIONING": "條件"
        }
    },
    "MZ_ChatGLM3Embeds2Conditioning": {
        "title": "ChatGLM3嵌入組到條件",
