{
    "BFSAmvGuideBuilder": {
        "title": "BFS AMV引導產生器",
        "inputs": {
            "video": "影片",
            "images": "影像",
            "audio": "音訊"
        },
        "widgets": {
            "mode": "模式",
            "length": "長度",
            "hold": "保持",
            "fill": "填充",
            "placement": "放置",
            "fps": "幀率",
            "indices": "索引",
            "scene_threshold": "場景閾值"
        },
        "outputs": {
            "guide": "引導",
            "debug": "偵錯"
        },
        "description": "產生AMV引導（關鍵幀+空白幀）。external_images可自動將影像放置在音樂節拍處（placement設為audio_beats）。將`引導`輸入VAE或參考模組。"
    },
    "BFSAnime2RealBerniniConditioning": {
        "title": "BFS Bernini動漫轉真實感條件產生",
        "inputs": {
            "positive": "正向",
            "negative": "負向",
            "vae": "VAE",
            "guide_video": "引導影片"
        },
        "widgets": {
            "length": "長度"
        },
        "outputs": {
            "positive": "正向",
            "negative": "負向",
            "latent": "Latent",
            "debug": "偵錯"
        },
        "description": "用於Bernini-R動漫轉真實感LoRA的純影片轉影片（v2v）動漫→真實感條件產生。guide_video對應source_id 1（動漫畫布）| 輸出對應source_id 0（真實照片）。無參考模組。引導同時應用於正向和負向，因此CFG僅放大文字提示（真實照片風格），而非參考。使用適中的CFG；引導保留運動/佈局。請勿將此LoRA與換臉節點配合使用：它會注入source_id 2標記，而動漫轉真實感LoRA在訓練中從未見過該標記。"
    },
    "LTXColorMask": {
        "title": "LTX顏色遮罩",
        "inputs": {
            "mask": "遮罩"
        },
        "widgets": {
            "color": "顏色",
            "style": "樣式",
            "marker_radius_frac": "標記半徑比例",
