    "LTXVEditAnythingApply": {
        "title": "LTXV編輯任意內容應用",
        "inputs": {
            "model": "模型",
            "positive": "正向",
            "negative": "負向",
            "vae": "VAE",
            "latent": "Latent",
            "ref_image": "參考影像",
            "lora_name": "LoRA名稱",
            "guide_frames": "引導幀",
            "ref_temporal_offset_latents": "參考時間偏移Latent"
        },
        "widgets": {
            "resize_mode": "縮放模式",
            "guide_strength": "引導強度",
            "ref_strength": "參考強度",
            "role_strength": "角色強度",
            "adaln_scale": "AdaLN縮放",
            "enable_adaln": "啟用AdaLN",
            "enable_role_embedding": "啟用角色嵌入",
            "debug": "偵錯"
        },
        "outputs": {
            "model": "模型",
            "positive": "正向",
            "negative": "負向",
            "latent": "Latent",
            "ref_image_preview": "參考影像預覽"
        },
        "description": "用於影片轉影片參考AdaLN LoRA的統一編輯任意內容條件產生。在單一節點中應用來自單一LoRA檢查點的全部3種條件訊號：① IC-LoRA序列 對參考影像和可選引導影片進行編碼，將它們作為乾淨的條件幀附加到Latent中。在Transformer中的佈局：[目標標記 | 參考標記 @ t=-1 | 引導標記 @ t=0..T] ② 角色嵌入（role_embedding.embedding.權重[0]） 在patchify_proj之前，向參考影像標記添加學習到的128維指紋，以便模型透過自注意力區分@參考圖和引導幀。③ AdaLN條件產生（ref_adaln_proj: fc1 → SiLU → proj） 使用LoRA中儲存的投影器形狀池化參考影像Latent，透過2層MLP投影到AdaLN時間步空間，並將其添加到每個Transformer塊的時間步偏置中——這是一個持久的全域外觀錨點。連接在標準LoRA載入器之後，KSampler之前。"
    },
    "LTXVApplyNeutralMask": {
        "title": "LTXV應用中性遮罩",
        "inputs": {
            "image": "影像",
            "mask": "遮罩"
        },
        "widgets": {
            "background": "背景",
            "hard_edges": "硬邊"
        },
        "outputs": {
            "image": "影像"
        },
        "description": "以乾淨的純色背景替換遮罩掉的影像/影片區域，在將參考影像或引導幀輸入LTXV條件產生之前很有用。"
    },
    "LTXVResizeReferenceByMask": {
        "title": "LTXV按遮罩調整參考大小",
        "inputs": {
            "ref_image": "參考影像",
            "size_mask": "尺寸遮罩",
            "ref_mask": "參考遮罩"
        },
        "widgets": {
            "fit": "適應",
            "background": "背景",
            "padding": "填充",
            "hard_edges": "硬邊"
        },
        "outputs": {
            "image": "影像",
            "object_mask": "物件遮罩"
        },
        "description": "使用遮罩邊界框作為目標物件尺寸，在乾淨畫布上調整參考物件的大小。遮罩位置被忽略；僅其寬度和高度定義目標縮放比例。"
    },
    "LTXVEditAnythingLoopingSampler": {
        "title": "LTXV編輯任意內容迴圈採樣器",
        "inputs": {
            "model": "模型",
            "vae": "VAE",
            "noise": "噪音",
            "sampler": "採樣器",
            "sigmas": "西格瑪",
