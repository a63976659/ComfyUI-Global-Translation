            "negative": "負向條件",
            "latents": "Latent",
            "editanything_module": "編輯任意內容模組",
            "ref_image": "參考影像",
            "guide_frames": "引導幀"
        },
        "widgets": {
            "temporal_tile_size": "時間塊大小",
            "temporal_overlap": "時間重疊",
            "blend_overlap": "混合重疊",
            "lora_name": "LORA名稱",
            "ref_resize_mode": "參考縮放模式",
            "ref_strength": "參考強度",
            "guide_strength": "引導強度",
            "role_strength": "角色強度",
            "adaln_scale": "AdaLN縮放",
            "enable_ic_lora": "啟用IC-LORA",
            "enable_role_embedding": "啟用角色嵌入",
            "enable_adaln": "啟用AdaLN",
            "reapply_per_chunk": "每塊重新應用",
            "enable_visual_crossattn": "啟用視覺交叉注意力",
            "ref_context_scale": "參考上下文縮放",
            "ref_token_scale": "參考令牌縮放",
            "ref_start_block": "參考起始塊",
            "ref_end_block": "參考結束塊",
            "ref_init_from": "參考初始化來源",
            "ref_init_seed": "參考初始化隨機種子",
            "ref_attn_lora_strength": "參考注意力LORA強度",
            "debug_ea": "偵錯EA",
            "ref_temporal_offset_latents": "參考時間偏移Latent"
        },
        "outputs": {
            "denoised_output": "去噪輸出",
            "ref_image_preview": "參考影像預覽",
            "diff_vs_previous_run": "與前一次執行的差異"
        },
        "description": "時間迴圈採樣器，每個塊都帶有完整的編輯任意內容條件。\n\n與LTXVEditAnythingApply類似，但會在時間上對影片進行切片，並在每個塊中重新應用參考+引導IC-LoRA令牌（透過LTXVAddGuide.append_keyframe）、角色嵌入和AdaLN。每個塊對應引導影片的一個切片。\n\n輸入為明確的正向/負向條件；GUIDER輸入僅提供採樣機制（CFG/STG參數），其條件會透過guider.set_conds在每個塊中被覆蓋。"
    },
    "LTXVLatentDiffMetrics": {
        "title": "LTXVLatent差異指標",
        "inputs": {
            "latent_a": "LatentA",
            "latent_b": "LatentB"
        },
        "widgets": {
            "label": "標籤",
            "print_console": "列印至控制台",
            "compare_noise_mask": "比較雜訊遮罩"
        },
        "outputs": {
            "metrics": "指標",
            "latent_a": "LatentA",
            "mse": "MSE",
            "psnr": "PSNR",
            "l1": "L1",
            "cosine": "餘弦相似度"
        },
        "description": "比較兩個Latent並回報MSE/RMSE/L1/PSNR/餘弦相似度。\n\n用於A/B測試切換項：使用配置A執行採樣器，儲存Latent→使用配置B執行→將SaveLatent.A和新輸出連接至此節點。輸出既包含用於UI/控制台的格式化字串，也包含單獨的浮點數，以便您可以鏈接到繪圖器或另存為文字節點。\n\n如果兩個Latent形狀不同（例如因VAE差異導致空間不匹配），則會回退至比較重疊子區域。"
    },
    "LTXVImageDiffMetrics": {
        "title": "LTXV影像差異指標",
        "inputs": {
            "image_a": "影像A",
            "image_b": "影像B"
        },
        "widgets": {
            "label": "標籤",
            "print_console": "列印至控制台"
        },
        "outputs": {
            "metrics": "指標",
            "image_a": "影像A",
            "mse": "MSE",
            "psnr": "PSNR",
            "l1": "L1"
        },
        "description": "與LTXVLatentDiffMetrics類似，但適用於解碼後的影像（VAE之後）——PSNR使用[0,1]像素範圍。在兩次執行解碼後用於比較視覺相關的像素誤差非常有用。"
    },
