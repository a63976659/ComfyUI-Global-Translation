            "disabled": "關閉",
            "ceter": "置中"
        },
        "outputs": {
            "LATENT": "Latent",
            "count": "計數"
        },
        "description": "將兩組Latent合併為一組Latent \n\n"
    },
    "VHS_SelectEveryNthLatent": {
        "title": "選擇Latent（間隔）",
        "inputs": {
            "latents": "Latent"
        },
        "widgets": {
            "select_every_nth": "間隔",
            "skip_first_latents": "跳過前X張"
        },
        "outputs": {
            "LATENT": "Latent",
            "count": "計數"
        },
        "description": "每個間隔只保留1個Latent \n\n"
    },
    "VHS_SelectLatents": {
        "title": "選擇Latent（索引）",
        "inputs": {
            "latent": "Latent"
        },
        "widgets": {
            "indexes": "索引",
            "err_if_missing": "缺失時報錯",
            "err_if_empty": "為空時報錯"
        },
        "outputs": {
            "LATENT": "Latent"
        },
        "description": "使用逗號分隔的編號索引依給定順序選擇輸入項\n\n支援負索引、Python樣式範圍（不包括結束索引）以及範圍步長\n\n範例（假設輸入16個項，索引0-15）：\n\n• 0         → 輸出 [0]\n• -1        → 輸出 [15]\n• 0,1,13    → 輸出 [0,1,13]\n• 0:5,13    → 輸出 [0,1,2,3,4,13]\n• 0:-1      → 輸出 [0,1,2,...,14]\n• 0:5:-1    → 輸出 [4,3,2,1,0]\n• 0:5:2     → 輸出 [0,2,4]\n• ::-1      → 輸出 [15,14,...,0]"
    },
    "VHS_GetLatentCount": {
        "title": "獲取Latent數量",
        "inputs": {
            "latents": "Latent"
        },
        "outputs": {
            "count": "計數"
        },
        "description": "以整數形式返回輸入中的Latent \n\n"
    },
