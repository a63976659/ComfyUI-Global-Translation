            "match larger": "匹配更大的",
            "scale_method": "縮放方法",
            "nearest-exact": "鄰近-精確",
            "bilinear": "雙線性插值",
            "area": "區域",
            "bislerp": "雙球面線性",
            "bicubic": "雙三次插值",
