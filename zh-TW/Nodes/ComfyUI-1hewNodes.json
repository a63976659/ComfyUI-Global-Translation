{
    "1hew_ImageColorMatch": {
        "title": "影像色彩匹配",
        "inputs": {
            "source_image": "源影像",
            "reference_image": "參考影像"
        },
        "widgets": {
            "method": "方法"
        },
        "outputs": {
            "image": "影像"
        },
        "description": "將參考影像的色彩轉移到來源影像上。支援批次處理；當參考影像數量與來源批次不同時，會循環使用參考影像（i % ref_count）。wavelet/adain 原生執行；mkl/hm/reinhard/mvgd 及其混合版本使用 '顏色-matcher' 套件。"
    },
    "1hew_ImageColorRestore": {
        "title": "影像色彩還原",
        "inputs": {
            "edit_image": "編輯影像",
            "org_image": "原始影像"
        },
        "widgets": {
            "background_threshold": "背景閾值",
            "unchanged_threshold": "不變閾值",
            "seam_max_distance": "接縫最大距離",
            "seam_decay": "接縫衰減",
            "seam_residual_blur": "接縫殘差模糊",
            "seam_color_sigma": "接縫色彩標準差",
            "occlusion_residual_blur": "遮擋殘差模糊",
            "occlusion_bridge_width": "遮擋橋接寬度"
        },
        "outputs": {
            "image": "影像",
            "unchanged_mask": "不變遮罩"
        },
        "description": "在局部平滑物件移除所產生的遮擋接縫的同時，將對齊後的AI編輯色彩還原到原始參考。使用可靠的仿射色彩擬合與連續接縫場（結構不變遮罩清理已停用）。當編輯影像存在Alpha通道時會保留。"
    },
    "1hew_ImageAlignChangeMask": {
        "title": "影像對齊變更遮罩",
        "inputs": {
            "edit_image": "編輯影像",
            "org_image": "原始影像"
        },
        "widgets": {
            "mode": "模式",
            "max_offset": "最大偏移",
            "max_rotation": "最大旋轉",
            "max_scale": "最大縮放",
            "min_align_score": "最小對齊分數",
            "color_compensation": "色彩補償",
            "sensitivity": "靈敏度",
            "min_component_area": "最小元件面積",
            "expand": "擴展",
            "feather": "羽化"
        },
        "outputs": {
            "align_image": "對齊影像",
            "clean_mask": "乾淨遮罩",
            "raw_mask": "原始遮罩",
            "change_score": "變更分數",
            "overlay_image": "疊加影像"
        },
        "description": "將AI編輯後的影像與原始影像對齊，利用穩定的背景像素拒絕小範圍全域色彩漂移，並輸出原始／乾淨的變更遮罩。"
    },
    "1hew_ImageAlphaEdge": {
        "title": "影像Alpha邊緣處理",
        "inputs": {
            "image": "影像"
        },
        "widgets": {
            "edge": "邊緣",
            "feather": "羽化"
        },
        "outputs": {
            "image": "影像",
            "mask": "遮罩"
        },
        "description": "調整帶Alpha通道影像的不透明區域邊緣：向內縮邊 / 向外擴邊 + 羽化。\n\n典型場景：去背（移除背景）後元素邊緣仍殘留一圈被背景色污染的\n半透明「毛邊 / 彩邊」。本節點先用形態學向內縮邊，把被污染的\n邊緣像素直接裁除，再做高斯羽化得到乾淨的過渡；羽化前會固定把\n不透明區域的色彩向外擴散至過渡帶（bleed），避免羽化後出現暗邊 / 彩邊。\n\n處理順序：縮邊 / 擴邊 → 色彩外擴 → 羽化。\n輸出帶Alpha的4通道影像，並同時給出處理後的Alpha遮罩。\n\n縮邊 / 擴邊是灰度形態學（最小值 / 最大值 濾波），直接作用在Alpha上：\n對局部線性的軟邊，半徑為r的濾波恰好等於把該斜坡平移r像素，\n因此Alpha的每一條等值線都被整體平移r，matte自帶的抗鋸齒完整\n保留，不會退化成1px台階。填孔屬於遮罩修補，交給別的節點處理。"
    },
    "1hew_ImageBlur": {
        "title": "影像模糊",
        "inputs": {
            "image": "影像"
        },
        "widgets": {
            "blur": "模糊度"
        },
        "outputs": {
            "image": "影像"
        },
        "description": "對整張影像進行高斯模糊，行為與 LayerStyle 的 LayerFilter: Gaussian Blur V2 一致。\n\n- 模糊 參數支援小數（FLOAT），語意上更接近 V2 版本；\n- 當 模糊 為 0 時直接透傳原圖；\n- 依批次逐幀處理，保持通道數與 資料類型 不變。"
    },
