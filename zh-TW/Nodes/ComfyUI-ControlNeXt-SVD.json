            "include_face": "面部"
        },
        "outputs": {
            "poses_with_ref": "姿態與參考影像",
            "pose_images": "姿態影像"
        }
    },
    "ControlNextDiffusersScheduler": {
        "title": "ControlNeXt 擴散調度器",
        "widgets": {
            "scheduler": "調度器",
            "sigma_min": "sigma_min",
            "sigma_max": "sigma_max"
        },
        "outputs": {
            "scheduler": "調度器"
        }
    },
    "ControlNextSVDApply": {
        "title": "ControlNeXt 應用 SVD",
        "inputs": {
            "model": "模型",
            "pose_images": "姿態影像"
        },
        "widgets": {
            "strength": "強度",
            "blocks": "blocks",
            "input_block_patch_after_skip": "input_block_patch_after_skip"
