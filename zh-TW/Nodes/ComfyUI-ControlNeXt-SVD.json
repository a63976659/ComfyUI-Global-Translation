        "widgets": {
            "steps": "步數",
            "motion_bucket_id": "動態bucketID",
            "cfg_min": "最小CFG",
            "cfg_max": "最大CFG",
            "seed": "隨機種",
            "control_before_generate": "運行前操作",
            "fps": "幀率",
            "controlnext_cond_scale": "ControlNeXt條件係數",
            "noise_aug_strength": "雜訊增強",
            "context_size": "上下文長度",
            "context_overlap": "上下文重疊",
            "keep_model_loaded": "保持模型載入"
        },
        "outputs": {
            "samples": "Latent"
        }
