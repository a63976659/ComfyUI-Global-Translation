{
    "TeaCache": {
        "title": "茶快取",
        "inputs": {
            "model": "模型"
        },
        "widgets": {
            "model_type": "模型類型",
            "rel_l1_thresh": "相對L1閾值",
            "start_percent": "開始百分比",
            "end_percent": "結束百分比",
            "max_skip_steps": "最大跳過步數"
        },
        "outputs": {
            "model": "模型"
        },
        "description": "採用 茶 (TEA)時序編碼架構(Temporal Encoding Architecture)。\n 實現影片幀間特徵重用。\n名稱由來\n 時序編碼架構(Temporal Encoding Architecture)\n 像茶一樣 越陳越香 的特徵重用理念"
    },
    "CompileModel": {
        "title": "編譯模型",
        "inputs": {
            "model": "模型"
        },
        "widgets": {
            "mode": "模式",
            "backend": "後端",
            "fullgraph": "全圖",
            "dynamic": "動態"
        },
        "outputs": {
            "model": "模型"
        },
        "description": "效能優勢\n 減少30%-40%的重複計算\n 支援動態快取策略調整\n 自動處理影片場景切換"
    },
    "TeaCacheForCogVideoX": {
        "title": "CogVideoX專用茶快取",
        "inputs": {
            "model": "模型"
        },
        "widgets": {
            "enable_teacache": "啟用茶快取",
            "rel_l1_thresh": "相對L1閾值"
        },
        "outputs": {
            "cogvideomodel": "CogVideo模型"
        },
        "description": "為CogVideoX模型設計的特殊快取系統。"
    }
}