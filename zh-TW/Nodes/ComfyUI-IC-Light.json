{
    "LoadAndApplyICLightUnet": {
        "title": "載入ICLight模型",
        "inputs": {
            "model": "模型"
        },
        "widgets": {
            "model_path": "模型"
        },
        "outputs": {
            "MODEL": "模型"
        },
        "description": "讀取IC-Light模型的方法有點彆扭但確實有效。\nhttps://huggingface.co/lllyasviel/ic-light/tree/main  \n \n請與ICLight條件節點一起使用。"
    },
    "ICLightConditioning": {
        "title": "套用ICLight條件",
        "inputs": {
            "positive": "正面條件",
            "negative": "負面條件",
            "vae": "VAE",
            "foreground": "前景Latent",
            "opt_background": "背景Latent(可選)"
        },
        "widgets": {
            "multiplier": "乘數"
        },
        "outputs": {
            "positive": "正面條件",
            "negative": "負面條件",
            "empty_latent": "空Latent"
        },
        "description": "用於IC-Light模型的條件節點。若要使用「背景Latent」，需要將IC-Light模型切換到「fbc」版本。"
    },
    "LightSource": {
        "title": "簡易光源",
        "inputs": {
            "prev_image": "前 影像"
        },
        "widgets": {
            "light_position": "光源位置",
            "multiplier": "明度",
            "start_color": "起始色",
            "end_color": "結束色",
            "width": "寬度",
            "height": "高度",
            "batch_size": "批次大小"
        },
        "outputs": {
            "IMAGE": "影像"
        },
        "description": "產生可用於簡易光源的漸層灰階影像。可用RGB或HEX指定顏色。"
    },
    "CalculateNormalsFromImages": {
        "title": "計算法線",
        "inputs": {
            "images": "影像",
            "mask": "遮罩"
        },
        "widgets": {
            "sigma": "Sigma",
            "center_input_range": "輸入範圍 中心"
        },
        "outputs": {
            "divided": "分隔",
            "normal": "法線影像"
        },
        "description": "從不同角度的影像計算法線。\n需要包含4張影像的影像批次：左、右、下、上"
    },
    "LoadHDRImage": {
        "title": "載入HDR影像",
        "widgets": {
            "image": "影像",
            "exposure": "曝光",
            "exposures": "曝光"
        },
        "outputs": {
            "IMAGE": "影像",
            "MASK": "遮罩"
        },
        "description": "從input資料夾載入.hdr影像。\n輸出LDR影像批次。"
    },
    "BackgroundScaler": {
        "title": "背景灰度",
        "inputs": {
            "image": "影像",
            "mask": "遮罩"
        },
        "widgets": {
            "scale": "縮放",
            "invert": "反轉"
        },
        "outputs": {
            "IMAGE": "影像"
        },
        "description": "將遮罩區域調整為灰階影像"
    },
    "DetailTransfer": {
        "title": "細節遷移",
        "inputs": {
            "target": "目標影像",
            "source": "參考影像",
            "mask": "遮罩"
        },
        "widgets": {
            "mode": "模式",
            "blur_sigma": "模糊Sigma",
            "blend_factor": "混合係數"
        },
        "outputs": {
            "IMAGE": "影像"
        }
    }
}