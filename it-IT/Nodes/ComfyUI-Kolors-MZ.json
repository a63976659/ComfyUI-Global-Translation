{
    "MZ_ChatGLM3Loader": {
        "title": "Caricatore ChatGLM3",
        "widgets": {
            "chatglm3_checkpoint": "Modello ChatGLM3"
        },
        "outputs": {
            "chatglm3_model": "ChatGLM3"
        }
    },
    "MZ_ChatGLM3_V2": {
        "title": "Codifica ChatGLM3_V2",
        "inputs": {
            "chatglm3_model": "ChatGLM3"
        },
        "widgets": {
            "text": "Testo"
        },
        "outputs": {
            "CONDITIONING": "Condizione"
        }
    },
    "MZ_ChatGLM3_Advance_V2": {
        "title": "Codifica ChatGLM3_V2 avanzata",
        "inputs": {
            "chatglm3_model": "ChatGLM3"
        },
        "widgets": {
            "text": "Testo",
            "width": "Larghezza",
            "height": "Altezza",
            "crop_w": "Larghezza ritaglio",
            "crop_h": "Altezza ritaglio",
            "target_width": "Larghezza target",
            "target_height": "Altezza target"
        },
        "outputs": {
            "CONDITIONING": "Condizione"
        }
    },
    "MZ_ChatGLM3Embeds2Conditioning": {
        "title": "Da gruppo di embedding ChatGLM3 a condizione",
        "inputs": {
            "kolors_embeds": "Gruppo di embedding Kolors"
        },
        "widgets": {
            "width": "Larghezza",
            "height": "Altezza",
            "crop_w": "Larghezza ritaglio",
            "crop_h": "Altezza ritaglio",
            "target_width": "Larghezza target",
            "target_height": "Altezza target"
        },
        "outputs": {
            "positive": "Condizione positiva",
            "negative": "Condizione negativa"
        }
    },
    "MZ_KolorsCheckpointLoaderSimple": {
        "title": "Caricatore modello Kolors (semplice)",
        "widgets": {
            "ckpt_name": "Nome modello"
        },
        "outputs": {
            "MODEL": "Modello",
            "VAE": "VAE"
        }
    },
    "MZ_KolorsControlNetLoader": {
        "title": "Caricatore KolorsControlNet",
        "widgets": {
            "control_net_name": "Nome ControlNet"
        },
        "outputs": {
            "ControlNet": "ControlNet"
        }
    },
    "MZ_KolorsUNETLoaderV2": {
        "title": "Caricatore KolorsUNET_V2",
        "widgets": {
            "unet_name": "Nome UNET"
        },
        "outputs": {
            "model": "Modello"
        }
    },
    "MZ_KolorsControlNetPatch": {
        "title": "Conversione KolorsControlNet",
        "inputs": {
            "control_net": "ControlNet",
            "model": "Modello"
        },
        "outputs": {
            "CONTROL_NET": "ControlNet"
        }
    },
    "MZ_ApplySDXLSamplingSettings": {
        "title": "Applica impostazioni di campionamento SDXL",
        "inputs": {
            "model": "Modello"
        },
        "outputs": {
            "MODEL": "Modello"
        }
    },
    "MZ_ApplyCUDAGenerator": {
        "title": "Applica generatore CUDA",
        "inputs": {
            "model": "Modello"
        },
        "outputs": {
            "MODEL": "Modello"
        }
    }
