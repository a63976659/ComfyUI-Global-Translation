    "VHS_SelectLatents": {
        "title": "Seleziona Latent (indice)",
        "inputs": {
            "latent": "Latent"
        },
        "widgets": {
            "indexes": "Indice",
            "err_if_missing": "Genera un errore se mancante",
            "err_if_empty": "Genera un errore se vuoto"
        },
        "outputs": {
            "LATENT": "Latent"
        },
        "description": "Seleziona gli elementi di input nell'ordine indicato con indici numerici separati da virgola\n\nSupporta indici negativi, intervalli in stile Python (senza l'indice finale) e passo dell'intervallo\n\nEsempi (con 16 elementi in input, indici da 0 a 15):\n\n• 0         → output [0]\n• -1        → output [15]\n• 0,1,13    → output [0,1,13]\n• 0:5,13    → output [0,1,2,3,4,13]\n• 0:-1      → output [0,1,2,...,14]\n• 0:5:-1    → output [4,3,2,1,0]\n• 0:5:2     → output [0,2,4]\n• ::-1      → output [15,14,...,0]"
    },
    "VHS_GetLatentCount": {
        "title": "Ottieni numero di Latent",
