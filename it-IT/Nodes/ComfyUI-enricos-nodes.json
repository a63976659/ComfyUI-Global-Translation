        "title": "Compositore 4",
        "inputs": {
            "config": "Configurazione"
        },
        "widgets": {
            "fabricData": "Dati della tela",
            "imageName": "Nome immagine",
            "seed": "Seme casuale"
        },
        "description": "Tela di composizione interattiva per posizionare, ridimensionare, ruotare e disporre più immagini, con anteprima in tempo reale e supporto per le maschere. Offre un editor visuale con pannello dei livelli, strumenti di allineamento e aggancio alla griglia."
    },
    "Compositor4MasksOutput": {
        "title": "Output delle maschere del Compositore 4",
