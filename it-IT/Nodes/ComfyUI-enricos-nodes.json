    "CompositorConfig3": {
        "title": "Configurazione del compositore 3",
        "inputs": {
            "image1": "Immagine 1",
            "mask1": "Maschera 1",
            "image2": "Immagine 2",
            "mask2": "Maschera 2",
            "image3": "Immagine 3",
            "mask3": "Maschera 3",
