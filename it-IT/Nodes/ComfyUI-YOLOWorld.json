{
    "YOLOWorld_ModelLoader": {
        "title": "Caricamento modello YOLO World",
        "inputs": {
            "text": "Testo"
        },
        "widgets": {
            "model_id": "Nome modello",
            "categories": "categorie"
        },
        "outputs": {
            "model": "Modello",
            "MODEL": "Modello"
        }
    },
    "YOLOWorld": {
        "title": "YOLO World",
        "inputs": {
            "model": "Modello",
            "images": "Immagine"
        },
        "widgets": {
            "confidence_threshold": "Soglia di confidenza",
            "nms_iou_threshold": "Soglia IoU della soppressione dei non massimi",
            "with_class_agnostic_nms": "Usa la soppressione dei non massimi indipendente dalla categoria",
            "seed": "Seme casuale"
        },
        "outputs": {
            "detections": "Rilevamento",
            "Detections": "Rilevamento"
        }
    },
    "YOLOWorld_Display": {
        "title": "Visualizzazione YOLO World",
        "inputs": {
            "images": "Immagine",
            "detections": "Rilevamento"
        },
        "widgets": {
            "with_confidence": "Con confidenza",
            "thickness": "spessore",
            "text_thickness": "Spessore del testo",
            "text_scale": "Scala del testo"
        },
        "outputs": {
            "images": "Immagine",
            "IMAGE": "Immagine"
        }
    }
}