{
    "OmostLLMLoaderNode": {
        "title": "بارکننده Omost",
        "widgets": {
            "llm_name": "نام مدل زبانی"
        },
        "outputs": {
            "OMOST_LLM": "Omost"
        }
    },
    "OmostLLMHTTPServerNode": {
        "title": "سرویس HTTP Omost",
        "widgets": {
            "address": "نشانی",
            "api_type": "نوع API"
        },
        "outputs": {
            "OMOST_LLM": "Omost"
        }
    },
    "OmostLLMChatNode": {
        "title": "گفت‌وگوی Omost",
        "inputs": {
            "llm": "Omost",
            "conversation": "رکورد گفت‌وگو"
        },
        "widgets": {
            "text": "متن",
            "max_new_token": "حداکثر توکن خروجی",
            "top_p": "طول مجموعه نامزد پویا",
            "temperature": "دما",
            "seed": "بذر",
            "control_before_generate": "عمل پیش از اجرا"
        },
        "outputs": {
            "OMOST_CONVERSATION": "رکورد گفت‌وگو",
            "OMOST_CANVAS_CONDITIONING": "شرط پس‌زمینه"
        }
    },
    "OmostGreedyBagsTextEmbeddingNode": {
        "title": "Omost Greedy Bags Text Embedding",
        "inputs": {
            "canvas_conds": "شرط پس‌زمینه",
            "clip": "CLIP"
        },
        "outputs": {
            "CONDITIONING": "شرط"
        }
    },
    "OmostLayoutCondNode": {
        "title": "منطقه شرطی Omost（منطقه）",
        "inputs": {
            "canvas_conds": "شرط پس‌زمینه",
            "clip": "CLIP",
            "positive": "شرط مثبت"
        },
        "widgets": {
            "global_strength": "شدت سراسری",
            "region_strength": "شدت ناحیه",
            "overlap_method": "روش همپوشانی"
        },
        "outputs": {
            "CONDITIONING": "شرط",
            "MASK": "ماسک"
        }
    },
    "OmostDenseDiffusionLayoutNode": {
        "title": "ناحیه شرطی Omost (DenseDiffusion)",
        "inputs": {
            "model": "مدل",
            "canvas_conds": "شرط پس‌زمینه",
            "clip": "CLIP"
        },
        "outputs": {
            "MODEL": "مدل",
            "CONDITIONING": "شرط"
        }
    },
    "OmostLoadCanvasConditioningNode": {
        "title": "بارگذاری شرایط زمینه Omost",
        "widgets": {
            "json_str": "رشته json"
        },
        "outputs": {
            "OMOST_CANVAS_CONDITIONING": "شرط پس‌زمینه"
        }
    },
    "OmostLoadCanvasPythonCodeNode": {
        "title": "بارگذاری کد Python پس‌زمینه Omost",
        "widgets": {
            "python_str": "رشته Python"
        },
        "outputs": {
            "OMOST_CANVAS_CONDITIONING": "شرط پس‌زمینه"
        }
    },
    "OmostRenderCanvasConditioningNode": {
        "title": "شرط پس‌زمینه رندر Omost",
        "inputs": {
            "canvas_conds": "شرط پس‌زمینه"
        },
        "outputs": {
            "IMAGE": "تصویر",
            "MASK": "ماسک"
        }
    }
}