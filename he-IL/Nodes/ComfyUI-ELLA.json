        }
    },
    "EllaCombineEmbeds": {
        "title": "מיזוג קבוצות הטבעות של ELLA",
        "inputs": {
            "embeds": "קבוצת הטמעות",
            "embeds_add": "קבוצת הטבעות_הוספה"
        },
        "outputs": {
            "ELLA_EMBEDS": "קבוצת הטבעות ELLA"
        }
    },
    "ConditionToEllaEmbeds": {
        "title": "תנאי לקבוצת הטבעות של ELLA",
        "inputs": {
            "cond": "תנאי"
        },
        "outputs": {
            "ELLA_EMBEDS": "קבוצת הטבעות ELLA"
        }
    },
    "ConcatConditionEllaEmbeds": {
        "title": "צימוד תנאי לקבוצת הטבעות של ELLA",
        "inputs": {
            "cond": "תנאי",
            "embeds": "קבוצת הטמעות"
        },
        "outputs": {
            "ELLA_EMBEDS": "קבוצת הטבעות ELLA"
        }
    },
    "CombineClipEllaEmbeds": {
        "title": "מיזוג קבוצות הטבעות של CLIP ו-ELLA",
        "inputs": {
            "cond": "תנאי",
            "embeds": "קבוצת הטמעות"
        },
        "outputs": {
            "ELLA_EMBEDS": "קבוצת הטבעות ELLA"
        }
    },
    "SetEllaTimesteps": {
        "title": "הגדרת מרווח ELLA",
        "inputs": {
            "model": "מודל",
            "ella": "ELLA",
            "sigmas": "Sigmas"
        },
        "widgets": {
            "scheduler": "מתזמן",
            "steps": "מספר צעדים",
            "denoise": "הסרת רעש"
        },
        "outputs": {
            "ELLA": "ELLA"
        }
    },
    "EllaEncode": {
        "title": "קידוד ELLA",
        "inputs": {
            "ella": "ELLA",
            "embeds": "קבוצת הטמעות"
        },
        "outputs": {
            "CONDITIONING": "תנאי"
        }
    },
    "EllaTextEncode": {
        "title": "קידוד טקסט של ELLA",
        "inputs": {
            "ella": "ELLA",
            "text_encoder": "מקודד טקסט",
