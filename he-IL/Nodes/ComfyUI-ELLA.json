{
    "EllaApply": {
        "title": "יישום ELLA",
        "inputs": {
            "model": "מודל",
            "ella": "ELLA",
            "positive": "קבוצת הטבעות ELLA חיובית",
            "negative": "קבוצת הטבעות ELLA שלילית"
        },
        "outputs": {
            "model": "מודל",
            "positive": "תנאי חיובי",
            "negative": "תנאי שלילי"
        }
    },
    "T5TextEncode #ELLA": {
        "title": "קידוד טקסט T5",
        "inputs": {
            "text_encoder": "מקודד טקסט"
        },
        "widgets": {
            "text": "טקסט"
        },
        "outputs": {
            "ELLA_EMBEDS": "קבוצת הטבעות ELLA"
        }
    },
    "ELLALoader": {
        "title": "טוען ELLA",
        "widgets": {
            "name": "שם"
        },
        "outputs": {
            "ELLA": "ELLA"
        }
    },
    "T5TextEncoderLoader #ELLA": {
