{
    "LoadAndApplyICLightUnet": {
        "title": "טעינת מודל ICLight",
        "inputs": {
            "model": "מודל"
        },
        "widgets": {
            "model_path": "מודל"
        },
        "outputs": {
            "MODEL": "מודל"
        },
        "description": "דרך מעט מסורבלת אך יעילה לטעינת מודלי IC-Light.\nhttps://huggingface.co/lllyasviel/ic-light/tree/main  \n \nלשימוש יחד עם צומת התנאי של ICLight."
    },
    "ICLightConditioning": {
        "title": "החלת תנאי ICLight",
        "inputs": {
            "positive": "תנאי חיובי",
            "negative": "תנאי שלילי",
            "vae": "VAE",
            "foreground": "Latent של חזית",
            "opt_background": "Latent רקע (אופציונלי)"
        },
        "widgets": {
            "multiplier": "מכפיל"
        },
        "outputs": {
            "positive": "תנאי חיובי",
            "negative": "תנאי שלילי",
            "empty_latent": "Latent ריק"
        },
        "description": "צומת תנאי למודלי IC-Light. אם ברצונך להשתמש ב-Latent של רקע, יש להחליף את מודל ה-IC-Light לגרסת fbc."
    },
    "LightSource": {
        "title": "מקור אור פשוט",
        "inputs": {
            "prev_image": "תמונה קודמת"
        },
        "widgets": {
            "light_position": "מיקום מקור האור",
            "multiplier": "חומרה",
            "start_color": "צבע התחלתי",
            "end_color": "צבע סופי",
            "width": "רוחב",
            "height": "גובה",
            "batch_size": "גודל אצווה"
        },
        "outputs": {
            "IMAGE": "תמונה"
        },
        "description": "יצירת תמונת גווני אפור הדרגתית שניתן להשתמש בה כמקור אור פשוט. ניתן לציין צבע ב-RGB או ב-HEX."
    },
    "CalculateNormalsFromImages": {
        "title": "חישוב נורמלים",
        "inputs": {
            "images": "תמונה",
            "mask": "מסיכה"
        },
        "widgets": {
            "sigma": "Sigma",
            "center_input_range": "מרכז טווח הקלט"
        },
        "outputs": {
            "divided": "מפריד",
            "normal": "תמונת נורמלים"
        },
        "description": "חישוב נורמלים מתמונות מזוויות שונות.\nנדרשת אצוות של 4 תמונות: שמאל, ימין, למטה, למעלה"
    },
    "LoadHDRImage": {
        "title": "טעינת תמונת HDR",
        "widgets": {
            "image": "תמונה",
            "exposure": "חשיפה",
            "exposures": "חשיפה"
        },
        "outputs": {
            "IMAGE": "תמונה",
            "MASK": "מסיכה"
        },
        "description": "טעינת תמונות ‎.hdr מתיקיית input.\nפלט: אצוות תמונות LDR."
    },
    "BackgroundScaler": {
        "title": "גווני אפור של הרקע",
        "inputs": {
            "image": "תמונה",
            "mask": "מסיכה"
        },
        "widgets": {
            "scale": "קנה מידה",
            "invert": "היפוך"
        },
        "outputs": {
            "IMAGE": "תמונה"
        },
        "description": "התאמת אזורי המסיכה לתמונת גווני אפור"
    },
    "DetailTransfer": {
        "title": "העברת פרטים",
        "inputs": {
            "target": "תמונת יעד",
            "source": "תמונת ייחוס",
            "mask": "מסיכה"
        },
        "widgets": {
            "mode": "מצב",
            "blur_sigma": "טשטוש Sigma",
            "blend_factor": "מקדם ערבוב"
