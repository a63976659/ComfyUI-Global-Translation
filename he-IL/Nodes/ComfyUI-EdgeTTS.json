{
    "Save_Audio": {
        "title": "שמירת שמע 🔊",
        "inputs": {
            "audio": "כניסת אודיו"
        },
        "widgets": {
            "filepath": "נתיב קובץ",
            "format": "פורמט אודיו",
            "quality": "רמת איכות צליל (0-100)",
            "overwrite": "החלפת קבצים קיימים",
            "base_path": "נתיב אחסון בסיסי",
            "filename": "שם קובץ מותאם אישית"
        },
        "outputs": {
            "filepath": "נתיב קובץ",
            "audio": "פלט שמע"
        }
    },
    "EdgeTTS": {
        "title": "סינתזה של Edge TTS 🔊",
        "inputs": {
            "text": "טקסט קלט"
        },
        "widgets": {
            "voice": "קריין",
            "speed": "קצב דיבור (+/-50%)",
            "pitch": "גובה צליל (+/-50%)"
        },
        "outputs": {
            "AUDIO": "שמע מסונתז"
        }
    },
    "WhisperSTT": {
        "title": "זיהוי דיבור של Whisper 👂",
        "inputs": {
            "audio": "כניסת אודיו"
        },
        "widgets": {
            "model_size": "גודל המודל",
            "language": "שפה לזיהוי"
        },
        "outputs": {
            "STRING": "טקסט מזוהה"
        }
    }
}