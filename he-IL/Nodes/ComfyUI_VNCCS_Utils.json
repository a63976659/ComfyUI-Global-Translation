            "dilation": "מקדם הרחבה",
            "drop_size": "גודל סינון מינימלי"
        },
        "outputs": {
            "images": "תמונות"
        },
        "description": "מחלץ מהתמונה את האזורים שזוהו על ידי גלאי תיבות הגבול"
    },
    "LoadSAM3DBodyModel": {
        "title": "טוען מודל גוף תלת-ממדי של SAM",
        "inputs": {
            "device_mode": "מצב ההתקן"
        },
        "outputs": {
            "model": "מודל"
        },
        "description": "הגדרת פרמטרים של מודל גוף תלת-ממדי של SAM.\n\nקובצי המודל מאוחסנים בספרייה הקבועה `<ComfyUI>/models/sam3dbody/`;\nמשקלים חסרים יורדו אוטומטית מ-HuggingFace בפעם הראשונה שמשתמשים בצומת.\nהמודל בפועל נטען בעצלנות בתהליך עבודה נפרד בזמן ההסקה."
    },
    "SAM3DBodyProcessToJson": {
        "title": "המרת גוף תלת-ממדי של SAM ל-JSON של תנוחה",
        "inputs": {
            "model": "מודל",
            "image": "תמונה",
            "mask": "מסיכה",
            "Left_hand_image": "תמונת יד שמאל",
            "Right_hand_image": "תמונת יד ימין"
        },
        "widgets": {
            "bbox_threshold": "סף תיבת הגבול",
            "inference_type": "סוג ההסקה",
            "debug_scale": "יחס הגדלה לניפוי שגיאות"
        },
        "outputs": {
            "pose_json": "JSON של תנוחה"
        },
        "description": "מריץ מודל גוף תלת-ממדי של SAM על התמונה ופולט את התנוחה שחושבה בפורמט JSON (לצריכה על ידי הצומת «רינדור גוף מ-JSON של תנוחה»).\nהרשת, השלד וההדמיות הביניים שנוצרים בפנים נזרקים; רק פרמטרי התנוחה מועברים לצמתים במורד הזרם."
    },
    "SAM3DBodySettingBodyPresetJson": {
        "title": "מייצר JSON של הגדרת גוף מראש (SAM 3D)",
        "outputs": {
            "body_preset_json": "JSON של הגדרת הגוף מראש"
        },
        "description": "עורך של הגדרת גוף מראש, שפולט רק מחרוזת JSON של ההגדרה.\n\nפוצל מהצומת הישן «SAM3DBodyRenderFromJson», ולכן מצב פרמטרי מימדי הגוף, השלד ועיוותי המיזוג נערך פעם אחת וניתן לשימוש חוזר בכמה משימות רינדור (אפשר גם להעביר אותו לצמתים אחרים, כמו צומת הייצוא או קלט ה-JSON של הגדרת הגוף שבעורך התנוחות). בשילוב הצומת «SAM3DBodyRenderFromPoseAndBodyPresetJson» אפשר לרנדר פריים יחיד.\n\nמבנה ה-JSON הנפלט זהה לחלוטין ל- `body_preset_settings/*.json`, ולכן אפשר להחליף איתו ישירות את ההגדרות השמורות, או לייבא אותו ישירות לעורך הנפרד של הגדרת הגוף."
    },
    "SAM3DBodyRenderFromPoseAndBodyPresetJson": {
        "title": "רינדור גוף מ-JSON של תנוחה והגדרה מראש (SAM 3D)",
        "inputs": {
            "model": "מודל",
            "background_image": "תמונת הרקע"
        },
        "widgets": {
            "pose_json": "JSON של תנוחה",
            "body_preset_json": "JSON של הגדרת הגוף מראש",
            "offset_x": "היסט ציר X",
            "offset_y": "היסט ציר Y",
            "scale_offset": "היסט קנה המידה",
            "camera_yaw_deg": "זווית יעף המצלמה (מעלות)",
            "camera_pitch_deg": "זווית הגבהה של המצלמה (מעלות)",
            "width": "רוחב",
            "height": "גובה",
            "pose_adjust": "כוונון התנוחה",
            "debug_scale": "יחס הגדלה לניפוי שגיאות"
        },
        "outputs": {
            "image": "תמונה"
        },
        "description": "מרנדר את הגוף עם התנוחה שלו לתמונה. נתוני התנוחה מגיעים מ- `JSON של תנוחה` (צומת המרת תמונה ל-JSON של תנוחה או מעורך התנוחות), ונתוני מימדי הגוף מגיעים מ- `JSON של הגדרת הגוף מראש` (צומת יצירת ההגדרה מראש או עורך ההגדרה מראש של הגוף).\n\nשאר הפקדים הם פרמטרי שליטה לפריים יחיד בלבד: היסט המצלמה, סיבוב מסלול, קומפוזיציה ועוצמת תיקון ההטיה - אף אחד מהם לא נכתב אל ה-JSON של הגדרת הגוף מראש."
    }
}