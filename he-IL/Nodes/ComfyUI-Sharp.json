{
    "SharpImageAttrsToPLY": {
        "title": "המרת מאפייני תמונה חדה ל־PLY",
        "inputs": {
            "gaussian_attrs": "מאפיינים גאוסיים",
            "extrinsics": "פרמטרים חיצוניים",
            "intrinsics": "פרמטרים פנימיים"
        },
        "widgets": {
            "output_prefix": "קידומת פלט",
            "focal_length_px": "מרחק מוקד בפיקסלים"
        },
        "outputs": {
            "ply_path": "נתיב קובץ PLY",
            "extrinsics": "פרמטרים חיצוניים",
            "intrinsics": "פרמטרים פנימיים"
        },
        "description": "ניטול 14 ערוצי MULTIBAND_IMAGE לכל פיקסל (למשל פלט מאפייני הגאוסיאנים של שכבה 1 מ־SharpPredictGaussianAttrs) ו הפרמטרים החיצוניים/הפנימיים התואמים של המצלמה, ומייצר קובץ PLY של ענן נקודות גאוסיאני תלת־ממדי. הרב-פסים מאחסים מיקומי NDC; צומת זה ממיר אותם למרחב העולם לפני השמירה באמצעות unproject_gaussians של SHARP."
    },
    "SharpPanoramaCubeSplit": {
        "title": "פיצול קובייה פנורמית של Sharp",
        "widgets": {
            "panorama": "תמונה פנורמית",
            "image_w": "רוחב תמונה",
            "image_h": "גובה תמונה",
            "fov_x_deg": "זווית שדה ראייה בציר X",
            "fov_y_deg": "זווית שדה ראייה בציר Y",
            "rot_deg": "זווית סיבוב",
            "pitch_up": "זווית הטיה מעלה",
            "pitch_down": "זווית הטיה מטה"
        },
        "outputs": {
            "face_images": "תמונות פאות",
            "extrinsics": "פרמטרים חיצוניים",
            "intrinsics": "פרמטרים פנימיים",
            "fov_x_deg": "זווית שדה ראייה בציר X",
            "num_faces": "מספר פאות"
        },
        "description": "מבצע N חיתוכי פרספקטיבה מדגימת רשת עם זוויות הטיה וסיבוב קבועות מתמונה פנורמית כדורית ביחס 2:1 (ברירת מחדל: 3 הטיות x 3 סיבובים = 27 תצפיות). תואם את הגיאומטריה של WorldStereoPanoramaCubeSplit — משמש כשלב קלט למודל העומד של כל פאה, ותוצאותיו ניתן לחבר חזרה באמצעות SharpDepthMerge.\n\nבניגוד ל־SamplePanorama של Sharp (שגוזר את הרשת לפי FOV וחפיפה ומוציא ריבועים), לצומת זה רשת זוויות הטיה קבועה ויחס רוחב-גובה מלבני (ברירת מחדל 832x480), והוא תואם את מוסכמת המצלמה והפרמטרים הפנימיים של pano_bank של WorldStereo."
    },
    "SharpPredictForeground": {
        "title": "חיזוי קדמה של Sharp",
        "inputs": {
            "model": "מודל",
            "image": "תמונה",
            "extrinsics": "פרמטרים חיצוניים",
