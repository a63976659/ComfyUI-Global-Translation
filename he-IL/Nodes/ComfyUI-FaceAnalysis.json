{
    "FaceAnalysisModels": {
        "title": "מודל ניתוח פנים",
        "widgets": {
            "library": "ספרייה",
            "provider": "התקן"
        },
        "outputs": {
            "ANALYSIS_MODELS": "מודל ניתוח פנים"
        }
    },
    "FaceEmbedDistance": {
        "title": "הפרש דמיון בין פנים",
        "inputs": {
            "analysis_models": "מודל ניתוח פנים",
            "reference": "תמונת ייחוס",
            "image": "תמונה"
        },
        "widgets": {
            "filter_thresh_eucl": "סף Euclidean",
            "filter_thresh_cos": "סף Consine",
            "similarity_metric": "אלגוריתם דמיון",
            "filter_thresh": "סף סינון",
            "filter_best": "סינון התאמה מושלמת",
            "generate_image_overlay": "יצירת כיסוי תמונה"
        },
        "outputs": {
            "IMAGE": "תמונה",
            "euclidean": "Euclidean",
            "cosine": "Cosine",
            "distance": "מרחק"
        }
    },
    "FaceBoundingBox": {
        "title": "BBox של פנים",
        "inputs": {
            "analysis_models": "מודל ניתוח פנים",
            "image": "תמונה"
        },
        "widgets": {
            "padding": "ריפוד",
            "padding_percent": "אחוז חלוקה לאזורים",
            "index": "אינדקס"
        },
        "outputs": {
            "IMAGE": "תמונה",
            "x": "X",
            "y": "Y",
            "width": "רוחב",
            "height": "גובה"
        }
    },
    "FaceAlign": {
        "title": "יישור פנים",
        "inputs": {
            "analysis_models": "מודל ניתוח פנים",
            "image_from": "מהתמונה",
            "image_to": "אל התמונה"
        },
        "outputs": {
            "IMAGE": "תמונה"
        }
    },
    "FaceSegmentation": {
        "title": "סגמנטציה של פנים",
        "inputs": {
            "analysis_models": "מודל ניתוח פנים",
            "image": "תמונה"
        },
        "widgets": {
            "area": "אזור",
            "grow": "הרחבה",
            "grow_tapered": "הרחבה מחודדת",
            "blur": "טשטוש"
        },
        "outputs": {
            "mask": "מסיכה",
            "image": "תמונה",
            "seg_mask": "מסיכת סגמנטציה",
            "seg_image": "פיצול תמונה",
            "x": "x",
            "y": "y",
            "width": "רוחב",
            "height": "גובה"
        }
    },
    "FaceWarp": {
        "title": "החלפת פנים",
        "inputs": {
            "analysis_models": "מודל ניתוח פנים",
            "image_from": "מהתמונה",
            "image_to": "אל התמונה"
        },
        "widgets": {
            "keypoints": "נקודות מפתח",
            "grow": "הרחבה",
            "blur": "טשטוש"
        },
        "outputs": {
            "IMAGE": "תמונה",
            "MASK": "מסיכה"
        }
