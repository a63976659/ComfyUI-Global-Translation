{
    "YOLOWorld_ModelLoader": {
        "title": "YOLO 월드 모델 로드",
        "inputs": {
            "text": "텍스트"
        },
        "widgets": {
            "model_id": "모델 이름",
            "categories": "카테고리"
        },
        "outputs": {
            "model": "모델",
            "MODEL": "모델"
        }
    },
    "YOLOWorld": {
        "title": "YOLO 월드",
        "inputs": {
            "model": "모델",
            "images": "이미지"
        },
        "widgets": {
            "confidence_threshold": "신뢰도 임계값",
            "nms_iou_threshold": "비극대값 억제 IoU 임계값",
            "with_class_agnostic_nms": "클래스 무관 비극대값 억제 사용",
            "seed": "랜덤 시드"
        },
        "outputs": {
            "detections": "감지",
            "Detections": "감지"
        }
    },
    "YOLOWorld_Display": {
        "title": "YOLO 월드 표시",
        "inputs": {
            "images": "이미지",
            "detections": "감지"
        },
        "widgets": {
            "with_confidence": "확신 있음",
            "thickness": "두께",
            "text_thickness": "텍스트 두께",
            "text_scale": "텍스트 규모"
        },
        "outputs": {
            "images": "이미지",
            "IMAGE": "이미지"
        }
    }
}