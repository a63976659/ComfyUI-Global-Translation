{
    "BFSAmvGuideBuilder": {
        "title": "BFS AMV 가이던스 생성기",
        "inputs": {
            "video": "비디오",
            "images": "이미지",
            "audio": "오디오"
        },
        "widgets": {
            "mode": "모드",
            "length": "길이",
            "hold": "유지",
            "fill": "채우기",
            "placement": "배치",
            "fps": "프레임 레이트",
            "indices": "인덱스",
            "scene_threshold": "장면 임계값"
        },
        "outputs": {
            "guide": "가이던스",
            "debug": "디버그"
        },
        "description": "AMV 가이드(키프레임+빈 프레임)를 생성합니다. external_images를 사용하면 이미지를 음악 비트에 자동 배치할 수 있습니다(placement를 audio_beats로 설정). `가이드`를 VAE 또는 참조 모듈에 입력하세요."
    },
    "BFSAnime2RealBerniniConditioning": {
        "title": "BFS Bernini 애니메이션→사실적 컨디셔닝 생성",
        "inputs": {
            "positive": "긍정",
            "negative": "부정",
            "vae": "VAE",
            "guide_video": "가이드 비디오"
        },
        "widgets": {
            "length": "길이"
        },
        "outputs": {
            "positive": "긍정",
            "negative": "부정",
            "latent": "Latent",
            "debug": "디버그"
        },
        "description": "Bernini-R 애니메이션→사실적 변환 LoRA를 위한 순수 비디오-투-비디오(v2v) 애니메이션→사실적 컨디셔닝 생성입니다. guide_video는 source_id 1(애니메이션 캔버스)에 대응하고 | 출력은 source_id 0(사실적 사진)에 대응합니다. 참조 모듈은 없습니다. 가이드를 긍정과 부정 모두에 적용하므로 CFG는 참조가 아니라 텍스트 프롬프트(사실적 사진 스타일)만 증폭합니다. 적당한 CFG를 사용하세요; 가이드는 모션/레이아웃을 보존합니다. 이 LoRA를 얼굴 교체 노드와 함께 사용하지 마세요: 얼굴 교체가 source_id 2 토큰을 주입하는데, 애니메이션→사실적 변환 LoRA는 학습에서 해당 토큰을 한 번도 본 적이 없습니다."
    },
