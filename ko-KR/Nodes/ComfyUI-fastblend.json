        "inputs": {
            "masks": "마스크"
        },
        "outputs": {
            "MASK": "마스크"
        }
    },
    "SaveImage": {
        "title": "이미지 저장",
        "inputs": {
            "images": "이미지"
        },
        "widgets": {
            "filename_prefix": "파일명 접두사",
            "output_path": "출력 경로",
