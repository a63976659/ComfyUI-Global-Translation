            "tracking_window_size": "추적 창 크기",
            "minimum_patch_size": "최소 패치 크기",
            "num_iter": "반복 횟수",
            "guide_weight": "유도 가중치"
        },
        "outputs": {
            "IMAGE": "이미지"
        },
        "description": "프레임별 렌더링/부드러운 비디오에서 모든 프레임 사용"
    }
}