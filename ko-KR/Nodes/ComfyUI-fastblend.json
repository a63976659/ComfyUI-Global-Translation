        },
        "outputs": {
            "IMAGE": "이미지"
        }
    },
    "MyOpenPoseNode": {
        "title": "OpenPose 자세 인식 노드",
        "inputs": {
            "DWPose": "DWPose 동적 자세",
            "OpenPose": "OpenPose 자세"
        },
        "widgets": {
            "hex_color": "16진수 색상",
            "image": "이미지",
            "reserved_colors": "보관 색상"
        },
        "outputs": {
            "IMAGE": "이미지"
        },
        "description": " DWPose 자세는 인물이 돌아설 때 뒷면을 인식하지 못하지만 인물 자세 면에서는 OpenPose 자세보다 정확하고, OpenPose 자세는 뒷면을 매우 잘 인식합니다. 이 노드는 두 가지의 장점을 결합한 것입니다"
    },
    "reBatchImage": {
        "title": "이미지 배치 재처리",
        "inputs": {
            "image": "이미지"
        },
        "widgets": {
            "batch_size": "배치 크기"
        },
        "outputs": {
            "IMAGE": "이미지"
        },
        "description": "빠른 블렌딩을 위해 특별히 설계되어 동시에 이미지를 렌더링합니다(720p, 24G 비디오 메모리, batch_size를 40까지 조정 가능). 속도가 약 40% 향상됩니다."
    },
    "SmoothVideo": {
        "title": "비디오 스무딩",
