    "LoadSAM3DBodyModel": {
        "title": "SAM 3D 인체 모델 불러오기",
        "inputs": {
            "device_mode": "장치 모드"
        },
        "outputs": {
            "model": "모델"
        },
        "description": "SAM 3D 인체 모델 파라미터를 설정합니다.\n\n모델 파일은 고정 디렉터리 `<ComfyUI>/models/sam3dbody/` 하위에 저장됩니다;\n첫 사용 시 없는 가중치는 HuggingFace에서 자동 다운로드됩니다.\n실제 모델은 추론 실행 시 독립 워커 프로세스에 지연 로드됩니다."
    },
    "SAM3DBodyProcessToJson": {
        "title": "SAM 3D 인체를 포즈 JSON으로 변환",
        "inputs": {
            "model": "모델",
            "image": "이미지",
            "mask": "마스크",
            "Left_hand_image": "왼손 이미지",
            "Right_hand_image": "오른손 이미지"
        },
        "widgets": {
            "bbox_threshold": "경계 상자 임계값",
            "inference_type": "추론 유형",
            "debug_scale": "디버그 확대배율"
        },
        "outputs": {
            "pose_json": "포즈 JSON"
        },
        "description": "이미지에서 SAM 3D 인체 모델을 실행하여 예측된 포즈를 JSON 형식으로 출력합니다(「포즈 JSON으로 인체 렌더링」 노드용).\n내부적으로 생성된 메시, 골격, 중간 시각화 결과는 버려지고 포즈 파라미터만 다운스트림 노드로 전달됩니다."
    },
    "SAM3DBodySettingBodyPresetJson": {
        "title": "SAM 3D 인체 프리셋 JSON 생성기",
        "outputs": {
            "body_preset_json": "인체 프리셋 JSON"
        },
        "description": "인체 프리셋 편집기로, 인체 프리셋 JSON 문자열만 출력합니다.\n\n구버전 「SAM3DBodyRenderFromJson」 노드에서 분리된 것으로, 체형/골격/블렌드 셰이프 파라미터 상태를 한 번 편집해 여러 렌더링 작업에 반복 사용할 수 있습니다(내보내기 노드, 포즈 편집기의 인체 프리셋 JSON 입력 등 다른 노드에서도 사용 가능). 「SAM3DBodyRenderFromPoseAndBodyPresetJson」 노드와 조합하면 단일 프레임을 렌더링할 수 있습니다.\n\n출력 JSON 구조는 `body_preset_settings/*.json`과 완전히 동일하므로 저장된 프리셋을 바로 대체할 수 있고 독립 인체 프리셋 편집기에 직접 가져와서 사용할 수도 있습니다."
    },
    "SAM3DBodyRenderFromPoseAndBodyPresetJson": {
        "title": "SAM 3D 인체를 포즈+프리셋 JSON으로 렌더링",
        "inputs": {
            "model": "모델",
            "background_image": "배경 이미지"
        },
        "widgets": {
            "pose_json": "포즈 JSON",
            "body_preset_json": "인체 프리셋 JSON",
            "offset_x": "X축 오프셋",
            "offset_y": "Y축 오프셋",
            "scale_offset": "스케일 오프셋",
            "camera_yaw_deg": "카메라 요회전각(도)",
            "camera_pitch_deg": "카메라 피치각(도)",
            "width": "너비",
            "height": "높이",
            "pose_adjust": "포즈 조정",
            "debug_scale": "디버그 확대배율"
        },
        "outputs": {
            "image": "이미지"
        },
        "description": "포즈가 적용된 인체를 이미지로 렌더링합니다. 포즈 데이터는 `포즈 JSON`(이미지-포즈 JSON 노드/포즈 편집기)에서, 체형 데이터는 `인체 프리셋 JSON`(인체 프리셋 JSON 생성 노드/인체 프리셋 편집기)에서 가져옵니다.\n\n나머지 위젯은 단일 프레임 제어 파라미터일 뿐입니다: 카메라 오프셋, 궤도 회전, 구도, 기울기 보정 강도이며 이 파라미터들은 인체 프리셋 JSON에 기록되지 않습니다."
    }
}