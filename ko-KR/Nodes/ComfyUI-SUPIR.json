    "SUPIR_first_stage": {
        "title": "SUPIR 1단계",
        "inputs": {
            "SUPIR_VAE": "SUPIR_VAE",
            "image": "이미지"
        },
        "widgets": {
            "use_tiled_vae": "타일링 VAE",
            "encoder_tile_size": "인코딩 타일 크기",
            "decoder_tile_size": "디코딩 타일 크기",
