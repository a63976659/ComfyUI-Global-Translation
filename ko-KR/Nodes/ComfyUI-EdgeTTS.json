{
    "Save_Audio": {
        "title": "오디오 저장 🔊",
        "inputs": {
            "audio": "오디오 입력"
        },
        "widgets": {
            "filepath": "파일 경로",
            "format": "오디오 형식",
            "quality": "음질 레벨 (0-100)",
            "overwrite": "기존 파일 덮어쓰기",
            "base_path": "기본 저장 경로",
            "filename": "사용자 정의 파일명"
        },
        "outputs": {
            "filepath": "파일 경로",
            "audio": "오디오 출력"
        }
    },
    "EdgeTTS": {
        "title": "Edge TTS 합성 🔊",
        "inputs": {
            "text": "입력 텍스트"
        },
        "widgets": {
            "voice": "보이스",
            "speed": "말속 (+/-50%)",
            "pitch": "피치 (+/-50%)"
        },
        "outputs": {
            "AUDIO": "오디오 합성"
        }
    },
    "WhisperSTT": {
        "title": "Whisper 음성 인식 👂",
        "inputs": {
            "audio": "오디오 입력"
        },
        "widgets": {
            "model_size": "모델 크기",
            "language": "인식 언어"
        },
        "outputs": {
            "STRING": "인식 텍스트"
        }
    }
}