{
    "SharpImageAttrsToPLY": {
        "title": "Sharp 이미지 속성을 PLY로 변환",
        "inputs": {
            "gaussian_attrs": "가우시언 속성",
            "extrinsics": "외부 파라미터",
            "intrinsics": "내부 파라미터"
        },
        "widgets": {
            "output_prefix": "출력 접두사",
            "focal_length_px": "초점 거리 픽셀"
        },
        "outputs": {
            "ply_path": "PLY 파일 경로",
            "extrinsics": "외부 파라미터",
            "intrinsics": "내부 파라미터"
        },
        "description": "픽셀당 14채널 MULTIBAND_IMAGE（예: SharpPredictGaussianAttrs의 첫 레이어 가우시안 속성 출력）+ 일치하는 카메라 외부 파라미터/내부 파라미터로 3D 가우시안 포인트 클라우드 PLY 파일을 생성합니다. 멀티밴드는 NDC 위치를 저장하며, 이 노드는 SHARP의 unproject_gaussians로 저장 전에 세계 좌표계로 변환합니다."
    },
    "SharpPanoramaCubeSplit": {
        "title": "Sharp 파노라마 큐브 분할",
        "widgets": {
            "panorama": "파노라마",
            "image_w": "이미지 너비",
            "image_h": "이미지 높이",
            "fov_x_deg": "X 시야각",
            "fov_y_deg": "Y 시야각",
            "rot_deg": "회전 각도",
            "pitch_up": "상방 피치 각도",
            "pitch_down": "하방 피치 각도"
        },
        "outputs": {
            "face_images": "면 이미지",
            "extrinsics": "외부 파라미터",
            "intrinsics": "내부 파라미터",
            "fov_x_deg": "X축 시야각",
            "num_faces": "면 수"
        },
        "description": "2:1 가로세로비의 구면 파노라마에서 고정 피치각/요우각 격자로 N개의 투시 크롭을 샘플링합니다（기본값 3피치 x 3요우 = 27개 시점）. WorldStereoPanoramaCubeSplit의 기하 구조와 일치하며——각 면 깊이 모델의 입력 단계로 쓰고, 출력은 SharpDepthMerge로 다시 이어 붙일 수 있습니다.\n\nFOV+중첩으로 격자를 유도하고 정사각형으로 출력하는 Sharp의 SamplePanorama（（와 달리, 이 노드는 고정 피치 격자와 직사각형 가로세로비（기본값 832x480）를 가지며 WorldStereo의 pano_bank가 사용하는 카메라/내부 파라미터 규칙을 따릅니다."
    },
    "SharpPredictForeground": {
        "title": "Sharp 전경 예측",
        "inputs": {
            "model": "모델",
            "image": "이미지",
            "extrinsics": "외부 파라미터",
            "intrinsics": "내부 파라미터"
        },
        "widgets": {
            "mode": "모드",
            "focal_length_mm": "초점 거리 mm",
            "output_prefix": "출력 접두사"
        },
        "outputs": {
            "ply_path": "PLY 파일 경로",
            "extrinsics": "외부 파라미터",
            "intrinsics": "내부 파라미터"
        },
        "description": "Sharp로 이미지에서 3D 가우시안 포인트 클라우드 PLY 파일을 생성하며, 보이는 표면의 가우시안만 유지하고 가려진 부분은 버립니다. SharpPredict 대비 이미지당 가우시안 포인트 클라우드 수가 절반으로 줄어듭니다. 배치 입력은 번호가 매겨진 PLY 파일 폴더를 만듭니다."
    },
    "SharpPredictGaussiansFromMetricDepth": {
        "title": "메트릭 깊이에서 가우시안 포인트 클라우드 예측",
        "inputs": {
            "model": "모델",
            "image": "이미지",
            "metric_depth_layer0": "미터법 깊이 레이어 0",
            "metric_depth_layer1": "미터법 깊이 레이어 1",
            "extrinsics": "외부 파라미터",
            "intrinsics": "내부 파라미터",
            "mask": "마스크"
        },
        "widgets": {
            "focal_length_mm": "초점 거리 mm",
            "output_prefix": "출력 접두사",
            "save_background_layer": "배경 레이어 저장",
            "snap_to_external_depth": "외부 깊이와 연결",
            "depth_convention": "깊이 규칙",
            "edge_crop": "가장자리 크롭"
        },
        "outputs": {
            "ply_path": "PLY 파일 경로",
            "ply_folder": "PLY 폴더 경로",
            "extrinsics": "외부 파라미터",
            "intrinsics": "내부 파라미터"
        },
        "description": "외부에서 제공한 메트릭 깊이를 정렬 대상으로 사용하여 Sharp의 가우시안 디코더를 실행합니다. 외부 깊이가 `init_모델` 가우시안 기저값의 일관된 기하 골격이 되어, 가우시안 포인트 클라우드가 여러 뷰에서 일관된 표면을 공유합니다——면별 이음매 문제가 해결됩니다.\n\nPLY 파일을 저장합니다（단일 이미지->하나의 .ply; 배치->NNN.ply N개 폴더）. MergeGaussians 파이프라인으로 하나의 PLY 파일로 조합합니다."
    },
    "SharpPredictGaussianAttrs": {
