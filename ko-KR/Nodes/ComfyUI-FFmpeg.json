    "MergingVideoByPlenty": {
        "title": "🔥 일괄 비디오 병합",
        "widgets": {
            "video_path": "비디오 경로",
            "output_path": "출력 경로"
        },
        "outputs": {
            "video_complete_path": "비디오 전체 경로",
            "string": "텍스트/문자열"
        },
        "description": " 코덱 형식·해상도·프레임 레이트가 동일한 여러 짧은 영상을 하나의 긴 영상으로 병합합니다.\n 해당 영상 경로에 있는 모든 영상의 코덱 형식·프레임 레이트·해상도가 같아야 합니다."
    },
    "MergingVideoByTwo": {
        "title": "🔥 비디오 병합",
        "widgets": {
            "video1_path": "비디오_1 경로",
            "video2_path": "비디오_2 경로",
            "device": "장치",
            "resolution_reference": "해상도 기준",
            "output_path": "출력 경로"
        },
        "outputs": {
            "video_complete_path": "비디오 전체 경로",
            "string": "텍스트/문자열"
        },
        "description": " 두 개의 영상을 병합합니다. 예를 들어 1시간짜리 영상 두 개를 2시간짜리 영상으로 합칩니다.\n 병합 후 영상 크기는 첫 번째 영상 또는 두 번째 영상을 기준으로 할 수 있습니다."
    },
    "MultiCuttingVideo": {
        "title": "🔥 비디오 다중 편집",
        "widgets": {
            "video_path": "비디오 경로",
            "output_path": "출력 경로",
            "segment_time": "클립 시간"
        },
        "outputs": {
            "video_complete_path": "비디오 전체 경로",
            "string": "텍스트/문자열"
        },
        "description": " 하나의 영상을 여러 개의 영상으로 분할합니다.\n 분할 단위 길이는 초이며, 키프레임 기준으로 자르기 때문에 시간을 너무 짧게 설정하면 안 됩니다. 모든 구간에 키프레임이 보장되지 않으므로 각 구간 길이는 동일하지 않을 수 있고, 다만 가장 가까운 값으로 맞춰집니다."
    },
    "PipVideo": {
        "title": "🔥 그림 속 그림 비디오",
        "widgets": {
            "video1_path": "비디오_1 경로",
