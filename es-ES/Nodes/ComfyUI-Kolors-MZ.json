{
    "MZ_ChatGLM3Loader": {
        "title": "Cargador de ChatGLM3",
        "widgets": {
            "chatglm3_checkpoint": "Modelo ChatGLM3"
        },
        "outputs": {
            "chatglm3_model": "ChatGLM3"
        }
    },
    "MZ_ChatGLM3_V2": {
        "title": "Codificación ChatGLM3_V2",
        "inputs": {
            "chatglm3_model": "ChatGLM3"
        },
        "widgets": {
            "text": "Texto"
        },
        "outputs": {
            "CONDITIONING": "Condición"
        }
    },
    "MZ_ChatGLM3_Advance_V2": {
        "title": "Codificación ChatGLM3_V2 avanzada",
        "inputs": {
            "chatglm3_model": "ChatGLM3"
        },
        "widgets": {
            "text": "Texto",
            "width": "Anchura",
            "height": "Altura",
            "crop_w": "Anchura de recorte",
            "crop_h": "Altura de recorte",
            "target_width": "Anchura objetivo",
            "target_height": "Altura objetivo"
        },
        "outputs": {
            "CONDITIONING": "Condición"
        }
    },
    "MZ_ChatGLM3Embeds2Conditioning": {
        "title": "Embeds de ChatGLM3 a condición",
        "inputs": {
            "kolors_embeds": "Embeds de Kolors"
        },
        "widgets": {
            "width": "Anchura",
            "height": "Altura",
            "crop_w": "Anchura de recorte",
            "crop_h": "Altura de recorte",
            "target_width": "Anchura objetivo",
            "target_height": "Altura objetivo"
        },
        "outputs": {
            "positive": "Condición positiva",
            "negative": "Condición negativa"
        }
    },
    "MZ_KolorsCheckpointLoaderSimple": {
        "title": "Cargador del modelo Kolors (sencillo)",
        "widgets": {
            "ckpt_name": "Nombre del modelo"
        },
        "outputs": {
            "MODEL": "Modelo",
            "VAE": "VAE"
        }
    },
    "MZ_KolorsControlNetLoader": {
        "title": "Cargador de KolorsControlNet",
        "widgets": {
            "control_net_name": "Nombre de ControlNet"
        },
        "outputs": {
            "ControlNet": "ControlNet"
        }
    },
    "MZ_KolorsUNETLoaderV2": {
        "title": "Cargador de KolorsUNET_V2",
        "widgets": {
            "unet_name": "Nombre del UNET"
        },
        "outputs": {
            "model": "Modelo"
        }
    },
    "MZ_KolorsControlNetPatch": {
        "title": "Conversión de KolorsControlNet",
        "inputs": {
            "control_net": "ControlNet",
            "model": "Modelo"
        },
        "outputs": {
            "CONTROL_NET": "ControlNet"
        }
    },
    "MZ_ApplySDXLSamplingSettings": {
        "title": "Aplicar ajustes de muestreo SDXL",
        "inputs": {
            "model": "Modelo"
        },
        "outputs": {
            "MODEL": "Modelo"
        }
    },
    "MZ_ApplyCUDAGenerator": {
        "title": "Aplicar generador CUDA",
        "inputs": {
            "model": "Modelo"
        },
        "outputs": {
            "MODEL": "Modelo"
        }
    }
}