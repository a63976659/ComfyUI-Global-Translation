            "match larger": "Coincidir con el más grande",
            "scale_method": "Método de escalado",
            "nearest-exact": "Vecino más próximo exacto",
            "bilinear": "Bilineal",
            "area": "Área",
            "bislerp": "Interpolación esférica lineal",
            "bicubic": "Bicúbica",
            "crop": "Recortar",
            "disabled": "Desactivado",
            "ceter": "Centro"
        },
        "outputs": {
            "LATENT": "Latent",
            "count": "Conteo"
        },
        "description": "Une dos grupos de latentes en un solo grupo de latentes \n\n"
    },
    "VHS_SelectEveryNthLatent": {
        "title": "Seleccionar latentes (intervalo)",
        "inputs": {
            "latents": "Latent"
        },
        "widgets": {
            "select_every_nth": "Cada n fotogramas",
            "skip_first_latents": "Omitir los primeros X"
        },
        "outputs": {
