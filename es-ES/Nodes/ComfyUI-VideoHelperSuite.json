    "VHS_SelectLatents": {
        "title": "Seleccionar latentes (índice)",
        "inputs": {
            "latent": "Latent"
        },
        "widgets": {
            "indexes": "Índice",
            "err_if_missing": "Error si falta",
            "err_if_empty": "Error si está vacío"
        },
        "outputs": {
            "LATENT": "Latent"
        },
        "description": "Selecciona elementos de entrada por índice numérico separados por comas y en el orden dado\n\nAdmite índices negativos, rangos al estilo de Python (sin incluir el índice final) y pasos de rango\n\nEjemplos (suponiendo 16 elementos de entrada, índices 0-15):\n\n• 0         → salida [0]\n• -1        → salida [15]\n• 0,1,13    → salida [0,1,13]\n• 0:5,13    → salida [0,1,2,3,4,13]\n• 0:-1      → salida [0,1,2,...,14]\n• 0:5:-1    → salida [4,3,2,1,0]\n• 0:5:2     → salida [0,2,4]\n• ::-1      → salida [15,14,...,0]"
    },
    "VHS_GetLatentCount": {
        "title": "Obtener nº de latentes",
        "inputs": {
            "latents": "Latent"
        },
        "outputs": {
            "count": "Conteo"
        },
        "description": "Devuelve como entero el número de latentes de la entrada \n\n"
    },
