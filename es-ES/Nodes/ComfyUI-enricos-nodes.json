            "bbox width": "Anchura de la caja delimitadora",
            "bbox height": "Altura de la caja delimitadora"
        },
        "description": ""
    },
    "CompositorColorPicker": {
        "title": "Selector de color del compositor",
        "inputs": {
            "format": "Formato"
        },
        "widgets": {
            "red": "Rojo",
            "green": "Verde",
            "blue": "Azul"
        },
        "outputs": {
            "color_string": "Cadena de color",
            "color_16bit": "Valor de color de 16 bits",
            "color_24bit": "Valor de color de 24 bits",
            "color_preview": "Vista previa del color"
        },
        "description": "Este nodo convierte valores RGB (0-255) a varios formatos de color:\n- Cadena de color hexadecimal (#RRGGBB)\n- Valor de color de 16 bits (formato RGB565 o RGB555)\n- Valor de color de 24 bits (compatible con el nodo emptyImage de ComfyUI)\n- Imagen de vista previa del color"
    },
    "CompositorConfig3": {
        "title": "Configuración del compositor 3",
        "inputs": {
            "image1": "Imagen1",
            "mask1": "Máscara 1",
            "image2": "Imagen2",
            "mask2": "Máscara 2",
            "image3": "Imagen 3",
            "mask3": "Máscara 3",
            "image4": "Imagen4",
            "mask4": "Máscara 4",
            "image5": "Imagen5",
            "mask5": "Máscara 5",
            "image6": "Imagen6",
            "mask6": "Máscara6",
            "image7": "Imagen7",
            "mask7": "Máscara_7",
            "image8": "Imagen8",
            "mask8": "Máscara_8"
        },
        "widgets": {
            "width": "Anchura",
            "height": "Altura",
            "padding": "Relleno",
            "normalizeHeight": "Altura normalizada",
            "onConfigChanged": "Al cambiar la configuración",
            "invertMask": "Invertir máscara",
            "initialized": "Inicializar"
        },
        "outputs": {
            "config": "Configuración",
            "extendedConfig": "Configuración extendida"
        },
        "description": "\nNodo compositor\n- Pasa hasta 8 imágenes\n- Opcionalmente pasa sus máscaras (invertidas)\n- Las máscaras se aplican automáticamente y se pasan internamente como RGBA\n- Usa los controles de tamaño para configurar el compositor, que se ajustará en tiempo de ejecución\n- Activa la bandera de pausa para tener tiempo de construir tu composición (la pausa afecta al compositor, no al nodo de configuración)\n"
    },
