    "Compositor4": {
        "title": "Compositor 4",
        "inputs": {
            "config": "Configuración"
        },
        "widgets": {
            "fabricData": "Datos del lienzo",
            "imageName": "Nombre de la imagen",
            "seed": "Semilla"
        },
        "description": "Lienzo de composición interactivo para situar, escalar, rotar y distribuir varias imágenes, con vista previa en tiempo real y soporte de máscaras. Incluye un editor visual con panel de capas, herramientas de alineación y ajuste a la cuadrícula."
    },
    "Compositor4MasksOutput": {
        "title": "Salida de máscaras del Compositor 4",
        "inputs": {
            "layer_outputs": "Salidas de capas"
        },
        "outputs": {
            "image_1": "Imagen_1",
            "image_2": "Imagen_2",
            "image_3": "Imagen_3",
            "image_4": "Imagen_4",
            "image_5": "Imagen_5",
            "image_6": "Imagen_6",
            "image_7": "Imagen_7",
            "image_8": "Imagen_8",
            "mask_1": "Máscara 1",
            "mask_2": "Máscara 2",
            "mask_3": "Máscara 3",
            "mask_4": "Máscara 4",
            "mask_5": "Máscara 5",
            "mask_6": "Máscara6",
            "mask_7": "Máscara_7",
            "mask_8": "Máscara_8"
        },
        "description": "Este nodo descompone los COMPOSITOR_OUTPUT_MASKS de Compositor4 en salidas separadas de imagen y máscara.\nClarifica la interfaz del compositor separando las salidas de capas en nodos dedicados."
    },
    "Compositor4TransformsOut": {
        "title": "Salida de transformaciones del Compositor 4",
        "widgets": {
            "transforms": "Transformar",
            "channel": "Canal",
            "forceInt": "Forzar entero"
        },
        "outputs": {
            "x": "x",
            "y": "y",
