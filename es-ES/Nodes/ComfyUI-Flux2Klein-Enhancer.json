    "Flux2KleinEnhancer": {
        "title": "Potenciador Flux2Klein",
        "inputs": {
            "conditioning": "Acondicionamiento",
            "device": "Dispositivo de ejecución"
        },
        "widgets": {
            "active_scale": "Escala de la zona activa",
            "per_token_whiten": "Blanqueamiento por token",
            "norm_equalize": "Equilibrado de norma",
            "early_layer_scale": "Coeficiente de escala de capa superficial",
            "mid_layer_scale": "Coeficiente de escala de capa media",
            "late_layer_scale": "Coeficiente de escala de capa profunda",
            "preserve_original": "Conservar datos originales",
            "active_end_override": "Sobrescritura del punto final activo",
            "debug": "Modo de depuración"
        },
        "description": "Aplica operaciones de escalar puro y blanqueamiento a las zonas activas del acondicionamiento de Klein y, además, ofrece el escalado por capas de Qwen3 exclusivo de Klein."
    },
    "Flux2KleinDetailController": {
        "title": "Controlador de detalles Flux2Klein",
        "inputs": {
            "conditioning": "Acondicionamiento",
            "device": "Dispositivo de ejecución"
        },
        "widgets": {
            "front_mult": "Multiplicador de la parte inicial",
            "mid_mult": "Multiplicador de la parte media",
            "end_mult": "Multiplicador de la parte final",
            "emphasis_start": "Posición de inicio del énfasis",
            "emphasis_end": "Posición de fin del énfasis",
            "emphasis_mult": "Multiplicador de énfasis",
            "preserve_original": "Conservar datos originales",
            "debug": "Modo de depuración"
        },
        "description": "Regulador de multiplicadores de embeddings por secciones.\n\nModo real (recomendado): se usa junto con el codificador por secciones. El codificador genera rangos de tokens por sección como metadatos de acondicionamiento (`meta[\"klein_sections\"]`); este node ajusta el multiplicador de los embeddings activos dentro del rango correspondiente según los coeficientes definidos por el usuario.\n\nModo compatible (versión antigua, no recomendado): si no existen metadatos de secciones, el node divide automáticamente las zonas activas con las proporciones fijas 25%/50%/25%. Esos límites de división son arbitrarios —los tokens de Qwen3 no tienen una semántica posicional fija— y la versión 1 de este node prácticamente no tiene efecto real en este modo. Se conserva este modo por compatibilidad con flujos de trabajo antiguos; se recomienda pasar al codificador por secciones para obtener un escalado con conciencia de secciones realmente significativo."
    },
    "Flux2KleinMaskRefController": {
        "title": "Controlador de referencia con máscara Flux2Klein",
        "inputs": {
            "conditioning": "Acondicionamiento",
            "mask": "Máscara"
        },
        "widgets": {
            "strength": "Intensidad",
            "invert_mask": "Invertir máscara",
            "feather": "Desenfoque de máscara",
            "reference_index": "Índice de referencia",
            "debug": "Modo de depuración"
        },
        "description": "Aplica una atenuación espacial al Latent de referencia usando la máscara dibujada.\n\nMultiplica el Latent de referencia por los escalares por píxel generados por la máscara. El Latent de acondicionamiento se modifica directamente in situ (se reemplaza meta['reference_Latents'])."
    },
