{
    "FaceAnalysisModels": {
        "title": "Modelos de análisis facial",
        "widgets": {
            "library": "Biblioteca",
            "provider": "Dispositivo"
        },
        "outputs": {
            "ANALYSIS_MODELS": "Modelos de análisis facial"
        }
    },
    "FaceEmbedDistance": {
        "title": "Distancia de similitud facial",
        "inputs": {
            "analysis_models": "Modelos de análisis facial",
            "reference": "Imagen de referencia",
            "image": "Imagen"
        },
        "widgets": {
            "filter_thresh_eucl": "Umbral euclídeo",
            "filter_thresh_cos": "Umbral de Consine",
            "similarity_metric": "Algoritmo de similitud",
            "filter_thresh": "Umbral de filtrado",
            "filter_best": "Filtrar coincidencias perfectas",
            "generate_image_overlay": "Generar superposición de imagen"
        },
        "outputs": {
            "IMAGE": "Imagen",
            "euclidean": "Euclidean",
            "cosine": "Cosine",
            "distance": "Distancia"
        }
    },
    "FaceBoundingBox": {
        "title": "BBox facial",
        "inputs": {
            "analysis_models": "Modelos de análisis facial",
            "image": "Imagen"
        },
        "widgets": {
            "padding": "Con relleno",
            "padding_percent": "Porcentaje de margen",
            "index": "Índice"
        },
        "outputs": {
            "IMAGE": "Imagen",
            "x": "X",
            "y": "Y",
            "width": "Anchura",
            "height": "Altura"
        }
    },
    "FaceAlign": {
        "title": "Alineación facial",
        "inputs": {
            "analysis_models": "Modelos de análisis facial",
            "image_from": "De la imagen",
            "image_to": "A la imagen"
        },
        "outputs": {
            "IMAGE": "Imagen"
        }
    },
    "FaceSegmentation": {
        "title": "Segmentación facial",
        "inputs": {
            "analysis_models": "Modelos de análisis facial",
            "image": "Imagen"
        },
        "widgets": {
            "area": "Área",
            "grow": "Expandir",
            "grow_tapered": "Expansión con reducción",
            "blur": "Desenfoque"
        },
        "outputs": {
            "mask": "Máscara",
            "image": "Imagen",
            "seg_mask": "Máscara de segmentación",
            "seg_image": "División de imagen",
            "x": "x",
            "y": "y",
            "width": "Anchura",
            "height": "Altura"
        }
    },
    "FaceWarp": {
        "title": "Sustitución facial",
        "inputs": {
            "analysis_models": "Modelos de análisis facial",
            "image_from": "De la imagen",
            "image_to": "A la imagen"
        },
        "widgets": {
            "keypoints": "Puntos clave",
            "grow": "Expandir",
            "blur": "Desenfoque"
        },
        "outputs": {
            "IMAGE": "Imagen",
            "MASK": "Máscara"
        }
    }
}