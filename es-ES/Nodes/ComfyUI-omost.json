{
    "OmostLLMLoaderNode": {
        "title": "Cargador Omost",
        "widgets": {
            "llm_name": "Nombre del modelo de lenguaje"
        },
        "outputs": {
            "OMOST_LLM": "Omost"
        }
    },
    "OmostLLMHTTPServerNode": {
        "title": "Servicio HTTP Omost",
        "widgets": {
            "address": "Dirección",
            "api_type": "Tipo de API"
        },
        "outputs": {
            "OMOST_LLM": "Omost"
        }
    },
    "OmostLLMChatNode": {
        "title": "Conversación Omost",
        "inputs": {
            "llm": "Omost",
            "conversation": "Registro de conversación"
        },
        "widgets": {
            "text": "Texto",
            "max_new_token": "Token de salida máximo",
            "top_p": "Longitud dinámica del conjunto de candidatos",
            "temperature": "Temperatura",
            "seed": "Semilla",
            "control_before_generate": "Acción antes de ejecutar"
        },
        "outputs": {
            "OMOST_CONVERSATION": "Registro de conversación",
            "OMOST_CANVAS_CONDITIONING": "Condición de fondo"
        }
    },
    "OmostGreedyBagsTextEmbeddingNode": {
        "title": "Omost Greedy Bags Text Embedding",
        "inputs": {
            "canvas_conds": "Condición de fondo",
            "clip": "CLIP"
        },
        "outputs": {
            "CONDITIONING": "Condición"
        }
    },
    "OmostLayoutCondNode": {
        "title": "Omost Región de condicionamiento（zona）",
        "inputs": {
            "canvas_conds": "Condición de fondo",
            "clip": "CLIP",
            "positive": "Condición positiva"
        },
        "widgets": {
            "global_strength": "Intensidad global",
            "region_strength": "Intensidad de región",
            "overlap_method": "Método de solapamiento"
        },
        "outputs": {
            "CONDITIONING": "Condición",
            "MASK": "Máscara"
        }
    },
    "OmostDenseDiffusionLayoutNode": {
        "title": "Región de condición Omost（DenseDiffusion）",
        "inputs": {
            "model": "Modelo",
            "canvas_conds": "Condición de fondo",
            "clip": "CLIP"
        },
        "outputs": {
            "MODEL": "Modelo",
            "CONDITIONING": "Condición"
        }
    },
    "OmostLoadCanvasConditioningNode": {
        "title": "Cargar condición de fondo Omost",
        "widgets": {
            "json_str": "Cadena JSON"
        },
        "outputs": {
            "OMOST_CANVAS_CONDITIONING": "Condición de fondo"
        }
    },
    "OmostLoadCanvasPythonCodeNode": {
        "title": "Cargar código Python de fondo Omost",
        "widgets": {
            "python_str": "Cadena Python"
        },
        "outputs": {
            "OMOST_CANVAS_CONDITIONING": "Condición de fondo"
        }
    },
    "OmostRenderCanvasConditioningNode": {
        "title": "Omost Condición de renderizado de fondo",
        "inputs": {
            "canvas_conds": "Condición de fondo"
        },
        "outputs": {
            "IMAGE": "Imagen",
            "MASK": "Máscara"
        }
    }
