{
    "CRMPreprocessForPoser": {
        "title": "Preprocesado CRM Poser",
        "inputs": {
            "reference_image": "Imagen",
            "reference_mask": "Máscara"
        },
        "widgets": {
            "foreground_ratio": "Ratio de primer plano"
        },
        "outputs": {
            "processed": "Imagen procesada"
        }
    },
    "CRMPoserConfig": {
        "title": "Configuración de CRM Poser",
        "inputs": {
            "processed_image": "Imagen procesada"
        },
        "widgets": {
            "seed": "Semilla",
            "control_before_generate": "Acción antes de ejecutar",
            "cfg": "CFG",
            "steps": "Pasos"
        },
        "outputs": {
            "CRM_POSE_CONFIG": "Configuración de Poser"
        }
    },
    "CRMPoseSampler": {
        "title": "Muestreador de CRM Poser",
        "inputs": {
            "config": "Configuración de Poser"
        },
        "widgets": {
            "pixel_model": "Modelo Pixel"
        },
        "outputs": {
            "IMAGE": "Imagen de pose"
        }
    },
    "CCMSampler": {
        "title": "Muestreador CCM",
        "inputs": {
            "config": "Configuración de Poser",
            "poses": "Imagen de pose"
        },
        "widgets": {
            "ccm_model": "Modelo CCM"
        },
        "outputs": {
            "IMAGE": "Imagen de coordenadas"
        }
    },
    "CRMModelLoader": {
        "title": "Cargador de modelos CRM",
        "widgets": {
            "crm_model": "Modelo CRM"
        },
        "outputs": {
            "CRM_MODEL": "Modelo CRM"
        }
    },
    "CRMModeler": {
        "title": "Generación del modelo CRM",
        "inputs": {
            "crm_model": "Modelo CRM",
            "poses": "Imagen de pose",
            "coordinates": "Imagen de coordenadas"
        },
        "outputs": {
            "MESH": "Malla"
        }
    },
    "CRMModelerCuda": {
        "title": "Generación del modelo CRM (solo CUDA)",
        "inputs": {
            "crm_model": "Modelo CRM",
            "poses": "Imagen de pose",
            "coordinates": "Imagen de coordenadas"
        },
        "outputs": {
            "MESH": "Malla"
        }
    },
    "CRMViewer": {
        "title": "Vista previa de malla CRM",
        "inputs": {
            "mesh": "Malla"
        }
    }
}