    "MergingVideoByPlenty": {
        "title": "🔥 Unir vídeos por lotes",
        "widgets": {
            "video_path": "Ruta del vídeo",
            "output_path": "Ruta de salida"
        },
        "outputs": {
            "video_complete_path": "Ruta completa del vídeo",
            "string": "Texto/cadena"
        },
        "description": " Sirve para unir varios vídeos cortos con el mismo formato de codificación, resolución y fotogramas por segundo en un vídeo largo.\n Requiere que todos los vídeos de la ruta tengan el mismo formato de codificación, fotogramas y resolución."
    },
    "MergingVideoByTwo": {
        "title": "🔥 Unir vídeos",
        "widgets": {
            "video1_path": "Ruta del vídeo_1",
            "video2_path": "Ruta del vídeo_2",
            "device": "Dispositivo",
            "resolution_reference": "Resolución de referencia",
            "output_path": "Ruta de salida"
        },
        "outputs": {
            "video_complete_path": "Ruta completa del vídeo",
            "string": "Texto/cadena"
        },
        "description": " Sirve para unir dos vídeos, por ejemplo dos vídeos de una hora en uno de dos horas.\n El tamaño del resultado puede tomarse del primer o del segundo vídeo."
    },
    "MultiCuttingVideo": {
        "title": "🔥 Cortar un vídeo varias veces",
        "widgets": {
            "video_path": "Ruta del vídeo",
            "output_path": "Ruta de salida",
            "segment_time": "Duración de cada segmento"
        },
        "outputs": {
            "video_complete_path": "Ruta completa del vídeo",
            "string": "Texto/cadena"
        },
        "description": " Sirve para dividir un vídeo en varios vídeos.\n Duración de cada parte en segundos. El corte se hace en fotogramas clave, así que la duración no debe ser demasiado corta; como no todas las partes garantizan tener fotogramas clave, la duración de cada vídeo resultante puede variar ligeramente y solo será la más aproximada."
    },
    "PipVideo": {
        "title": "🔥 Vídeo en picture-in-picture",
        "widgets": {
            "video1_path": "Ruta del vídeo_1",
            "video2_path": "Ruta del vídeo_2",
            "device": "Dispositivo",
            "use_audio": "Usar audio",
            "use_duration": "Usar duración",
            "align_type": "Tipo de alineación",
            "pip_fg_zoom": "Escalado del primer plano en picture-in-picture",
            "output_path": "Ruta de salida",
            "scale_and_crop": "Escalar y recortar",
            "fps": "Fotogramas por segundo",
            "is_chromakey": "Aplicar chroma key de pantalla verde"
        },
        "outputs": {
            "video_complete_path": "Ruta completa del vídeo",
            "width": "Anchura",
            "height": "Altura",
            "duration": "Duración",
            "fps": "Fotogramas por segundo"
        },
        "description": " Factor de escalado del fondo en picture-in-picture: cuanto mayor, más pequeño el primer plano; es el multiplicador de reducción de la anchura y altura del fondo.\n La frecuencia de fotogramas del resultado es 30,0 por defecto; con 0 o con 1 se usará la de video2."
    },
    "SingleCuttingVideo": {
