{
    "OnnxDetectionModelLoader": {
        "title": "ONNX-Erkennungs-Modell Lader",
        "widgets": {
            "vitpose_model": "ViTPose-Modell",
            "yolo_model": "YOLO-Modell",
            "onnx_device": "ONNX-Gerät"
        },
        "outputs": {
            "model": "Modell",
            "posemodel": "Posen-Modell"
        }
    },
    "PoseAndFaceDetection": {
        "title": "Posen- und Gesichts-Erkennung",
        "inputs": {
            "model": "Modell",
            "images": "Bildgruppe",
            "retarget_image": "Zielbild für Umleitung"
        },
        "widgets": {
            "width": "Breite",
            "height": "Höhe",
            "face_padding": "Gesichtspolsterung"
        },
        "outputs": {
            "pose_data": "Posedaten",
            "face_images": "Gesichtsbild",
            "key_frame_body_points": "Keyframe-Körperspunkte",
            "bboxes": "Begrenzungsrechteck",
            "face_bboxes": "Gesichts-Begrenzungsrahmen"
        }
    },
    "DrawViTPose": {
        "title": "ViTPose-Posen zeichnen",
        "inputs": {
            "pose_data": "Posedaten"
        },
        "widgets": {
            "width": "Breite",
            "height": "Höhe",
            "retarget_padding": "Retargeting-Padding",
            "body_stick_width": "Breite der Körpergelenk-Linien",
            "hand_stick_width": "Breite der Handgelenk-Linien",
            "draw_head": "Kopf zeichnen"
        },
        "outputs": {
            "pose_images": "Pose-Bilder"
        }
    },
    "PoseRetargetPromptHelper": {
        "title": "Posen-Umleitungs-Prompt-Assistent",
        "inputs": {
            "pose_data": "Posedaten"
        },
        "widgets": {
            "pose_data": "Posedaten"
        },
        "outputs": {
            "prompt": "Prompt (Eingabetext)",
            "retarget_prompt": "Umleitungs-Prompt"
        }
    },
    "PoseDetectionOneToAllAnimation": {
        "title": "Posen-Erkennung OneToAll-Animation",
        "inputs": {
            "model": "Modell",
            "images": "Bildsequenz",
            "ref_image": "Referenzbild"
        },
        "widgets": {
            "width": "Breite",
            "height": "Höhe",
            "align_to": "Ausrichten an",
            "draw_face_points": "Gesichtsschlüsselpunkte zeichnen",
            "draw_head": "Kopf zeichnen"
        },
        "outputs": {
            "pose_images": "Pose-Bilder",
            "ref_pose_image": "Referenzposen-Bild",
            "ref_image": "Referenzbild",
            "ref_mask": "Referenzmaske"
        }
    }
}