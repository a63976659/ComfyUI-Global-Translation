{
    "InstantIDModelLoader": {
        "title": "InstnatID-Modell-Loader",
        "widgets": {
            "instantid_file": "InstantID-Datei"
        },
        "outputs": {
            "INSTANTID": "InstantID"
        }
    },
    "InstantIDFaceAnalysis": {
        "title": "InstantID Gesichtsanalyse",
        "widgets": {
            "provider": "Gerät"
        },
        "outputs": {
            "FACEANALYSIS": "Gesichtsanalyse"
        }
    },
    "ApplyInstantID": {
        "title": "InstantID anwenden",
        "inputs": {
            "instantid": "InstantID",
            "insightface": "Gesichtsanalyse",
            "control_net": "ControlNet",
            "image": "Bild",
            "model": "Modell",
            "positive": "Positiv-Prompt",
            "negative": "Negativ-Prompt",
            "image_kps": "Keypoint-Bild",
            "mask": "Maske"
        },
        "widgets": {
            "weight": "Gewichte",
            "start_at": "Startzeit",
            "end_at": "Endzeit"
        },
        "outputs": {
            "MODEL": "Modell",
            "positive": "Positiv-Prompt",
            "negative": "Negativ-Prompt"
        }
    },
    "ApplyInstantIDAdvanced": {
        "title": "InstantID anwenden (erweitert)",
        "inputs": {
            "instantid": "InstantID",
            "insightface": "Gesichtsanalyse",
            "control_net": "ControlNet",
            "image": "Bild",
            "model": "Modell",
            "positive": "Positiv-Prompt",
            "negative": "Negativ-Prompt",
            "image_kps": "Keypoint-Bild",
            "mask": "Maske"
        },
        "widgets": {
            "ip_weight": "IP-Gewicht",
            "cn_strength": "ControlNet-Gewichte",
            "start_at": "Startzeit",
            "end_at": "Endzeit",
            "noise": "Rauschen",
            "combine_embeds": "Kombinierte Einbettung"
        },
        "outputs": {
            "MODEL": "Modell",
            "positive": "Positiv-Prompt",
            "negative": "Negativ-Prompt"
        }
    },
    "FaceKeypointsPreprocessor": {
        "title": "Gesichtsschlüssel Punkte-Vorverarbeitung",
        "inputs": {
            "faceanalysis": "Gesichtsanalyse",
            "image": "Bild"
        },
        "outputs": {
            "IMAGE": "Bild"
        }
    },
    "InstantIDAttentionPatch": {
        "title": "InstantID-Aufmerksamkeitskomponenten",
        "inputs": {
            "instantid": "InstantID",
            "insightface": "Gesichtsanalyse",
            "image": "Bild",
            "model": "Modell",
            "mask": "Maske"
        },
        "widgets": {
            "weight": "Gewichte",
            "start_at": "Startzeit",
            "end_at": "Endzeit",
            "noise": "Rauschen"
        },
        "outputs": {
            "MODEL": "Modell",
            "FACE_EMBEDS": "Gesichts-Embedding-Gruppe"
        }
    },
    "ApplyInstantIDControlNet": {
        "title": "InstantID (ControlNet) anwenden",
        "inputs": {
            "face_embeds": "Gesichts-Embedding-Gruppe",
            "control_net": "ControlNet",
            "image_kps": "Keypoint-Bild",
            "positive": "Positiv-Prompt",
            "negative": "Negativ-Prompt",
            "mask": "Maske"
        },
        "widgets": {
            "strength": "Intensität",
            "start_at": "Startzeit",
            "end_at": "Endzeit"
        },
        "outputs": {
            "positive": "Positiv-Prompt",
            "negative": "Negativ-Prompt"
        }
    }
}