    "Flux2KleinEnhancer": {
        "title": "Flux2Klein Verstärker",
        "inputs": {
            "conditioning": "Konditioniert",
            "device": "Ausführungsgerät"
        },
        "widgets": {
            "active_scale": "Aktivbereich-Skalierung",
            "per_token_whiten": "Tokenweise Whitening",
            "norm_equalize": "Normausgleich",
