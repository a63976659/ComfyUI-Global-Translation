    },
    "Flux2KleinDetailController": {
        "title": "Flux2Klein Detailregler",
        "inputs": {
            "conditioning": "Konditioniert",
            "device": "Ausführungsgerät"
        },
        "widgets": {
            "front_mult": "Faktor vorderer Abschnitt",
            "mid_mult": "Faktor mittlerer Abschnitt",
            "end_mult": "Faktor hinterer Abschnitt",
            "emphasis_start": "Position des Betonungsbeginns",
            "emphasis_end": "Position des Betonungsendes",
            "emphasis_mult": "Betonungsfaktor",
            "preserve_original": "Originaldaten beibehalten",
            "debug": "Debug-Modus"
        },
        "description": "Regler für die Faktor-Anpassung von Abschnitts-Einbettungen.\n\nEchter Modus (empfohlen): zusammen mit dem Abschnitts-Encoder verwenden. Der Encoder erzeugt Token-Bereiche pro Abschnitt als Konditionierungs-Metadaten (`meta[\"klein_sections\"]`); dieser Knoten passt die Aktivierungs-Einbettungen im jeweiligen Bereich mit den vom Benutzer eingestellten Faktoren an.\n\nKompatibilitätsmodus (alt/nicht empfohlen): Wenn keine Abschnitts-Metadaten vorhanden sind, teilt der Knoten den Aktivbereich automatisch im festen Verhältnis 25%/50%/25% auf. Diese Grenzen sind beliebig – Qwen3-Token haben keine feste Positionssemantik – Version 1 dieses Knotens hat in diesem Modus praktisch keine Wirkung. Der Modus bleibt nur zur Kompatibilität mit alten Workflows erhalten; wechseln Sie zum Abschnitts-Encoder, um eine sinnvolle abschnittsbewusste Skalierung zu erhalten."
    },
    "Flux2KleinMaskRefController": {
        "title": "Flux2Klein Masken-Referenzregler",
        "inputs": {
            "conditioning": "Konditioniert",
            "mask": "Maske"
        },
        "widgets": {
            "strength": "Intensität",
            "invert_mask": "Maske umkehren",
            "feather": "Maskenkanten weichzeichnen",
            "reference_index": "Referenzindex",
            "debug": "Debug-Modus"
        },
        "description": "Wendet auf das Referenz-Latent eine räumliche Dämpfung an, die aus der gezeichneten Maske erzeugt wird.\n\nDas Referenz-Latent wird mit den pixelweisen Skalaren der Maske multipliziert. Das konditionierte Latent wird direkt an Ort und Stelle geändert (ersetzt meta['reference_Latents'])."
    },
