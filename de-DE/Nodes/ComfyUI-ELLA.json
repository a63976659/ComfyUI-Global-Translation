            "model": "Modell",
            "ella": "ELLA",
            "positive": "Positive ELLA-Einbettungsgruppe",
            "negative": "Negative ELLA-Einbettungsgruppe"
        },
        "outputs": {
            "model": "Modell",
            "positive": "Positive Bedingung",
            "negative": "Negative Bedingung"
        }
    },
    "T5TextEncode #ELLA": {
        "title": "T5-Textkodierung",
        "inputs": {
            "text_encoder": "Text-Encoder"
        },
        "widgets": {
            "text": "文本"
        },
        "outputs": {
            "ELLA_EMBEDS": "ELLA-Einbettungsgruppe"
        }
    },
    "ELLALoader": {
        "title": "ELLA-Lader",
        "widgets": {
            "name": "名称"
        },
        "outputs": {
            "ELLA": "ELLA"
        }
    },
    "T5TextEncoderLoader #ELLA": {
        "title": "T5-Textkodierungs-Lader",
        "widgets": {
            "name": "名称",
            "max_length": "Maximale Länge",
            "dtype": "Pruning-Typ"
        },
        "outputs": {
            "T5_TEXT_ENCODER": "T5-Textkodierer"
        }
    },
    "EllaCombineEmbeds": {
        "title": "ELLA-Einbettungsgruppen zusammenführen",
        "inputs": {
            "embeds": "Einbettungen",
