{
    "CRMPreprocessForPoser": {
        "title": "CRM Poser Vorverarbeitung",
        "inputs": {
            "reference_image": "Bild",
            "reference_mask": "Maske"
        },
        "widgets": {
            "foreground_ratio": "Vordergrundverhältnis"
        },
        "outputs": {
            "processed": "Verarbeitetes Bild"
        }
    },
    "CRMPoserConfig": {
        "title": "CRM Poser Konfiguration",
        "inputs": {
            "processed_image": "Verarbeitetes Bild"
        },
        "widgets": {
            "seed": "Zufalls-Seed",
            "control_before_generate": "Aktion vor der Ausführung",
            "cfg": "CFG",
            "steps": "Schritte"
        },
        "outputs": {
            "CRM_POSE_CONFIG": "Poser-Konfiguration"
        }
    },
    "CRMPoseSampler": {
        "title": "CRM Poser Abtaster",
        "inputs": {
            "config": "Poser-Konfiguration"
        },
        "widgets": {
            "pixel_model": "Pixel-Modell"
        },
        "outputs": {
            "IMAGE": "Pose-Bild"
        }
    },
    "CCMSampler": {
        "title": "CCM-Abtaster",
        "inputs": {
            "config": "Poser-Konfiguration",
            "poses": "Pose-Bild"
        },
        "widgets": {
            "ccm_model": "CCM-Modell"
        },
        "outputs": {
            "IMAGE": "Koordinatenbild"
        }
    },
    "CRMModelLoader": {
        "title": "CRM-Modell-Lader",
        "widgets": {
            "crm_model": "CRM-Modell"
        },
        "outputs": {
            "CRM_MODEL": "CRM-Modell"
        }
    },
    "CRMModeler": {
        "title": "CRM-Modellerzeugung",
        "inputs": {
            "crm_model": "CRM-Modell",
            "poses": "Pose-Bild",
            "coordinates": "Koordinatenbild"
        },
        "outputs": {
            "MESH": "Netz"
        }
    },
    "CRMModelerCuda": {
        "title": "CRM-Modellerzeugung (nur CUDA)",
        "inputs": {
            "crm_model": "CRM-Modell",
            "poses": "Pose-Bild",
            "coordinates": "Koordinatenbild"
        },
        "outputs": {
            "MESH": "Netz"
        }
    },
    "CRMViewer": {
        "title": "CRM-Netzvorschau",
        "inputs": {
            "mesh": "Netz"
        }
    }
}