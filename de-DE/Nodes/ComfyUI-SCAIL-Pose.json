            "nlf_model": "NLF-Modell"
        },
        "outputs": {
            "nlf_model": "NLF-Modell",
            "NLF_MODEL": "NLF-Modell"
        },
        "description": "",
        "api_version": "V1"
    },
    "NLFPredictPoses": {
        "title": "NLF Posen vorhersagen",
        "inputs": {
            "nlf_model": "NLF-Modell",
            "images": "Bild"
        },
        "widgets": {
            "per_batch": "Anzahl pro Batch",
            "num_aug": "Anzahl Augmentierungen",
            "detector_threshold": "Detektorschwellenwert"
        },
        "outputs": {
            "pose_results": "Posenergebnisse",
            "bboxes": "Begrenzungsrechteck",
            "NLFPRED": "NLF-Vorhersageergebnis",
            "BBOX": "Begrenzungsrechteck"
        },
        "description": "",
        "api_version": "V1"
    },
    "PoseDetectionVitPoseToDWPose": {
        "title": "Posenerkennung: Vit-Pose in DW-Pose",
        "inputs": {
            "vitpose_model": "Vit-Pose-Modell",
            "images": "Bild"
        },
        "outputs": {
            "dw_poses": "DW-Pose"
        }
    },
    "ConvertOpenPoseKeypointsToDWPose": {
        "title": "OpenPose-KeyPoints in DW-Pose umwandeln",
        "inputs": {
            "keypoints": "Pose-Keypoints"
        },
        "widgets": {
            "max_people": "Maximale Personenanzahl"
        },
        "outputs": {
            "dw_poses": "DW-Pose"
        }
    },
    "RenderNLFPoses": {
        "title": "NLF-Posen rendern",
        "inputs": {
            "nlf_poses": "NLF-Posedaten",
            "dw_poses": "DW-Pose",
            "ref_dw_pose": "Referenz-DW-Pose"
        },
        "widgets": {
            "width": "Breite",
            "height": "Höhe",
            "draw_face": "Gesicht zeichnen",
            "draw_hands": "Hände zeichnen",
            "render_device": "Render-Gerät",
            "scale_hands": "Hände skalieren",
            "render_backend": "Render-Backend"
        },
        "outputs": {
            "image": "Bild",
            "mask": "Maske"
        }
    },
    "SaveNLFPosesAs3D": {
        "title": "NLF-Posen als 3D-Animation speichern",
        "inputs": {
            "nlf_poses": "NLF-Posedaten"
        },
        "widgets": {
            "filename_prefix": "Dateiname-Präfix",
            "fps": "Bildrate",
            "cylinder_radius": "Zylinderradius"
        },
        "outputs": {
