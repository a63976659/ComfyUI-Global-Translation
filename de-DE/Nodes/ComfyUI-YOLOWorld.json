        },
        "widgets": {
            "model_id": "Modellname",
            "categories": "Kategorien"
        },
        "outputs": {
            "model": "Modell",
            "MODEL": "Modell"
        }
    },
    "YOLOWorld": {
        "title": "YOLOWorld",
        "inputs": {
            "model": "Modell",
            "images": "Bild"
        },
        "widgets": {
            "confidence_threshold": "Konfidenzschwelle",
            "nms_iou_threshold": "NMS-IoU-Schwelle",
            "with_class_agnostic_nms": "Klassenneutrale Non-Maximum-Suppression nutzen",
            "seed": "Zufalls-Seed"
        },
        "outputs": {
            "detections": "Erkennung",
            "Detections": "Erkennung"
        }
    },
    "YOLOWorld_Display": {
        "title": "YOLOWorld Anzeige",
        "inputs": {
            "images": "Bild",
            "detections": "Erkennung"
        },
        "widgets": {
            "with_confidence": "Mit Konfidenz",
            "thickness": "Dicke",
            "text_thickness": "Textdicke",
            "text_scale": "Text-Skalierung"
        },
        "outputs": {
            "images": "Bild",
            "IMAGE": "Bild"
        }
