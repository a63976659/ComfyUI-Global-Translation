            "images": "Bild",
            "face_attr": "Gesichtseigenschaften"
        },
        "widgets": {
            "crop": "Zuschneiden",
            "crop_scale_LRTB": "Zuschnittverhältnis LRTB",
            "safe_crop": "Sicherer Zuschnitt"
        },
        "outputs": {
