        "inputs": {
            "hyper_lora": "HyperLora",
            "id_cond": "Identitätsbedingung"
        },
        "outputs": {
            "LORA": "Lora"
        }
    },
    "HyperLoRAGenerateBaseLoRA": {
        "title": "HyperLora erzeugt Basis-Lora",
        "inputs": {
            "hyper_lora": "HyperLora",
