        }
    },
    "HyperLoRAUniGenerateIDLoRA": {
        "title": "HyperLora erzeugt universell ID-Lora",
        "inputs": {
            "hyper_lora": "HyperLora",
            "images": "Bild"
        },
        "widgets": {
            "grayscale": "Graustufenbild",
            "remove_background": "Hintergrund entfernen"
