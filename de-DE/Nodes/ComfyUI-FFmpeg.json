{
    "AddAudio": {
        "title": "🔥 Audio hinzufügen",
        "widgets": {
            "video_path": "Videopfad",
            "audio_from": "Audioquelle",
            "file_path": "Dateipfad",
            "delay_play": "Verzögerte Wiedergabe",
            "output_path": "Ausgabepfad"
        },
        "outputs": {
            "video_complete_path": "Vollständiger Videopfad",
            "string": "Text/String"
        },
        "description": " Fügt einem Video Audio hinzu\n Die Audioquelle kann eine Audiodatei oder eine Videodatei sein."
    },
    "AddImgWatermark": {
        "title": "🔥 Bild-Wasserzeichen zu Video hinzufügen",
        "widgets": {
            "video_path": "Videopfad",
            "output_path": "Video-Ausgabepfad",
            "watermark_image": "Pfad des Wasserzeichen-Bilds",
            "watermark_img_width": "Breite des Wasserzeichen-Bilds",
            "position_x": "X-Position",
            "position_y": "Y-Position"
        },
        "outputs": {
            "video_complete_path": "Vollständiger Videopfad",
            "string": "Text/String"
        },
        "description": " Fügt einem Video ein Bild-Wasserzeichen hinzu"
    },
    "AddTextWatermark": {
        "title": "🔥 Text-Wasserzeichen zu Video hinzufügen",
        "widgets": {
            "video_path": "Videopfad",
            "output_path": "Ausgabepfad",
            "font_file": "Schriftdatei",
            "font_size": "Schriftgröße",
            "font_color": "Schriftfarbe",
            "text": "文本",
            "position_x": "X-Position",
            "position_y": "Y-Position"
        },
        "outputs": {
            "video_path": "Videopfad",
            "output_path": "Ausgabepfad",
            "string": "字符串"
        },
        "description": " Fügt einem Video ein Text-Wasserzeichen hinzu \n Unterstützt chinesische und lateinische Zeichen; die chinesische Schrift muss in das Verzeichnis fonts des Plugins gelegt werden"
    },
    "ExtractAudio": {
        "title": "🔥 Audio extrahieren",
        "widgets": {
            "video_path": "Videopfad",
            "output_path": "Ausgabepfad",
            "audio_format": "Audioformat"
        },
        "outputs": {
            "audio_complete_path": "Vollständiger Audiopfad",
            "string": "字符串"
        },
        "description": " Extrahiert das Audio aus einem Video\n Unterstützte Audio-Formate zum Speichern sind unter anderem .m4a, .mp3, .wav, .aac, .flac, .wma, .ogg, .ac3, .amr, .aiff, .opus, .m4b, .caf, .dts."
    },
    "Frames2Video": {
        "title": "🔥 Einzelbilder in Video umwandeln",
        "widgets": {
            "frame_path": "Frame-Pfad",
            "fps": "Bildrate",
            "video_name": "Videoname",
            "output_path": "Ausgabepfad",
            "device": "Gerät",
            "audio_path": "Audiopfad"
        },
        "outputs": {
            "frame_path": "Frame-Pfad",
            "output_path": "Ausgabepfad",
            "string": "字符串"
        },
        "description": " Pfad manuell eingeben; der Pfad darf keine Anführungszeichen enthalten"
    },
    "ImageCopy": {
        "title": "🔥 Bild kopieren",
        "inputs": {
            "image_paths": "Bildpfad",
            "output_path": "Ausgabepfad"
        },
        "widgets": {
            "image_paths": "Bildpfad",
            "output_path": "Ausgabepfad"
        },
        "outputs": {
            "image_paths": "Bildpfad",
            "image_length": "Anzahl der Bilder",
            "output_path": "Ausgabepfad",
            "string": "Text/String"
        }
    },
    "ImagePath2Tensor": {
        "title": "🔥 Bildpfad in Tensor umwandeln",
        "inputs": {
            "image_paths": "Bildpfad"
        },
        "outputs": {
            "image": "Bild",
            "image_count": "Anzahl der Bilder"
        }
    },
    "ImagesSave": {
        "title": "🔥 Bild speichern",
        "inputs": {
            "images": "Bild",
            "output_path": "Ausgabepfad"
        },
        "widgets": {
            "output_path": "Ausgabepfad"
        },
        "outputs": {
            "image_length": "Anzahl der Bilder",
            "int": "Ganzzahl"
        }
    },
    "LoadImageFromDir": {
        "title": "🔥 Bilder aus Ordner laden",
        "widgets": {
            "images_path": "Bildpfad",
            "start_index": "Startindex",
            "length": "Länge"
        },
        "outputs": {
            "images_path": "Bildpfad",
            "list": "Liste"
        }
    },
    "MergingVideoByPlenty": {
        "title": "🔥 Videos stapelweise zusammenführen",
        "widgets": {
            "video_path": "Videopfad",
            "output_path": "Ausgabepfad"
        },
        "outputs": {
            "video_complete_path": "Vollständiger Videopfad",
            "string": "Text/String"
        },
        "description": " Führt mehrere kurze Videos mit identischer Kodierung, Auflösung und Bildrate zu einem langen Video zusammen.\n Alle Videos im angegebenen Pfad müssen dieselbe Kodierung, Bildrate und Auflösung haben."
    },
    "MergingVideoByTwo": {
        "title": "🔥 Zwei Videos zusammenführen",
        "widgets": {
            "video1_path": "Pfad von Video_1",
            "video2_path": "Pfad von Video_2",
            "device": "Gerät",
            "resolution_reference": "Auflösungsreferenz",
            "output_path": "Ausgabepfad"
        },
        "outputs": {
            "video_complete_path": "Vollständiger Videopfad",
            "string": "Text/String"
        },
        "description": " Führt zwei Videos zusammen, zum Beispiel zwei einstündige Videos zu einem zwei Stunden langen Video\n Die Größe des Ergebnisvideos kann am ersten oder am zweiten Video ausgerichtet werden."
    },
    "MultiCuttingVideo": {
        "title": "🔥 Video mehrfach schneiden",
        "widgets": {
            "video_path": "Videopfad",
            "output_path": "Ausgabepfad",
            "segment_time": "Segmentzeit"
        },
        "outputs": {
            "video_complete_path": "Vollständiger Videopfad",
            "string": "Text/String"
        },
        "description": " Schneidet ein Video in mehrere Videos.\n Die Länge jedes Segments in Sekunden. Achtung: geschnitten wird an Keyframes, daher darf die Zeit nicht zu kurz sein. Da nicht in jedem Segment ein Keyframe garantiert ist, können die Längen voneinander abweichen und sind nur möglichst nah am Wert."
    },
    "PipVideo": {
        "title": "🔥 Bild-in-Bild-Video",
        "widgets": {
            "video1_path": "Pfad von Video_1",
            "video2_path": "Pfad von Video_2",
            "device": "Gerät",
            "use_audio": "Audio verwenden",
            "use_duration": "Dauer verwenden",
            "align_type": "Ausrichtungsart",
            "pip_fg_zoom": "Bild-in-Bild-Vordergrund-Skalierung",
            "output_path": "Ausgabepfad",
            "scale_and_crop": "Skalieren und Zuschneiden",
            "fps": "Bildrate",
            "is_chromakey": "Chroma-Keying verwenden"
        },
        "outputs": {
            "video_complete_path": "Vollständiger Videopfad",
            "width": "Breite",
            "height": "Höhe",
            "duration": "Dauer",
            "fps": "Bildrate"
        },
        "description": " Skalierungsfaktor des Hintergrunds bei Bild-in-Bild; je größer, desto kleiner das Vordergrundbild. Der Wert ist der Verkleinerungsfaktor von Breite und Höhe des Hintergrunds.\n Bildrate des Ergebnisvideos, Standard 30,0; 0 verwendet die Bildrate von video2, 1 verwendet ebenfalls die Bildrate von video2."
    },
    "SingleCuttingVideo": {
        "title": "🔥 Video schneiden",
        "widgets": {
            "video_path": "Videopfad",
            "output_path": "Ausgabepfad",
            "start_time": "Startzeit",
            "end_time": "Endzeit"
        },
        "outputs": {
            "video_complete_path": "Vollständiger Videopfad",
            "string": "Text/String"
        },
        "description": " Schneidet einen bestimmten Zeitabschnitt aus einem Video."
    },
    "StitchingVideo": {
        "title": "🔥 Videos aneinanderfügen",
        "widgets": {
            "video1_path": "Pfad von Video_1",
            "video2_path": "Pfad von Video_2",
            "device": "Gerät",
            "use_audio": "Zielaudio verwenden",
            "stitching_type": "Fügeart",
            "output_path": "Ausgabepfad",
            "scale_and_crop": "Skalieren und Zuschneiden"
        },
        "outputs": {
            "video_complete_path": "Vollständiger Videopfad",
            "string": "Text/String"
        },
        "description": " Fügt zwei Videos aneinander, entweder horizontal oder vertikal."
    },
    "Video2Frames": {
        "title": "🔥 Video in Einzelbilder umwandeln",
        "widgets": {
            "video_path": "Videopfad",
            "output_path": "Ausgabepfad",
            "frames_max_width": "Maximale Frame-Breite"
        },
        "outputs": {
            "string": "字符串",
            "frame_path": "Frame-Pfad",
            "fps": "Bildrate",
            "audio_path": "Audiopfad",
            "total_frames": "Gesamte Frameanzahl",
            "output_path": "Ausgabepfad",
            "int": "Ganzzahl"
        },
        "description": " Maximale Frame-Breite\n Standard 0 bedeutet keine Skalierung. Ist die  maximale Frame-Breite  größer als die tatsächliche Videobreite, wird das Video nicht vergrößert und behält die ursprüngliche Breite; ist sie kleiner, wird das Video verkleinert."
    },
    "VideoFlip": {
        "title": "🔥 Video spiegeln",
        "widgets": {
            "video_path": "Videopfad",
            "output_path": "Ausgabepfad",
            "flip_type": "Spiegelungsart"
        },
        "outputs": {
            "video_complete_path": "Vollständiger Videopfad",
            "string": "Text/String"
        },
        "description": "  Spiegelt ein Video\n horizontal = waagerecht, vertical = senkrecht, both = waagerecht und senkrecht."
    },
    "VideoPlayback": {
        "title": "🔥 Video abspielen",
        "widgets": {
            "video_path": "Videopfad",
            "output_path": "Ausgabepfad",
            "reverse_audio": "Audio rückwärts abspielen"
        },
        "outputs": {
            "video_complete_path": "Vollständiger Videopfad",
            "string": "Text/String"
        },
        "description": "  Spielt ein Video rückwärts ab"
    },
    "VideoTransition": {
        "title": "🔥 Video-Übergang",
        "widgets": {
            "video1_path": "Pfad von Video_1",
            "video2_path": "Pfad von Video_2",
            "reference_video": "Referenzvideo",
            "device": "Gerät",
            "transition": "Übergang",
            "transition_duration": "Übergangsdauer",
            "offset": "Versatz",
            "output_path": "Ausgabepfad"
        },
        "outputs": {
            "video_complete_path": "Vollständiger Videopfad",
            "string": "Text/String"
        },
        "description": "Fügt zwischen zwei Videos eine Übergangsanimation hinzu."
    }
}