{
    "MultiLatentComposite": {
        "title": "Mehrere Latents komponieren",
        "inputs": {
            "samples_to": "Ziel-Latent",
            "samples_from0": "Quellen-Latent"
        },
        "outputs": {
            "LATENT": "Latent"
        }
    },
    "MultiAreaConditioning": {
        "title": "Multibereichs-Bedingungen",
        "inputs": {
            "conditioning0": "Bedingung 0",
            "conditioning1": "Bedingung 1"
        },
        "widgets": {
            "resolutionX": "Auflösung X",
            "resolutionY": "Auflösung Y",
            "index": "Bedingungsindex",
            "x": "X",
            "y": "Y",
            "width": "Breite",
            "height": "Höhe",
            "strength": "Intensität"
        },
        "outputs": {
            "CONDITIONING": "Bedingung",
            "resolutionX": "Auflösung X",
            "resolutionY": "Auflösung Y"
        }
    },
    "ConditioningUpscale": {
        "title": "Bedingungen skalieren",
        "inputs": {
            "conditioning": "Bedingung"
        },
        "widgets": {
            "scalar": "Anzahl"
        },
        "outputs": {
            "CONDITIONING": "Bedingung"
        }
    },
    "ConditioningStretch": {
        "title": "Bedingungen dehnen",
        "inputs": {
            "conditioning": "Bedingung"
        },
        "widgets": {
            "resolutionX": "Auflösung X",
            "resolutionY": "Auflösung Y",
            "newWidth": "Neue Breite",
            "newHeight": "Neue Höhe"
        },
        "outputs": {
            "CONDITIONING": "Bedingung"
        }
    }
}