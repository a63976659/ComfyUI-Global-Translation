        "description": ""
    },
    "CompositorColorPicker": {
        "title": "Compositor-Farbwähler",
        "inputs": {
            "format": "Dateiformat"
        },
        "widgets": {
            "red": "Rot",
            "green": "Grün",
            "blue": "Blau"
        },
        "outputs": {
            "color_string": "Farb-String",
            "color_16bit": "16-Bit-Farbwert",
            "color_24bit": "24-Bit-Farbwert",
            "color_preview": "Farbvorschau"
        },
        "description": "Dieser Knoten wandelt RGB-Werte (0-255) in verschiedene Farbformate um:\n- Hex-Farbzeichenkette (#RRGGBB)\n- 16-Bit-Farbwerte (Format RGB565 oder RGB555)\n- 24-Bit-Farbwerte (kompatibel mit dem emptyImage-Knoten von ComfyUI)\n- Ein Bild zur Farbvorschau"
    },
    "CompositorConfig3": {
        "title": "Compositor-Konfiguration 3",
        "inputs": {
            "image1": "Bild 1",
            "mask1": "Maske 1",
            "image2": "Bild 2",
            "mask2": "Maske 2",
            "image3": "Bild 3",
            "mask3": "Maske 3",
            "image4": "Bild 4",
            "mask4": "Maske 4",
            "image5": "Bild 5",
            "mask5": "Maske 5",
            "image6": "Bild 6",
            "mask6": "Maske 6",
            "image7": "Bild 7",
            "mask7": "Maske_7",
            "image8": "Bild 8",
            "mask8": "Maske_8"
        },
        "widgets": {
            "width": "Breite",
            "height": "Höhe",
            "padding": "Füllung",
            "normalizeHeight": "Normalisierte Höhe",
            "onConfigChanged": "Bei Konfigurationsänderung",
            "invertMask": "Maske umkehren",
            "initialized": "Initialisierung"
        },
        "outputs": {
            "config": "Konfiguration",
            "extendedConfig": "Erweiterte Konfiguration"
        },
        "description": "\nCompositor-Knoten\n- Übergibt bis zu 8 Bilder\n- Übergibt optional deren Masken (invertiert)\n- Masken werden automatisch angewendet und intern als RGBA übergeben\n- Nutze die Größen-Controls zur Konfiguration des Compositors, er skaliert zur Laufzeit\n- Setze den Schalter zum Pausieren, damit du Zeit zum Aufbau deines Composits hast (die Pause wirkt auf den Compositor, nicht auf den Konfigurationsknoten)\n"
    },
    "CompositorConfig4": {
        "title": "Compositor-Konfiguration 4",
        "inputs": {
            "image1": "Bild 1",
