    "Compositor4": {
        "title": "Compositor 4",
        "inputs": {
            "config": "Konfiguration"
        },
        "widgets": {
            "fabricData": "Canvas-Daten",
            "imageName": "Bildname",
            "seed": "Zufalls-Seed"
        },
        "description": "Interaktive Compositing-Fläche zum Positionieren, Skalieren, Drehen und Anordnen mehrerer Bilder mit Live-Vorschau und Maskenunterstützung. Bietet einen visuellen Editor mit Ebenenbedienfeld, Ausrichtungswerkzeugen und Rasterausrichtung."
    },
    "Compositor4MasksOutput": {
        "title": "Compositor-4-Maskenausgabe",
        "inputs": {
            "layer_outputs": "Ebenen-Ausgaben"
        },
        "outputs": {
            "image_1": "Bild_1",
            "image_2": "Bild_2",
            "image_3": "Bild_3",
            "image_4": "Bild_4",
            "image_5": "Bild_5",
            "image_6": "Bild_6",
            "image_7": "Bild_7",
            "image_8": "Bild_8",
            "mask_1": "Maske 1",
            "mask_2": "Maske 2",
            "mask_3": "Maske 3",
            "mask_4": "Maske 4",
            "mask_5": "Maske 5",
            "mask_6": "Maske 6",
            "mask_7": "Maske_7",
            "mask_8": "Maske_8"
        },
        "description": "Dieser Knoten zerlegt COMPOSITOR_OUTPUT_MASKS von Compositor4 in getrennte Bild- und Maskenausgaben.\nHält die Oberfläche des Compositors sauber, indem Ebenen-Ausgaben auf spezielle Knoten aufgeteilt werden."
    },
    "Compositor4TransformsOut": {
        "title": "Compositor-4-Transformationsausgabe",
        "widgets": {
            "transforms": "Transformation",
            "channel": "Kanal",
            "forceInt": "Ganzzahl erzwingen"
        },
        "outputs": {
            "x": "x",
            "y": "y",
            "width": "Breite",
            "height": "Höhe",
