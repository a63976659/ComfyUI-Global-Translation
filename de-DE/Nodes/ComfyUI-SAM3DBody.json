{
    "SAM3DBodyExportFBX": {
        "title": "SAM 3D-Körper: FBX exportieren",
        "inputs": {
            "mesh_data": "Mesh-Daten"
        },
        "widgets": {
            "output_filename": "Ausgabedateiname"
        },
        "outputs": {
            "fbx_path": "FBX-Pfad"
        }
    },
    "SAM3DBodyLoadMesh": {
        "title": "SAM 3D-Körper: Mesh laden",
        "inputs": {
            "source_folder": "Quellenordner"
        },
        "widgets": {
            "source_folder": "Quellenordner",
            "file_path": "Dateipfad",
            "refresh": "Aktualisieren",
            "Auto-refresh after generation": "Nach Generierung automatisch aktualisieren"
        },
        "outputs": {
            "mesh_data": "SAM3D-Ausgabe"
        }
    },
    "SAM3DBodySelectMesh": {
        "title": "SAM 3D-Körper: Mesh-Datei auswählen",
        "inputs": {
            "source_folder": "Quellenordner"
        },
        "widgets": {
            "source_folder": "Quellenordner",
            "file_path": "Dateipfad",
            "refresh": "Aktualisieren",
            "Auto-refresh after generation": "Nach Generierung automatisch aktualisieren"
        },
        "outputs": {
            "file_path": "Dateipfad"
        }
    },
    "LoadSAM3DBodyModel": {
        "title": "SAM 3D-Körpermodell laden",
        "inputs": {
            "model_source": "Modellquelle",
            "device": "Gerät"
        },
        "widgets": {
            "model_path": "Modellpfad",
            "mhr_path": "MHR-Pfad",
            "hf_token": "HF-Token",
            "model_source": "Modellquelle",
            "device": "Gerät"
        },
        "outputs": {
            "model": "SAM3D-Modell"
        }
    },
    "SAM3DBodyPreviewRiggedMesh": {
        "title": "SAM 3D-Körper: geriggtes Mesh in der Vorschau",
        "widgets": {
            "fbx_output_path": "FBX-Ausgabepfad"
        }
    },
    "SAM3DBodyPreviewSkeleton": {
        "title": "SAM 3D-Körper: Skelett in der Vorschau",
        "inputs": {
            "skeleton": "Skelett"
        }
    },
    "SAM3DBodyProcess": {
        "title": "SAM 3D-Körper: Bild verarbeiten",
        "inputs": {
            "model": "Modell",
            "image": "Bild",
            "mask": "Maske"
        },
        "widgets": {
            "bbox_threshold": "Bounding-Box-Schwellenwert",
            "inference_type": "Inferenztyp",
            "use_detector": "Detektor verwenden",
            "use_segmentor": "Segmentor verwenden",
            "use_fov_estimator": "Sichtfeldschätzer verwenden"
        },
        "outputs": {
            "mesh_data": "SAM3D-Ausgabe",
            "skeleton": "Skelett",
            "debug_image": "Bild"
        }
    },
    "SAM3DBodyProcessAdvanced": {
        "title": "SAM 3D-Körper: Bild verarbeiten (erweitert)",
        "inputs": {
            "model": "Modell",
            "image": "Bild",
            "mask": "Maske"
        },
        "widgets": {
            "bbox_threshold": "Bounding-Box-Schwellenwert",
            "nms_threshold": "NMS-Schwellenwert",
            "inference_type": "Inferenztyp",
            "detector_name": "Detektorname",
            "segmentor_name": "Segmentorname",
            "fov_name": "Sichtfeldname",
            "detector_path": "Detektorpfad",
            "segmentor_path": "Segmentorpfad",
            "fov_path": "Sichtfeldpfad"
        },
        "outputs": {
            "mesh_data": "SAM3D-Ausgabe",
            "skeleton": "Skelett",
            "debug_image": "Bild"
        }
    },
    "SAM3DBodySaveSkeleton": {
        "title": "SAM 3D-Körper: Skelett speichern",
        "inputs": {
            "skeleton": "Skelett"
        },
        "widgets": {
            "output_filename": "Ausgabedateiname",
            "format": "Format (Darstellung)"
        },
        "outputs": {
            "filepath": "Dateipfad"
        }
    },
    "SAM3DBodyLoadSkeleton": {
        "title": "SAM 3D-Körper: Skelett laden",
        "widgets": {
            "filepath": "Dateipfad"
        },
        "outputs": {
            "skeleton": "Skelett"
        }
    },
    "SAM3DBodyAddMeshToSkeleton": {
        "title": "SAM 3D-Körper: Mesh zum Skelett hinzufügen",
        "inputs": {
            "skeleton": "Skelett",
            "model": "Modell"
        },
        "outputs": {
            "mesh_data": "SAM3D-Ausgabe"
        }
    },
    "SAM3DBodyVisualize": {
        "title": "SAM 3D-Körper: Mesh visualisieren",
        "inputs": {
            "mesh_data": "Mesh-Daten",
            "image": "Bild"
        },
        "widgets": {
            "render_mode": "Rendermodus"
        },
        "outputs": {
            "rendered_image": "Bild"
        }
    },
    "SAM3DBodyExportMesh": {
        "title": "SAM 3D-Körper: Mesh exportieren",
        "inputs": {
            "mesh_data": "Mesh-Daten"
        },
        "widgets": {
            "filename": "Dateiname",
            "output_dir": "Ausgabeverzeichnis"
        },
        "outputs": {
            "file_path": "Dateipfad"
        }
    },
    "SAM3DBodyGetVertices": {
        "title": "SAM 3D-Körper: Mesh-Informationen abrufen",
        "inputs": {
            "mesh_data": "Mesh-Daten"
        },
        "outputs": {
            "info": "Detailinfos"
        }
    }
}