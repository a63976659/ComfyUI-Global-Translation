        },
        "widgets": {
            "sound_path": "Pfad des Hinweistons"
        }
    },
    "FillDarkMask": {
        "title": "Dunkle Maske füllen",
        "inputs": {
            "masks": "Maske"
        },
        "outputs": {
            "MASK": "Maske"
        }
    },
    "SaveImage": {
        "title": "Bild speichern",
        "inputs": {
            "images": "Bild"
        },
        "widgets": {
            "filename_prefix": "Dateiname-Präfix",
            "output_path": "Ausgabepfad",
            "prompt": "Prompt-Info",
            "extra_pnginfo": "Zusätzliche PNG-Info"
        }
    },
    "InterpolateKeyFrame": {
        "title": "Keyframe-Interpolation (Mouseover für Anmerkungen)",
        "inputs": {
            "orginalframe": "Ursprüngliches Video",
            "keyframe": "Video für die Frame-Interpolation"
        },
        "widgets": {
            "select_every_nth": "Jedes N-te Bild wählen",
            "batch_size": "Stapelgröße",
            "tracking_window_size": "Verfolgungs-Fenstergröße",
            "minimum_patch_size": "Minimale Patch-Größe",
            "num_iter": "Anzahl Iterationen",
            "guide_weight": "Guidance-Gewicht"
        },
        "outputs": {
            "IMAGE": "Bild"
        },
        "description": "Frame-Interpolation, glättet das Video mit nur einigen Bildern\n Parameter\nJedes N-te Bild wählen: alle N Bilder einfügen\nStapelgröße: größer = schneller, benötigt aber mehr VRAM.\nFenstergröße: Flüssigkeit des Videos.\nMinimale Patch-Größe: ungerade (wichtig), größer ist besser\nIterationsanzahl: Anzahl der Iterationen, mehr ist besser\nGuidance-Gewicht: bestimmt, wie viele Bewegungs-Merkmale (Features) auf das Stil-Video angewendet werden.\nGenauigkeit: größer ist besser, meist genügt 1\n  Zeitkomplexität (Genauigkeit=1): log(Fenstergröße) * minimale Patch-Größe^2 * Iterationsanzahl * Videolänge * Videoauflösung \n"
    },
    "MaskListcaptoBatch": {
        "title": "Maskenlisten-Batch-Verarbeitung",
        "inputs": {
            "mask": "Maske"
        },
        "widgets": {
            "load_cap": "Ladeobergrenze"
        },
        "outputs": {
            "MASK": "Maske"
        }
    },
    "Merge_Image_List": {
        "title": "Bildliste zusammenführen",
        "inputs": {
            "images": "Bild"
        },
        "outputs": {
            "IMAGE": "Bild"
        }
    },
    "MyOpenPoseNode": {
        "title": "OpenPose-Posen-Erkennungsknoten",
        "inputs": {
            "DWPose": "DWPose dynamische Posen",
            "OpenPose": "OpenPose-Posen"
        },
        "widgets": {
            "hex_color": "Hex-Farbe",
            "image": "Bild",
            "reserved_colors": "Beibehaltene Farben"
        },
        "outputs": {
            "IMAGE": "Bild"
        },
        "description": "  Weil DWPose-Posen beim Umdrehen einer Person den Rücken nicht erkennen kann, bei Körperposen aber genauer als OpenPose ist, OpenPose den Rücken gut erkennt, vereint dies die Vorteile beider."
    },
    "reBatchImage": {
        "title": "Bild-Batch-Wiederholverarbeitung",
        "inputs": {
            "image": "Bild"
        },
        "widgets": {
            "batch_size": "Stapelgröße"
        },
        "outputs": {
            "IMAGE": "Bild"
        },
        "description": "Optimiert für FastBlend mit parallelem Bild-Rendering (720p, 24G VRAM, batch_size bis 40 einstellbar), rund 40 % schneller."
    },
    "SmoothVideo": {
        "title": "Videoglättung",
        "inputs": {
            "orginalframe": "Originalbilder",
            "keyframe": "Schlüsselbild"
        },
        "widgets": {
            "accuracy": "Genauigkeit",
            "window_size": "Fenstergröße",
            "batch_size": "Stapelgröße",
            "tracking_window_size": "Verfolgungs-Fenstergröße",
            "minimum_patch_size": "Minimale Patch-Größe",
            "num_iter": "Anzahl Iterationen",
            "guide_weight": "Guidance-Gewicht"
        },
        "outputs": {
            "IMAGE": "Bild"
        },
        "description": "Rendert bildweise / Flüssigvideos nutzen jedes Bild"
    }
}