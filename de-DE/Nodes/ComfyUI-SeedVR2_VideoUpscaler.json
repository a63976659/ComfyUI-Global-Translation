{
    "SeedVR2VideoUpscaler": {
        "title": "SeedVR2 Video-Superresolution",
        "inputs": {
            "image": "Eingabebild",
            "dit": "DiT-Modellkonfiguration",
            "vae": "VAE-Modellkonfiguration"
        },
        "widgets": {
            "seed": "Zufalls-Seed",
            "resolution": "Zielauflösung",
            "max_resolution": "Maximale Auflösungsbegrenzung",
            "batch_size": "Stapelgröße",
            "uniform_batch_size": "Einheitliche Stapelgröße",
            "temporal_overlap": "Zeitliche Überlappung (Frames)",
            "prepend_frames": "Anzahl vorangestellter Frames",
            "color_correction": "Farbkorrektur",
            "input_noise_scale": "Rauschfaktor",
            "latent_noise_scale": "Latent-Rauschkoeffizient",
            "offload_device": "Auslagerungsgerät für Zwischentensoren",
            "enable_debug": "Debugging aktivieren"
        },
        "outputs": {
            "IMAGE": "Superauflösungs-Ausgabebild"
        }
    },
    "SeedVR2LoadDiTModel": {
        "title": "SeedVR2 DiT-Modell laden",
        "inputs": {
            "torch_compile_args": "Torch-Kompilierungsparameter"
        },
        "widgets": {
            "model": "Modellauswahl",
            "device": "Inferenzgerät",
            "blocks_to_swap": "BlockSwap: Anzahl der getauschten Blöcke",
            "swap_io_components": "IO-Komponenten tauschen",
            "offload_device": "Auslagerungsgerät",
            "cache_model": "Cache-Modell",
            "attention_mode": "Attention-Modus"
        },
        "outputs": {
            "SEEDVR2_DIT": "DiT-Modellkonfiguration"
        }
    },
    "SeedVR2LoadVAEModel": {
        "title": "SeedVR2 VAE-Modell laden",
        "inputs": {
            "torch_compile_args": "Torch-Kompilierungsparameter"
        },
        "widgets": {
            "model": "Modellauswahl",
            "device": "Inferenzgerät",
            "encode_tiled": "Gekacheltes Encoding",
            "encode_tile_size": "Encoder-Kachelgröße",
            "encode_tile_overlap": "Encoder-Kachelüberlappung",
            "decode_tiled": "Gekacheltes Dekodieren",
            "decode_tile_size": "Decoder-Kachelgröße",
            "decode_tile_overlap": "Decoder-Kachelüberlappung",
            "tile_debug": "Kachel-Debug-Modus",
            "offload_device": "Auslagerungsgerät",
            "cache_model": "Cache-Modell"
        },
        "outputs": {
            "SEEDVR2_VAE": "VAE-Modellkonfiguration"
        }
    },
    "SeedVR2TorchCompileSettings": {
        "title": "SeedVR2 Torch-Compile-Einstellungen",
        "widgets": {
            "backend": "Kompilierungs-Backend",
            "mode": "Optimierungsmodus",
            "fullgraph": "Vollständige Graph-Kompilierung",
            "dynamic": "Dynamische Formen",
            "dynamo_cache_size_limit": "Cache-Größenlimit",
            "dynamo_recompile_limit": "Neukompilierungs-Limit"
        },
        "outputs": {
            "TORCH_COMPILE_ARGS": "Torch-Compile-Konfiguration"
        }
    }
}
