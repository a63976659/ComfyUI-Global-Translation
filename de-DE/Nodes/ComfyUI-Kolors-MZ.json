{
    "MZ_ChatGLM3Loader": {
        "title": "ChatGLM3-Loader",
        "widgets": {
            "chatglm3_checkpoint": "ChatGLM3-Modell"
        },
        "outputs": {
            "chatglm3_model": "ChatGLM3"
        }
    },
    "MZ_ChatGLM3_V2": {
        "title": "ChatGLM3-Encoding_V2",
        "inputs": {
            "chatglm3_model": "ChatGLM3"
        },
        "widgets": {
            "text": "Text (Zeichenkette)"
        },
        "outputs": {
            "CONDITIONING": "Bedingung"
        }
    },
    "MZ_ChatGLM3_Advance_V2": {
        "title": "ChatGLM3-Encoding_V2 erweitert",
        "inputs": {
            "chatglm3_model": "ChatGLM3"
        },
        "widgets": {
            "text": "Text (Zeichenkette)",
            "width": "Breite",
            "height": "Höhe",
            "crop_w": "Zuschnittbreite",
            "crop_h": "Zuschnichthöhe",
            "target_width": "Zielbreite",
            "target_height": "Zielhöhe"
        },
        "outputs": {
            "CONDITIONING": "Bedingung"
        }
    },
    "MZ_ChatGLM3Embeds2Conditioning": {
        "title": "ChatGLM3-Embedding-Gruppe zu Bedingung",
        "inputs": {
            "kolors_embeds": "Kolors-Embedding-Gruppe"
        },
        "widgets": {
            "width": "Breite",
            "height": "Höhe",
            "crop_w": "Zuschnittbreite",
            "crop_h": "Zuschnichthöhe",
            "target_width": "Zielbreite",
            "target_height": "Zielhöhe"
        },
        "outputs": {
            "positive": "Positive Bedingung",
            "negative": "Negative Bedingung"
        }
    },
    "MZ_KolorsCheckpointLoaderSimple": {
        "title": "Kolors-Modell-Loader (einfach)",
        "widgets": {
            "ckpt_name": "Modellname"
        },
        "outputs": {
            "MODEL": "Modell",
            "VAE": "VAE"
        }
    },
    "MZ_KolorsControlNetLoader": {
        "title": "KolorsControlNet-Loader",
        "widgets": {
            "control_net_name": "ControlNet-Name"
        },
        "outputs": {
            "ControlNet": "ControlNet"
        }
    },
    "MZ_KolorsUNETLoaderV2": {
        "title": "KolorsUNET-Loader_V2",
        "widgets": {
            "unet_name": "UNET-Name"
        },
        "outputs": {
            "model": "Modell"
        }
    },
    "MZ_KolorsControlNetPatch": {
        "title": "KolorsControlNet-Konvertierung",
        "inputs": {
            "control_net": "ControlNet",
            "model": "Modell"
        },
        "outputs": {
            "CONTROL_NET": "ControlNet"
        }
    },
    "MZ_ApplySDXLSamplingSettings": {
        "title": "SDXL-Sampling-Einstellungen anwenden",
        "inputs": {
            "model": "Modell"
        },
        "outputs": {
            "MODEL": "Modell"
        }
    },
    "MZ_ApplyCUDAGenerator": {
        "title": "CUDA-Generator anwenden",
        "inputs": {
            "model": "Modell"
        },
        "outputs": {
            "MODEL": "Modell"
        }
    }
}