{
    "EllaApply": {
        "title": "ELLAを適用",
        "inputs": {
            "model": "モデル",
            "ella": "ELLA",
            "positive": "ポジティブELLA埋め込みグループ",
            "negative": "ネガティブELLA埋め込みグループ"
        },
        "outputs": {
            "model": "モデル",
            "positive": "ポジティブ条件",
            "negative": "ネガティブ条件"
        }
    },
    "T5TextEncode #ELLA": {
        "title": "T5テキストエンコード",
        "inputs": {
            "text_encoder": "テキストエンコーダ"
        },
        "widgets": {
            "text": "テキスト"
        },
        "outputs": {
            "ELLA_EMBEDS": "ELLA埋め込みグループ"
        }
    },
    "ELLALoader": {
        "title": "ELLAローダー",
        "widgets": {
            "name": "名前"
        },
        "outputs": {
            "ELLA": "ELLA"
        }
    },
    "T5TextEncoderLoader #ELLA": {
        "title": "T5テキストエンコードローダー",
        "widgets": {
            "name": "名前",
            "max_length": "最大長",
            "dtype": "量子化タイプ"
        },
        "outputs": {
            "T5_TEXT_ENCODER": "T5テキストエンコーダー"
        }
    },
    "EllaCombineEmbeds": {
        "title": "ELLA埋め込みグループ結合",
        "inputs": {
            "embeds": "埋め込みグループ",
            "embeds_add": "埋め込みグループ_追加"
        },
        "outputs": {
            "ELLA_EMBEDS": "ELLA埋め込みグループ"
        }
    },
    "ConditionToEllaEmbeds": {
        "title": "条件からELLA埋め込みグループ",
        "inputs": {
            "cond": "条件"
        },
        "outputs": {
            "ELLA_EMBEDS": "ELLA埋め込みグループ"
        }
    },
    "ConcatConditionEllaEmbeds": {
        "title": "条件連結ELLA埋め込みグループ",
        "inputs": {
            "cond": "条件",
            "embeds": "埋め込みグループ"
        },
        "outputs": {
            "ELLA_EMBEDS": "ELLA埋め込みグループ"
        }
    },
    "CombineClipEllaEmbeds": {
        "title": "CLIPELLA埋め込みグループ結合",
        "inputs": {
            "cond": "条件",
            "embeds": "埋め込みグループ"
        },
        "outputs": {
            "ELLA_EMBEDS": "ELLA埋め込みグループ"
        }
    },
    "SetEllaTimesteps": {
        "title": "ELLA間隔を設定",
        "inputs": {
            "model": "モデル",
            "ella": "ELLA",
            "sigmas": "Sigmas"
        },
        "widgets": {
            "scheduler": "スケジューラ",
            "steps": "ステップ数",
            "denoise": "ノイズ除去"
        },
        "outputs": {
            "ELLA": "ELLA"
        }
    },
    "EllaEncode": {
        "title": "ELLAエンコード",
        "inputs": {
            "ella": "ELLA",
            "embeds": "埋め込みグループ"
        },
        "outputs": {
            "CONDITIONING": "条件"
        }
    },
    "EllaTextEncode": {
        "title": "ELLAテキストエンコード",
        "inputs": {
            "ella": "ELLA",
            "text_encoder": "テキストエンコーダ",
            "clip": "CLIP"
        },
        "widgets": {
            "text": "テキスト",
            "text_clip": "CLIPテキスト"
        },
        "outputs": {
            "CONDITIONING": "条件",
            "CLIP CONDITIONING": "CLIP条件"
        }
    }
}