{
    "AddAudio": {
        "title": "🔥音声を追加",
        "widgets": {
            "video_path": "動画パス",
            "audio_from": "音声ソース",
            "file_path": "ファイルパス",
            "delay_play": "再生遅延",
            "output_path": "出力パス"
        },
        "outputs": {
            "video_complete_path": "動画フルパス",
            "string": "テキスト/文字列"
        },
        "description": " このノードの役割は動画に音声を追加することです\n 音声は音声ファイルからでも、動画ファイルからでも取得できます。"
    },
    "AddImgWatermark": {
        "title": "🔥動画に画像透かしを追加",
        "widgets": {
            "video_path": "動画パス",
            "output_path": "動画出力パス",
            "watermark_image": "透かし画像パス",
            "watermark_img_width": "透かし画像幅",
            "position_x": "X 位置",
            "position_y": "Y 位置"
        },
        "outputs": {
            "video_complete_path": "動画フルパス",
            "string": "テキスト/文字列"
        },
        "description": " このノードの役割は動画に画像透かしを追加することです"
    },
    "AddTextWatermark": {
        "title": "🔥動画にテキスト透かしを追加",
        "widgets": {
            "video_path": "動画パス",
            "output_path": "出力パス",
            "font_file": "フォントファイル",
            "font_size": "フォントサイズ",
            "font_color": "フォント色",
            "text": "テキスト",
            "position_x": "X 位置",
            "position_y": "Y 位置"
        },
        "outputs": {
            "video_path": "動画パス",
            "output_path": "出力パス",
            "string": "文字列"
        },
        "description": " このノードの役割は動画にテキスト透かしを追加することです \n 中国語と英語に対応しています。中国語フォントはプラグインのfontsディレクトリに配置する必要があります"
    },
    "ExtractAudio": {
        "title": "🔥音声を抽出",
        "widgets": {
            "video_path": "動画パス",
            "output_path": "出力パス",
            "audio_format": "音声フォーマット"
        },
        "outputs": {
            "audio_complete_path": "音声フルパス",
            "string": "文字列"
        },
        "description": " このノードの役割は動画から音声を抽出することです\n 保存できる音声フォーマットには、.m4a，.mp3，.wav，.aac，.flac，.wma，.ogg，.ac3，.amr，.aiff，.opus，.m4b，.caf，.dts などがあります。"
    },
    "Frames2Video": {
        "title": "🔥連番フレームを動画に変換",
        "widgets": {
            "frame_path": "フレームパス",
            "fps": "フレームレート",
            "video_name": "動画名",
            "output_path": "出力パス",
            "device": "デバイス",
            "audio_path": "音声パス"
        },
        "outputs": {
            "frame_path": "フレームパス",
            "output_path": "出力パス",
            "string": "文字列"
        },
        "description": " 手動でパスを入力します。パスに引用符は使わないでください"
    },
    "ImageCopy": {
        "title": "🔥画像コピー",
        "inputs": {
            "image_paths": "画像パス",
            "output_path": "出力パス"
        },
        "widgets": {
            "image_paths": "画像パス",
            "output_path": "出力パス"
        },
        "outputs": {
            "image_paths": "画像パス",
            "image_length": "画像数",
            "output_path": "出力パス",
            "string": "テキスト/文字列"
        }
    },
    "ImagePath2Tensor": {
        "title": "🔥画像パスをテンソルに変換",
        "inputs": {
            "image_paths": "画像パス"
        },
        "outputs": {
            "image": "画像",
            "image_count": "画像数"
        }
    },
    "ImagesSave": {
        "title": "🔥画像保存",
        "inputs": {
            "images": "画像",
            "output_path": "出力パス"
        },
        "widgets": {
            "output_path": "出力パス"
        },
        "outputs": {
            "image_length": "画像数",
            "int": "整数"
        }
    },
    "LoadImageFromDir": {
        "title": "🔥ディレクトリから画像を読み込み",
        "widgets": {
            "images_path": "画像パス",
            "start_index": "開始インデックス",
            "length": "長さ"
        },
        "outputs": {
            "images_path": "画像パス",
            "list": "リスト"
        }
    },
    "MergingVideoByPlenty": {
        "title": "🔥動画を一括結合",
        "widgets": {
            "video_path": "動画パス",
            "output_path": "出力パス"
        },
        "outputs": {
            "video_complete_path": "動画フルパス",
            "string": "テキスト/文字列"
        },
        "description": " このノードの役割は、エンコード形式・解像度・フレームレートがすべて同じ複数の短尺動画を1つの長尺動画に結合することです。\n このパス内のすべての動画のエンコード形式・フレームレート・解像度が同じである必要があります。"
    },
    "MergingVideoByTwo": {
        "title": "🔥動画を結合",
        "widgets": {
            "video1_path": "動画_1 パス",
            "video2_path": "動画_2 パス",
            "device": "デバイス",
            "resolution_reference": "解像度参照",
            "output_path": "出力パス"
        },
        "outputs": {
            "video_complete_path": "動画フルパス",
            "string": "テキスト/文字列"
        },
        "description": " このノードの役割は2つの動画を結合することで、例えば1時間の動画を2つ結合して2時間の動画にできます\n 結合後の動画サイズは1本目または2本目の動画を参照できます。"
    },
    "MultiCuttingVideo": {
        "title": "🔥動画を複数回分割",
        "widgets": {
            "video_path": "動画パス",
            "output_path": "出力パス",
            "segment_time": "セグメント時間"
        },
        "outputs": {
            "video_complete_path": "動画フルパス",
            "string": "テキスト/文字列"
        },
        "description": " このノードの役割は1つの動画を複数の動画に分割することです。\n 分割後の各動画の長さの単位は秒です。キーフレームを基準に動画を分割するため、時間は短すぎないよう注意が必要です。各セグメントにキーフレームが存在する保証はないため、各動画の長さは必ずしも同一ではなく、最も近い値になります。"
    },
    "PipVideo": {
        "title": "🔥ピクチャーインピクチャー動画",
        "widgets": {
            "video1_path": "動画_1 パス",
            "video2_path": "動画_2 パス",
            "device": "デバイス",
            "use_audio": "音声を使用",
            "use_duration": "使用長さ",
            "align_type": "整列タイプ",
            "pip_fg_zoom": "ピクチャーインピクチャー前景スケール",
            "output_path": "出力パス",
            "scale_and_crop": "スケールとクロップ",
            "fps": "フレームレート",
            "is_chromakey": "クロマキー合成を行うか"
        },
        "outputs": {
            "video_complete_path": "動画フルパス",
            "width": "幅",
            "height": "高さ",
            "duration": "持続時間",
            "fps": "フレームレート"
        },
        "description": " ピクチャーインピクチャーの背景スケール係数。値が大きいほど前景が小さくなり、背景の幅・高さの縮小倍率を表します。\n 最終動画のフレームレート。既定値は30.0で、0にするとvideo2のフレームレートを使用し、1にしてもvideo2のフレームレートを使用します。"
    },
    "SingleCuttingVideo": {
        "title": "🔥動画を分割",
        "widgets": {
            "video_path": "動画パス",
            "output_path": "出力パス",
            "start_time": "開始率",
            "end_time": "終了率"
        },
        "outputs": {
            "video_complete_path": "動画フルパス",
            "string": "テキスト/文字列"
        },
        "description": " このノードの役割は指定した動画からある時間範囲の動画を切り出すことです。"
    },
    "StitchingVideo": {
        "title": "🔥動画を連結",
        "widgets": {
            "video1_path": "動画_1 パス",
            "video2_path": "動画_2 パス",
            "device": "デバイス",
            "use_audio": "使用する対象音声を選択",
            "stitching_type": "連結タイプ",
            "output_path": "出力パス",
            "scale_and_crop": "スケールとクロップ"
        },
        "outputs": {
            "video_complete_path": "動画フルパス",
            "string": "テキスト/文字列"
        },
        "description": " このノードの役割は2つの動画を連結することで、水平連結と垂直連結の2種類の方式があります。"
    },
    "Video2Frames": {
        "title": "🔥動画を連番フレームに変換",
        "widgets": {
            "video_path": "動画パス",
            "output_path": "出力パス",
            "frames_max_width": "フレーム最大幅"
        },
        "outputs": {
            "string": "文字列",
            "frame_path": "フレームパス",
            "fps": "フレームレート",
            "audio_path": "音声パス",
            "total_frames": "総フレーム数",
            "output_path": "出力パス",
            "int": "整数"
        },
        "description": " フレームの最大幅\n 既定値は0で、動画を縮小しないことを意味します。フレーム最大幅が動画の実幅より大きい場合、動画は拡大されず元の幅が保たれ、フレーム最大幅が動画の実幅より小さい場合、動画は縮小されます。"
    },
    "VideoFlip": {
        "title": "🔥動画を反転",
        "widgets": {
            "video_path": "動画パス",
            "output_path": "出力パス",
            "flip_type": "反転タイプ"
        },
        "outputs": {
            "video_complete_path": "動画フルパス",
            "string": "テキスト/文字列"
        },
        "description": "  このノードの役割は動画を反転することです\n horizontalは水平反転、verticalは垂直反転、bothは水平+垂直反転です。"
    },
    "VideoPlayback": {
