{
    "alert_when_finished": {
        "title": "完了時に通知",
        "inputs": {
            "images": "画像"
        },
        "widgets": {
            "sound_path": "通知音パス"
        }
    },
    "FillDarkMask": {
        "title": "ダークマスクを塗りつぶし",
        "inputs": {
            "masks": "マスク"
        },
        "outputs": {
            "MASK": "マスク"
        }
    },
    "SaveImage": {
        "title": "画像保存",
        "inputs": {
            "images": "画像"
        },
        "widgets": {
            "filename_prefix": "ファイル名プレフィックス",
            "output_path": "出力パス",
            "prompt": "通知メッセージ",
            "extra_pnginfo": "追加PNG情報"
        }
    },
    "InterpolateKeyFrame": {
        "title": "キーフレーム補間（マウスをここにホバーすると注釈を表示）",
        "inputs": {
            "orginalframe": "元の動画",
            "keyframe": "補間フレーム挿入が必要な動画"
        },
        "widgets": {
            "select_every_nth": "毎Nフレーム選択",
            "batch_size": "バッチサイズ",
            "tracking_window_size": "追跡ウィンドウサイズ",
            "minimum_patch_size": "最小パッチサイズ",
            "num_iter": "反復回数",
            "guide_weight": "ガイド重み"
        },
        "outputs": {
            "IMAGE": "画像"
        },
        "description": "補間フレーム挿入。一部のフレームのみを使用して動画を滑らかにする\n 引数の意味\n毎Nフレーム選択：Nフレーム間隔で挿入\nバッチサイズ：バッチサイズが大きいほど処理速度は速くなるが、より多くのVRAMが必要。\nウィンドウサイズ：動画の滑らかさ。\n最小パッチサイズ：奇数（重要）、大きいほど良い\nイテレーション回数：イテレーション数、多いほど良い\nガイド重み：動きの特徴量をスタイル動画にどれだけ適用するかを決める引数。\n精度：大きいほど良い。ほとんどの場合1で十分\n  計算量（精度=1）：log(ウィンドウサイズ) * 最小パッチサイズ^2 * イテレーション回数 * 動画の長さ * 動画解像度 \n"
    },
    "MaskListcaptoBatch": {
        "title": "マスクリストのバッチ化",
        "inputs": {
            "mask": "マスク"
        },
        "widgets": {
            "load_cap": "読み込み上限"
        },
        "outputs": {
            "MASK": "マスク"
        }
    },
    "Merge_Image_List": {
        "title": "画像リストをマージ",
        "inputs": {
            "images": "画像"
        },
        "outputs": {
            "IMAGE": "画像"
        }
    },
    "MyOpenPoseNode": {
        "title": "OpenPoseポーズ認識ノード",
        "inputs": {
            "DWPose": "DWPose動的ポーズ",
            "OpenPose": "OpenPoseポーズ"
        },
        "widgets": {
            "hex_color": "16進色",
            "image": "画像",
            "reserved_colors": "保持色"
        },
        "outputs": {
            "IMAGE": "画像"
        },
        "description": " DWPoseポーズは人物が向きを変えたときに背中を認識できないが、人物のポーズの面ではOpenPoseポーズより正確であり、OpenPoseポーズは背中を良好に認識できる。これは両者の長所を組み合わせたもの"
    },
    "reBatchImage": {
        "title": "画像バッチ再処理",
        "inputs": {
            "image": "画像"
        },
        "widgets": {
            "batch_size": "バッチサイズ"
        },
        "outputs": {
            "IMAGE": "画像"
        },
        "description": "高速ブレンド専用に設計され、画像の同時レンダリング（720p、VRAM 24G、batch_size は 40 まで調整可）で速度が約 40% 向上する。"
    },
    "SmoothVideo": {
        "title": "動画スムージング",
        "inputs": {
            "orginalframe": "元のフレーム",
            "keyframe": "キーフレーム"
        },
        "widgets": {
            "accuracy": "精度",
            "window_size": "ウィンドウサイズ",
            "batch_size": "バッチサイズ",
            "tracking_window_size": "追跡ウィンドウサイズ",
            "minimum_patch_size": "最小パッチサイズ",
            "num_iter": "反復回数",
            "guide_weight": "ガイド重み"
        },
        "outputs": {
            "IMAGE": "画像"
        },
        "description": "フレームごとのレンダリング／滑らかな動画はすべてのフレームを使用"
    }
}