    "VHS_SelectLatents": {
        "title": "Latentを選択（インデックス）",
        "inputs": {
            "latent": "Latent"
        },
        "widgets": {
            "indexes": "インデックス",
            "err_if_missing": "欠落時エラー",
            "err_if_empty": "空の場合エラー"
        },
        "outputs": {
            "LATENT": "Latent"
        },
        "description": "カンマ区切りの番号インデックスで入力項目を指定順に選択する\n\n負のインデックス、Python形式の範囲（終了インデックス含まず）、範囲ステップに対応\n\n例（入力16項目、インデックス0-15の場合）：\n\n• 0         → 出力 [0]\n• -1        → 出力 [15]\n• 0,1,13    → 出力 [0,1,13]\n• 0:5,13    → 出力 [0,1,2,3,4,13]\n• 0:-1      → 出力 [0,1,2,...,14]\n• 0:5:-1    → 出力 [4,3,2,1,0]\n• 0:5:2     → 出力 [0,2,4]\n• ::-1      → 出力 [15,14,...,0]"
    },
