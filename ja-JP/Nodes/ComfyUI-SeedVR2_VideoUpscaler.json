{
    "SeedVR2VideoUpscaler": {
        "title": "SeedVR2 動画超解像アップスケール",
        "inputs": {
            "image": "入力画像",
            "dit": "DiTモデル設定",
            "vae": "VAEモデル設定"
        },
        "widgets": {
            "seed": "ランダムシード",
            "resolution": "目標解像度",
            "max_resolution": "最大解像度制限",
            "batch_size": "バッチサイズ",
            "uniform_batch_size": "統一バッチサイズ",
            "temporal_overlap": "時間軸オーバーラップフレーム数",
            "prepend_frames": "先頭追加フレーム数",
            "color_correction": "色彩補正",
            "input_noise_scale": "入力ノイズ係数",
            "latent_noise_scale": "Latentノイズ係数",
            "offload_device": "中間テンソルアンロードデバイス",
            "enable_debug": "デバッグを有効化"
        },
        "outputs": {
            "IMAGE": "超解像出力画像"
        }
    },
    "SeedVR2LoadDiTModel": {
        "title": "SeedVR2 DiTモデル読み込み",
        "inputs": {
            "torch_compile_args": "Torchコンパイルパラメータ"
        },
        "widgets": {
            "model": "モデル選択",
            "device": "推論デバイス",
            "blocks_to_swap": "BlockSwap 交換ブロック数",
            "swap_io_components": "IOコンポーネント交換",
            "offload_device": "アンロード先デバイス",
            "cache_model": "キャッシュモデル",
            "attention_mode": "アテンションモード"
        },
        "outputs": {
            "SEEDVR2_DIT": "DiTモデル設定"
        }
    },
    "SeedVR2LoadVAEModel": {
        "title": "SeedVR2 VAEモデル読み込み",
        "inputs": {
            "torch_compile_args": "Torchコンパイルパラメータ"
        },
        "widgets": {
            "model": "モデル選択",
            "device": "推論デバイス",
            "encode_tiled": "分割エンコード",
            "encode_tile_size": "エンコードタイルサイズ",
            "encode_tile_overlap": "エンコードタイルオーバーラップ",
            "decode_tiled": "タイルデコード",
            "decode_tile_size": "デコードタイルサイズ",
            "decode_tile_overlap": "デコードタイルオーバーラップ",
            "tile_debug": "タイルデバッグモード",
            "offload_device": "アンロード先デバイス",
            "cache_model": "キャッシュモデル"
        },
        "outputs": {
            "SEEDVR2_VAE": "VAEモデル設定"
        }
    },
    "SeedVR2TorchCompileSettings": {
        "title": "SeedVR2 Torchコンパイル設定",
        "widgets": {
            "backend": "コンパイルバックエンド",
            "mode": "最適化モード",
            "fullgraph": "完全グラフコンパイル",
            "dynamic": "動的形状",
            "dynamo_cache_size_limit": "キャッシュサイズ制限",
            "dynamo_recompile_limit": "再コンパイル回数制限"
        },
        "outputs": {
            "TORCH_COMPILE_ARGS": "Torchコンパイル設定"
        }
    }
}
