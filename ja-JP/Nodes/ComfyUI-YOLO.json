        "outputs": {
            "IMAGE": "画像",
            "width": "幅",
            "height": "高さ",
            "int": "スケーリング引数"
        }
    },
    "CocoToNumber": {
        "title": "COCOラベル変換",
        "widgets": {
            "coco_label": "COCOラベル"
        },
        "outputs": {
            "STRING": "数値ラベル",
            "string": "数値ラベル"
        }
    },
    "UltralyticsModelLoader": {
        "title": "Ultralyticsモデル読み込み",
        "widgets": {
            "model_name": "モデル名"
        },
        "outputs": {
