        "widgets": {
            "ipadapter": "IPAdapter",
            "clip_vision": "CLIP ビジョン",
            "provider": "デバイス"
        },
        "outputs": {
            "ipadapterFlux": "IPAdapter Flux_Instant X"
        }
    },
    "ApplyIPAdapterFluxAdvanced": {
        "title": "IPAdapter Fluxモデル（上級）を適用",
        "inputs": {
            "model": "モデル",
            "ipadapter_flux": "IPAdapter Flux",
