    "Compositor4": {
        "title": "コンポジター4",
        "inputs": {
            "config": "設定"
        },
        "widgets": {
            "fabricData": "キャンバスデータ",
            "imageName": "画像名",
            "seed": "シード"
        },
        "description": "インタラクティブな合成キャンバス。複数画像の配置、拡大縮小、回転、整列が可能で、リアルタイムプレビューとマスクに対応。レイヤーパネル、整列ツール、グリッド整列機能を備えたビジュアルエディターを提供。"
    },
    "Compositor4MasksOutput": {
        "title": "コンポジター4マスク出力",
        "inputs": {
            "layer_outputs": "レイヤー出力"
        },
        "outputs": {
            "image_1": "画像_1",
            "image_2": "画像_2",
            "image_3": "画像_3",
            "image_4": "画像_4",
            "image_5": "画像_5",
            "image_6": "画像_6",
            "image_7": "画像_7",
            "image_8": "画像_8",
            "mask_1": "マスク1",
            "mask_2": "マスク2",
            "mask_3": "マスク3",
            "mask_4": "マスク4",
            "mask_5": "マスク5",
            "mask_6": "マスク6",
            "mask_7": "マスク_7",
            "mask_8": "マスク_8"
        },
        "description": "このノードは Compositor4 の COMPOSITOR_OUTPUT_MASKS を個別の画像出力とマスク出力に分解する。\nレイヤー出力を専用ノードに分離することでコンポジターのインターフェースをより見やすくする。"
    },
