    "CompositorColorPicker": {
        "title": "コンポジターカラーピッカー",
        "inputs": {
            "format": "フォーマット"
        },
        "widgets": {
            "red": "赤",
            "green": "緑",
            "blue": "青"
        },
        "outputs": {
            "color_string": "カラー文字列",
