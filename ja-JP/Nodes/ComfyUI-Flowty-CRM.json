{
    "CRMPreprocessForPoser": {
        "title": "CRM Poser 前処理",
        "inputs": {
            "reference_image": "画像",
            "reference_mask": "マスク"
        },
        "widgets": {
            "foreground_ratio": "前景比率"
        },
        "outputs": {
            "processed": "処理画像"
        }
    },
    "CRMPoserConfig": {
        "title": "CRM Poser 設定",
        "inputs": {
            "processed_image": "処理画像"
        },
        "widgets": {
            "seed": "シード",
            "control_before_generate": "実行前操作",
            "cfg": "CFG",
            "steps": "ステップ数"
        },
        "outputs": {
            "CRM_POSE_CONFIG": "Poser設定"
        }
    },
    "CRMPoseSampler": {
        "title": "CRM Poser サンプラー",
        "inputs": {
            "config": "Poser設定"
        },
        "widgets": {
            "pixel_model": "Pixelモデル"
        },
        "outputs": {
            "IMAGE": "Pose画像"
        }
    },
    "CCMSampler": {
        "title": "CCMサンプラー",
        "inputs": {
            "config": "Poser設定",
            "poses": "Pose画像"
        },
        "widgets": {
            "ccm_model": "CCMモデル"
        },
        "outputs": {
            "IMAGE": "座標画像"
        }
    },
    "CRMModelLoader": {
        "title": "CRMモデルローダー",
        "widgets": {
            "crm_model": "CRMモデル"
        },
        "outputs": {
            "CRM_MODEL": "CRMモデル"
        }
    },
    "CRMModeler": {
        "title": "CRMモデル生成",
        "inputs": {
            "crm_model": "CRMモデル",
            "poses": "Pose画像",
            "coordinates": "座標画像"
        },
        "outputs": {
            "MESH": "メッシュ"
        }
    },
    "CRMModelerCuda": {
        "title": "CRMモデル生成(CUDAのみ)",
        "inputs": {
            "crm_model": "CRMモデル",
            "poses": "Pose画像",
            "coordinates": "座標画像"
        },
        "outputs": {
            "MESH": "メッシュ"
        }
    },
    "CRMViewer": {
        "title": "CRMメッシュプレビュー",
        "inputs": {
            "mesh": "メッシュ"
        }
    }
}