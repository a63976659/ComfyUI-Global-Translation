    "Flux2KleinEnhancer": {
        "title": "Flux2Klein エンハンサー",
        "inputs": {
            "conditioning": "条件付き",
            "device": "実行デバイス"
        },
        "widgets": {
            "active_scale": "アクティブ領域スケール",
            "per_token_whiten": "トークン単位ホワイトニング",
            "norm_equalize": "ノルム均等化",
