{
    "Save_Audio": {
        "title": "オーディオ保存 🔊",
        "inputs": {
            "audio": "音声"
        },
        "widgets": {
            "filepath": "ファイルパス",
            "format": "音声フォーマット",
            "quality": "音声品質レベル (0-100)",
            "overwrite": "既存ファイルを上書き",
            "base_path": "基本保存パス",
            "filename": "カスタムファイル名"
        },
        "outputs": {
            "filepath": "ファイルパス",
            "audio": "オーディオ出力"
        }
    },
    "EdgeTTS": {
        "title": "Edge TTS 合成 🔊",
        "inputs": {
            "text": "入力テキスト"
        },
        "widgets": {
            "voice": "話者",
            "speed": "話速 (+/-50%)",
            "pitch": "ピッチ (+/-50%)"
        },
        "outputs": {
            "AUDIO": "合成オーディオ"
        }
    },
    "WhisperSTT": {
        "title": "Whisper 音声認識 👂",
        "inputs": {
            "audio": "音声"
        },
        "widgets": {
            "model_size": "モデルサイズ",
            "language": "認識言語"
        },
        "outputs": {
            "STRING": "認識テキスト"
        }
    }
}