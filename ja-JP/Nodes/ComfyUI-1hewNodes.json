{
    "1hew_ImageColorMatch": {
        "title": "画像カラーマッチング",
        "inputs": {
            "source_image": "元画像",
            "reference_image": "参考画像"
        },
        "widgets": {
            "method": "手法"
        },
        "outputs": {
            "image": "画像"
        },
        "description": "参照画像の色調を元画像に転写します。バッチ処理に対応しており、参照画像の枚数が元バッチと異なる場合は参照画像を循環使用します（i % ref_count）。wavelet/adain はネイティブで動作します。mkl/hm/reinhard/mvgd とその混合バージョンは 'color-matcher' パッケージを使用します。"
    },
    "1hew_ImageColorRestore": {
        "title": "画像カラー復元",
        "inputs": {
            "edit_image": "編集画像",
            "org_image": "元画像"
        },
        "widgets": {
            "background_threshold": "背景閾値",
            "unchanged_threshold": "不変閾値",
            "seam_max_distance": "シーム最大距離",
            "seam_decay": "シーム減衰",
            "seam_residual_blur": "シーム残差ぼかし",
            "seam_color_sigma": "シーム色の標準偏差",
            "occlusion_residual_blur": "遮蔽残差ぼかし",
            "occlusion_bridge_width": "遮蔽ブリッジ幅"
        },
        "outputs": {
            "image": "画像",
            "unchanged_mask": "不変マスク"
        },
        "description": "整合済みのAI編集後の色を元の参照へ復元しつつ、オブジェクト削除で生じた遮蔽シームを局所的に平滑化します。信頼性の高いアフィン色フィットと連続的なシームフィールドを使用します（構造不変マスクのクリーニングは無効化済み）。編集画像にAlphaチャンネルがある場合は保持されます。"
    },
    "1hew_ImageAlignChangeMask": {
        "title": "画像整合変更マスク",
        "inputs": {
            "edit_image": "編集画像",
            "org_image": "元画像"
        },
        "widgets": {
            "mode": "モード",
            "max_offset": "最大オフセット",
            "max_rotation": "最大回転",
            "max_scale": "最大スケール",
            "min_align_score": "最小整合スコア",
            "color_compensation": "カラー補償",
            "sensitivity": "感度",
            "min_component_area": "最小コンポーネント面積",
            "expand": "拡張",
            "feather": "フェザー"
        },
        "outputs": {
            "align_image": "整列画像",
            "clean_mask": "クリーンマスク",
            "raw_mask": "生マスク",
            "change_score": "変更スコア",
            "overlay_image": "オーバーレイ画像"
        },
        "description": "AI編集後の画像を元画像と整合し、安定した背景ピクセルを利用して小規模な大域カラードリフトを除外し、生／クリーンな変更マスクを出力します。"
    },
    "1hew_ImageAlphaEdge": {
        "title": "画像Alphaエッジ処理",
        "inputs": {
            "image": "画像"
        },
        "widgets": {
            "edge": "エッジ",
            "feather": "フェザー"
        },
        "outputs": {
            "image": "画像",
            "mask": "マスク"
        },
        "description": "Alphaチャンネル付き画像の不透明領域の縁を調整します：内側への縮小エッジ／外側への拡張エッジ＋フェザー。\n\n典型シナリオ：切り抜き（背景削除）後、要素の縁に背景色に汚染された半透明の「ボヤけたフチ／カラーフチ」がリング状に残ることがあります。本ノードはまず形態学処理で内側に縁を縮め、汚染された縁のピクセルを直接除去してから、ガウシアンフェザーでなめらかなグラデーションを得ます。フェザー前には必ず不透明領域の色を移行帯へ拡散（bleed）させ、フェザー後の暗いフチ／カラーフチの発生を防ぎます。\n\n処理順序：縮小エッジ／拡張エッジ → 色のはみ出し → フェザー。\nAlpha付き4チャンネル画像を出力し、同時に処理後のAlphaマスクも返します。\n\n縮小／拡張エッジはグレースケール形態学処理（最小値／最大値フィルター）で、Alphaに直接作用します：局所的に線形なソフトエッジでは、半径rのフィルターはそのスロープをちょうどrピクセル平行移動させるのと等しいため、Alphaの各等値線が全体としてrだけ平行移動し、matte本来のアンチエイリアスが完全に保持され、1pxの段差に劣化しません。穴埋めはマスク修復に属するため、他のノードの処理に任せます。"
    },
    "1hew_ImageBlur": {
        "title": "画像ぼかし",
        "inputs": {
            "image": "画像"
        },
        "widgets": {
            "blur": "ぼかし"
        },
        "outputs": {
            "image": "画像"
        },
        "description": "画像全体にガウシアンブラーを適用します。挙動は LayerStyle の LayerFilter: Gaussian Blur V2 と一致します。\n\n- 「ぼかし」パラメータは小数（FLOAT）に対応しており、意味的には V2 バージョンにより近いです；\n- 「ぼかし」が 0 の場合は元画像をそのまま透過します；\n- バッチ単位でフレームごとに処理し、チャンネル数と「データ型」を維持します。"
    },
