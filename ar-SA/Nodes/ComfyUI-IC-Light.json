{
    "LoadAndApplyICLightUnet": {
        "title": "تحميل نموذج ICLight",
        "inputs": {
            "model": "النموذج"
        },
        "widgets": {
            "model_path": "النموذج"
        },
        "outputs": {
            "MODEL": "النموذج"
        },
        "description": "طريقة غير مريحة قليلاً لكنها فعّالة لقراءة نماذج IC-Light.\nhttps://huggingface.co/lllyasviel/ic-light/tree/main  \n \nتُستخدم مع عقدة شرط ICLight."
    },
    "ICLightConditioning": {
        "title": "تطبيق شرط ICLight",
        "inputs": {
            "positive": "شرط موجب",
            "negative": "شرط سالب",
            "vae": "VAE",
            "foreground": "Latent المقدمة",
            "opt_background": "Latent الخلفية (اختياري)"
        },
        "widgets": {
            "multiplier": "مضاعف"
        },
        "outputs": {
            "positive": "شرط موجب",
            "negative": "شرط سالب",
            "empty_latent": "Latent فارغ"
        },
        "description": "عقدة شرط لنماذج IC-Light. لاستخدام “Latent الخلفية” يجب تبديل نموذج IC-Light إلى إصدار “fbc”."
    },
    "LightSource": {
        "title": "مصدر ضوء مبسّط",
        "inputs": {
            "prev_image": "الصورة السابقة"
        },
        "widgets": {
            "light_position": "موضع مصدر الضوء",
            "multiplier": "الإضاءة",
            "start_color": "اللون البداية",
            "end_color": "اللون النهاية",
            "width": "العرض",
            "height": "الارتفاع",
            "batch_size": "حجم الدفعة"
        },
        "outputs": {
            "IMAGE": "صورة"
        },
        "description": "توليد صورة رمادية متدرجة تصلح لاستخدامها كمصدر ضوء بسيط. يمكن تحديد اللون بصيغة RGB أو HEX."
    },
    "CalculateNormalsFromImages": {
        "title": "حساب المتجهات العمودية",
        "inputs": {
            "images": "صورة",
            "mask": "قناع"
        },
        "widgets": {
            "sigma": "Sigma",
            "center_input_range": "مركز نطاق الإدخال"
        },
        "outputs": {
            "divided": "فاصل",
            "normal": "صورة المتجهات العمودية"
        },
        "description": "حساب المتجهات العمودية من صور ملتقطة بزوايا مختلفة.\nيتطلب دفعة صور تضم 4 صور: اليسار واليمين والأسفل والأعلى"
    },
    "LoadHDRImage": {
        "title": "تحميل صور HDR",
        "widgets": {
            "image": "صورة",
            "exposure": "تعرّض",
            "exposures": "تعرّض"
        },
        "outputs": {
            "IMAGE": "صورة",
            "MASK": "قناع"
        },
        "description": "تحميل صور ‎.hdr من مجلد input.\nإخراج دفعة صور LDR."
    },
    "BackgroundScaler": {
        "title": "رمادية الخلفية",
        "inputs": {
            "image": "صورة",
            "mask": "قناع"
        },
        "widgets": {
            "scale": "تحجيم",
            "invert": "عكس"
        },
        "outputs": {
            "IMAGE": "صورة"
        },
        "description": "تحجيم منطقة القناع إلى صورة رمادية"
    },
    "DetailTransfer": {
        "title": "نقل التفاصيل",
        "inputs": {
            "target": "صورة الهدف",
            "source": "صورة مرجعية",
            "mask": "قناع"
        },
        "widgets": {
            "mode": "الوضع",
            "blur_sigma": "Sigma التمويه",
            "blend_factor": "معامل الخلط"
        },
        "outputs": {
            "IMAGE": "صورة"
        }
    }
}