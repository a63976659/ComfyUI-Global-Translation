    "Flux2KleinDetailController": {
        "title": "متحكم تفاصيل Flux2Klein",
        "inputs": {
            "conditioning": "التحكم بالشرط",
            "device": "جهاز التشغيل"
        },
        "widgets": {
            "front_mult": "معامل الضرب للجزء الأمامي",
            "mid_mult": "معامل الضرب للجزء الأوسط",
            "end_mult": "معامل الضرب للجزء الخلفي",
            "emphasis_start": "موضع بداية التشديد",
            "emphasis_end": "موضع نهاية التشديد",
            "emphasis_mult": "معامل ضرب التشديد",
            "preserve_original": "الحفاظ على البيانات الأصلية",
            "debug": "وضع التنقيح"
        },
        "description": "مُعدِّل معامل ضرب التضمينات المجزّأة.\n\nالوضع الحقيقي (موصى به): يُستخدم مع المرمِّز المجزّئ. يولّد المرمِّز نطاقات رموز لكل قسم كبيانات وصفية للتحكم الشرطي (`meta[\"klein_sections\"]`)؛ ويقوم هذا العقد بضبط معامل ضرب التضمينات النشطة ضمن النطاقات المقابلة وفق المعاملات التي يحددها المستخدم.\n\nوضع التوافق (إصدار قديم/غير موصى به): إذا لم تكن هناك بيانات وصفية للتقسيم، يقسم العقد المنطقة النشطة تلقائيًا بنسب ثابتة 25%/50%/25%. هذه الحدود تعسفية — فليس لرموز Qwen3 دلالات مكانية ثابتة — وإصدار هذا العقد v1 لا يحقق تأثيرًا فعليًا يُذكر في هذا الوضع. يُحتفظ بوضع التوافق هذا لتوافق سير العمل القديمة؛ يُنصح بالانتقال إلى المرمِّز المجزّئ للحصول على تحجيم فعلي يدرك التقسيم."
    },
