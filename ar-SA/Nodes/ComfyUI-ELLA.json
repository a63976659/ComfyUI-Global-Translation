{
    "EllaApply": {
        "title": "تطبيق ELLA",
        "inputs": {
            "model": "النموذج",
            "ella": "ELLA",
            "positive": "مجموعة تضمين ELLA موجبة",
            "negative": "مجموعة تضمين ELLA سالبة"
        },
        "outputs": {
            "model": "النموذج",
            "positive": "شرط موجب",
            "negative": "شرط سالب"
        }
    },
    "T5TextEncode #ELLA": {
        "title": "ترميز نص T5",
        "inputs": {
            "text_encoder": "مُرمِّز النص"
        },
        "widgets": {
            "text": "نص"
        },
        "outputs": {
            "ELLA_EMBEDS": "مجموعة تضمينات ELLA"
        }
    },
    "ELLALoader": {
        "title": "محمّل ELLA",
        "widgets": {
            "name": "الاسم"
        },
        "outputs": {
            "ELLA": "ELLA"
        }
    },
    "T5TextEncoderLoader #ELLA": {
        "title": "محمّل مرمّز نص T5",
        "widgets": {
            "name": "الاسم",
            "max_length": "أقصى طول",
            "dtype": "نوع التقليم"
        },
        "outputs": {
            "T5_TEXT_ENCODER": "مرمّز نص T5"
        }
    },
    "EllaCombineEmbeds": {
        "title": "دمج مجموعات تضمين ELLA",
        "inputs": {
            "embeds": "مجموعات التضمين",
            "embeds_add": "مجموعة التضمين_إضافة"
        },
        "outputs": {
            "ELLA_EMBEDS": "مجموعة تضمينات ELLA"
        }
    },
    "ConditionToEllaEmbeds": {
        "title": "الشرط إلى مجموعة تضمين ELLA",
        "inputs": {
            "cond": "شرط"
        },
        "outputs": {
            "ELLA_EMBEDS": "مجموعة تضمينات ELLA"
        }
    },
    "ConcatConditionEllaEmbeds": {
        "title": "ربط الشرط بمجموعة تضمين ELLA",
        "inputs": {
            "cond": "شرط",
            "embeds": "مجموعات التضمين"
        },
        "outputs": {
            "ELLA_EMBEDS": "مجموعة تضمينات ELLA"
        }
    },
    "CombineClipEllaEmbeds": {
        "title": "دمج مجموعات تضمين CLIP وELLA",
        "inputs": {
            "cond": "شرط",
            "embeds": "مجموعات التضمين"
        },
        "outputs": {
            "ELLA_EMBEDS": "مجموعة تضمينات ELLA"
        }
    },
    "SetEllaTimesteps": {
        "title": "ضبط فاصل ELLA",
        "inputs": {
            "model": "النموذج",
            "ella": "ELLA",
            "sigmas": "Sigmas"
        },
        "widgets": {
            "scheduler": "الجدّول",
            "steps": "عدد الخطوات",
            "denoise": "إزالة الضوضاء"
        },
        "outputs": {
            "ELLA": "ELLA"
        }
    },
    "EllaEncode": {
        "title": "ترميز ELLA",
        "inputs": {
            "ella": "ELLA",
            "embeds": "مجموعات التضمين"
        },
        "outputs": {
            "CONDITIONING": "شرط"
        }
    },
    "EllaTextEncode": {
        "title": "ترميز نص ELLA",
        "inputs": {
            "ella": "ELLA",
            "text_encoder": "مُرمِّز النص",
            "clip": "CLIP"
        },
        "widgets": {
            "text": "نص",
            "text_clip": "نص CLIP"
        },
        "outputs": {
            "CONDITIONING": "شرط",
            "CLIP CONDITIONING": "شرط CLIP"
        }
    }
}