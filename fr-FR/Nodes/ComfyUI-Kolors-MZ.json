        },
        "widgets": {
            "width": "Largeur",
            "height": "Hauteur",
            "crop_w": "Largeur de recadrage",
            "crop_h": "Hauteur de recadrage",
            "target_width": "Largeur cible",
            "target_height": "Hauteur cible"
        },
        "outputs": {
            "positive": "Condition positive",
            "negative": "Condition négative"
        }
