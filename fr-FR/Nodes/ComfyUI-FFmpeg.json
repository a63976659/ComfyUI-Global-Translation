    "MergingVideoByPlenty": {
        "title": "🔥 Fusionner plusieurs vidéos par lot",
        "widgets": {
            "video_path": "URL de la vidéo",
            "output_path": "Chemin de sortie"
        },
        "outputs": {
            "video_complete_path": "Chemin complet de la vidéo",
            "string": "Texte/chaîne"
        },
        "description": " Fusionne plusieurs courtes vidéos ayant le même encodage, la même résolution et la même fréquence d'images en une longue vidéo.\n Toutes les vidéos du chemin doivent avoir le même encodage, la même fréquence d'images et la même résolution."
    },
    "MergingVideoByTwo": {
        "title": "🔥 Fusionner des vidéos",
        "widgets": {
            "video1_path": "Chemin vidéo_1",
            "video2_path": "Chemin vidéo_2",
            "device": "Appareil",
            "resolution_reference": "Référence de résolution",
            "output_path": "Chemin de sortie"
        },
        "outputs": {
            "video_complete_path": "Chemin complet de la vidéo",
            "string": "Texte/chaîne"
        },
        "description": " Fusionne deux vidéos, par exemple deux vidéos d'une heure en une vidéo de 2 heures.\n Les dimensions de la vidéo fusionnée peuvent reprendre celles de la première ou de la seconde vidéo."
    },
    "MultiCuttingVideo": {
        "title": "🔥 Découper une vidéo en plusieurs segments",
        "widgets": {
            "video_path": "URL de la vidéo",
            "output_path": "Chemin de sortie",
            "segment_time": "Durée du segment"
        },
        "outputs": {
            "video_complete_path": "Chemin complet de la vidéo",
            "string": "Texte/chaîne"
        },
        "description": " Découpe une vidéo en plusieurs vidéos.\n Longueur de chaque segment, en secondes. Le découpage se fait selon les images clés ; les segments ne sont donc pas tous de durée identique, mais au plus proche."
    },
