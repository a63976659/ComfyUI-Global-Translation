{
    "OmostLLMLoaderNode": {
        "title": "Chargeur Omost",
        "widgets": {
            "llm_name": "Nom du modèle de langage"
        },
        "outputs": {
            "OMOST_LLM": "Omost"
        }
    },
    "OmostLLMHTTPServerNode": {
        "title": "Service HTTP Omost",
        "widgets": {
            "address": "Adresse",
            "api_type": "Type d'API"
        },
        "outputs": {
            "OMOST_LLM": "Omost"
        }
    },
    "OmostLLMChatNode": {
        "title": "Conversation Omost",
        "inputs": {
            "llm": "Omost",
            "conversation": "Historique de conversation"
        },
        "widgets": {
            "text": "Texte",
            "max_new_token": "Nombre maximal de jetons de sortie",
            "top_p": "Longueur dynamique de l'ensemble de candidats",
            "temperature": "Température",
            "seed": "Graine",
            "control_before_generate": "Action avant exécution"
        },
        "outputs": {
            "OMOST_CONVERSATION": "Historique de conversation",
            "OMOST_CANVAS_CONDITIONING": "Condition d'arrière-plan"
        }
    },
    "OmostGreedyBagsTextEmbeddingNode": {
        "title": "Omost Greedy Bags Text Embedding",
        "inputs": {
            "canvas_conds": "Condition d'arrière-plan",
            "clip": "CLIP"
        },
        "outputs": {
            "CONDITIONING": "Condition"
        }
    },
    "OmostLayoutCondNode": {
        "title": "Zone conditionnelle Omost（région）",
        "inputs": {
            "canvas_conds": "Condition d'arrière-plan",
            "clip": "CLIP",
            "positive": "Condition positive"
        },
        "widgets": {
            "global_strength": "Intensité globale",
            "region_strength": "Intensité de la zone",
            "overlap_method": "Mode de recouvrement"
        },
        "outputs": {
            "CONDITIONING": "Condition",
            "MASK": "Masque"
        }
    },
    "OmostDenseDiffusionLayoutNode": {
        "title": "Omost Zones de condition (DenseDiffusion)",
        "inputs": {
            "model": "Modèle",
            "canvas_conds": "Condition d'arrière-plan",
            "clip": "CLIP"
        },
        "outputs": {
            "MODEL": "Modèle",
            "CONDITIONING": "Condition"
        }
    },
    "OmostLoadCanvasConditioningNode": {
        "title": "Chargement de la condition d'arrière-plan Omost",
        "widgets": {
            "json_str": "Chaîne json"
        },
        "outputs": {
            "OMOST_CANVAS_CONDITIONING": "Condition d'arrière-plan"
        }
    },
    "OmostLoadCanvasPythonCodeNode": {
        "title": "Chargement du code Python d'arrière-plan Omost",
        "widgets": {
            "python_str": "Chaîne Python"
        },
        "outputs": {
            "OMOST_CANVAS_CONDITIONING": "Condition d'arrière-plan"
        }
    },
    "OmostRenderCanvasConditioningNode": {
        "title": "Condition d'arrière-plan de rendu Omost",
        "inputs": {
            "canvas_conds": "Condition d'arrière-plan"
        },
        "outputs": {
            "IMAGE": "Image (graphique)",
            "MASK": "Masque"
        }
    }
