    "VHS_SelectLatents": {
        "title": "Sélection de Latents (index)",
        "inputs": {
            "latent": "Latent"
        },
        "widgets": {
            "indexes": "Index",
            "err_if_missing": "Erreur si manquant",
            "err_if_empty": "Erreur si vide"
        },
        "outputs": {
            "LATENT": "Latent"
        },
        "description": "Sélectionne les éléments d'entrée par indices numériques séparés par des virgules, dans l'ordre donné\n\nPrend en charge les indices négatifs, les plages de style Python (sans l'indice de fin) et le pas des plages\n\nExemples (avec 16 éléments en entrée, indices 0-15) :\n\n• 0         → sortie [0]\n• -1        → sortie [15]\n• 0,1,13    → sortie [0,1,13]\n• 0:5,13    → sortie [0,1,2,3,4,13]\n• 0:-1      → sortie [0,1,2,...,14]\n• 0:5:-1    → sortie [4,3,2,1,0]\n• 0:5:2     → sortie [0,2,4]\n• ::-1      → sortie [15,14,...,0]"
    },
    "VHS_GetLatentCount": {
        "title": "Obtenir le nombre de Latents",
        "inputs": {
            "latents": "Latent"
        },
        "outputs": {
            "count": "Nombre"
        },
        "description": "Retourne l'espace latent de l'entrée sous forme d'entier \n\n"
    },
